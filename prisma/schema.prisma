// Postgres on Neon.
// DATABASE_URL = pooled connection (host contains "-pooler"), used by the app at runtime.
// DIRECT_URL   = direct connection, used by `prisma migrate`.
generator client {
  provider = "prisma-client-js"
  // "native" = the machine that runs `prisma generate`. On Render that is the same
  // Linux build/run environment, so no extra engine targets are needed.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INVESTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  FROZEN
}

enum TxStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  username             String     @unique
  fullName             String?
  phoneNumber          String?
  country              String?
  passwordHash         String
  role                 Role       @default(INVESTOR)
  status               UserStatus @default(ACTIVE)
  tokenVersion         Int        @default(1)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean    @default(false)
  twoFactorBackupCodes String[]   @default([])
  twoFactorTempSecret  String?
  withdrawalCode       String?    @map("withdrawal_code")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  wallet                  Wallet?
  investments             Investment[]
  transactions            Transaction[]
  activityLogs            ActivityLog[]
  positions               Position[]
  resetTokens             PasswordResetToken[]
  uploads                 ProofUpload[]
  withdrawalCodes         WithdrawalCode[]
  notifications           Notification[]
  realEstateInvestments   RealEstateInvestment[]
  coldStorageAssets       ColdStorageAsset[]
  cards                   Card[]
  signalPurchases         SignalPurchase[]
  connectedWallets        ConnectedWallet[]
  portfolioAssets         AssetBalance[]
  closedTradeResults      ClosedTradeResult[]
  copySubscriptions       CopyExpertSubscription[]
  stakes                  UserStake[]
  miningContracts         UserMining[]
  backupCodes             TwoFactorBackupCode[]
  supportConversation     SupportConversation?
  verificationSubmissions VerificationSubmission[]

  @@map("users")
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainBalance     Decimal  @default(0) @db.Decimal(18, 2)
  interestBalance Decimal  @default(0) @db.Decimal(18, 2)
  totalDeposited  Decimal  @default(0) @db.Decimal(18, 2)
  totalWithdrawn  Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt       DateTime @updatedAt

  @@map("wallets")
}

model Plan {
  id                 String       @id @default(uuid())
  name               String
  minDeposit         Decimal      @db.Decimal(18, 2)
  maxDeposit         Decimal      @db.Decimal(18, 2)
  dailyRoiPercentage Decimal      @db.Decimal(6, 3)
  durationDays       Int
  capitalRefund      Boolean      @default(true)
  isActive           Boolean      @default(true)
  title              String?
  placeholder        Decimal?     @db.Decimal(18, 2)
  sortOrder          Int          @default(0)
  investments        Investment[]

  @@map("plans")
}

model Investment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  amount        Decimal  @db.Decimal(18, 2)
  accruedProfit Decimal  @default(0) @db.Decimal(18, 2)
  daysRemaining Int
  status        String   @default("RUNNING") // RUNNING | COMPLETED
  lastPayoutAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([status, lastPayoutAt])
  @@map("investments")
}

model Transaction {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // DEPOSIT | WITHDRAWAL | INVESTMENT_SUBSCRIBE | TRADE_BUY | TRADE_SELL | TRADE_CONVERT | TRADE_CLOSE
  amount         Decimal         @db.Decimal(18, 2)
  currency       String
  cryptoAddress  String?
  txHash         String?
  // Normalized on-chain hash a user submitted with a deposit. Unique, so the same
  // blockchain transaction can't be claimed twice.
  depositHash    String?         @unique
  receiptUrl     String?
  // The crypto asset and quantity involved (deposits / withdrawals), e.g. BTC 0.015
  assetSymbol    String?
  assetAmount    Decimal?        @db.Decimal(28, 10)
  status         TxStatus        @default(PENDING)
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  signalPurchase SignalPurchase?

  @@index([userId, createdAt])
  @@index([status])
  @@index([userId, assetSymbol])
  @@map("transactions")
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String
  ipAddress    String?
  details      String?
  targetUserId String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("activity_logs")
}

model DepositAddress {
  id        String   @id @default(uuid())
  token     String
  symbol    String
  network   String
  address   String
  memo      String?
  updatedAt DateTime @updatedAt

  @@unique([symbol, network])
  @@map("deposit_addresses")
}

model Position {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  fundingAsset String             @default("USD")
  type         String // BUY | SELL | CONVERT
  amount       Decimal            @db.Decimal(18, 2)
  entryPrice   Decimal            @db.Decimal(24, 8)
  leverage     Int                @default(1)
  status       String             @default("OPEN") // OPEN | CLOSED
  pnl          Decimal            @default(0) @db.Decimal(18, 2)
  closedAt     DateTime?
  createdAt    DateTime           @default(now())
  result       ClosedTradeResult?

  @@index([userId, createdAt])
  @@map("positions")
}

// Immutable realized result attached to the asset used to fund a closed trade.
// The unique positionId makes close settlement and dashboard attribution idempotent.
model ClosedTradeResult {
  id           String   @id @default(uuid())
  positionId   String   @unique
  position     Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundingAsset String
  marketSymbol String
  pnl          Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@index([userId, fundingAsset, createdAt])
  @@map("closed_trade_results")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 digest of the emailed reset token. Raw bearer tokens are never persisted.
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// Payment-proof metadata. New binary objects live in private Cloudflare R2;
// `data` remains nullable so pre-R2 records continue to load during migration.
model ProofUpload {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes?
  objectKey   String?  @unique
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("proof_uploads")
}

model VerificationSubmission {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType     String
  frontObjectKey   String             @unique
  frontContentType String
  backObjectKey    String?            @unique
  backContentType  String?
  status           VerificationStatus @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("verification_submissions")
}

// One-time codes emailed to the user to confirm a withdrawal (expire after 10 minutes).
model WithdrawalCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("withdrawal_codes")
}

// In-app notifications shown under the bell icon.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // deposit | withdrawal | balance | security | account | trade | investment
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// Platform-wide settings managed from the admin Settings drawer (one row per group).
model AppSetting {
  key       String   @id // e.g. "general"
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model CopyExpert {
  id             String                   @id
  ref            String                   @unique
  name           String
  username       String                   @default("")
  picture        String
  bio            String                   @default("")
  winRate        Decimal                  @default(0) @db.Decimal(6, 2)
  profitShare    Decimal                  @default(0) @db.Decimal(6, 2)
  wins           Int                      @default(0)
  losses         Int                      @default(0)
  tradesCount    Int                      @default(0)
  minimumStartUp Decimal                  @default(0) @db.Decimal(18, 2)
  followers      Int                      @default(0)
  tickType       String                   @default("none")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  subscribers    CopyExpertSubscription[]

  @@map("copy_experts")
}

model CopyExpertSubscription {
  expertId  String
  userId    String
  expert    CopyExpert @relation(fields: [expertId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@id([expertId, userId])
  @@index([userId, active])
  @@map("copy_expert_subscriptions")
}

model SubscriptionPlanConfig {
  id          String   @id
  name        String
  title       String
  minimum     Decimal  @db.Decimal(18, 2)
  maximum     Decimal  @db.Decimal(18, 2)
  duration    Int
  roi         Decimal  @db.Decimal(8, 2)
  placeholder Decimal  @db.Decimal(18, 2)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("subscription_plan_configs")
}

model TradingSignalConfig {
  id          String           @id
  name        String
  title       String
  price       Decimal          @db.Decimal(18, 2)
  strength    Int
  placeholder Decimal          @db.Decimal(18, 2)
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  purchases   SignalPurchase[]

  @@index([active, sortOrder])
  @@map("trading_signal_configs")
}

model RealEstateInvestment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  projectTitle   String
  thumbnail      String?
  amount         Decimal  @db.Decimal(18, 2)
  roi            Decimal  @db.Decimal(6, 2)
  strategy       String
  durationMonths Int
  status         String   @default("ACTIVE")
  startDate      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId])
  @@map("real_estate_investments")
}

model ColdStorageAsset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  amount    Decimal  @db.Decimal(28, 10)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
  @@map("cold_storage_assets")
}

model Card {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ref          String   @unique
  type         String
  cardNumber   String
  last4        String
  expiryDate   String
  cvvEncrypted String?
  pinHash      String?
  status       String   @default("pending")
  balance      Decimal  @default(0) @db.Decimal(18, 2)
  issuanceFee  Decimal  @default(0) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("cards")
}

model SignalPurchase {
  id                   String               @id @default(uuid())
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ref                  String               @unique
  signalTitle          String
  price                Decimal              @db.Decimal(18, 2)
  strength             Int                  @default(50)
  status               String               @default("active")
  signalId             String?
  signal               TradingSignalConfig? @relation(fields: [signalId], references: [id], onDelete: SetNull)
  paymentTransactionId String?              @unique
  paymentTransaction   Transaction?         @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())

  @@index([userId])
  @@index([signalId])
  @@map("signal_purchases")
}

model ConnectedWallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  network   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("connected_wallets")
}

model AssetBalance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  amount    Decimal  @default(0) @db.Decimal(28, 10)
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
  @@map("asset_balances")
}

// Public profile imagery for copy-trading experts. New binary objects live in
// Cloudflare R2; nullable `data` preserves backwards compatibility.
model ExpertImage {
  id          String   @id @default(uuid())
  data        Bytes?
  objectKey   String?  @unique
  contentType String
  createdAt   DateTime @default(now())

  @@map("expert_images")
}

// Shared, database-backed authentication throttles. This works across processes and deploys.
model AuthRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("auth_rate_limits")
}

// Immutable, balanced entries accompanying every wallet balance mutation.
model LedgerEntry {
  id            String   @id @default(uuid())
  transferId    String
  userId        String?
  account       String
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("USD")
  referenceType String?
  referenceId   String?
  description   String?
  createdAt     DateTime @default(now())

  @@index([transferId])
  @@index([userId, createdAt])
  @@index([account, createdAt])
  @@map("ledger_entries")
}

model StakingPool {
  id        String      @id @default(uuid())
  name      String
  symbol    String
  icon      String?
  min       Decimal     @db.Decimal(18, 4)
  max       Decimal     @db.Decimal(18, 4)
  cycle     String      @default("Daily")
  roi       Decimal     @db.Decimal(6, 2)
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  stakes    UserStake[]

  @@map("staking_pools")
}

model UserStake {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolId            String?
  pool              StakingPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  poolName          String
  symbol            String
  amount            Decimal      @db.Decimal(28, 10)
  usdValue          Decimal      @db.Decimal(18, 2)
  durationDays      Int
  roi               Decimal      @db.Decimal(6, 2)
  expectedReturnUsd Decimal      @db.Decimal(18, 2)
  accruedProfitUsd  Decimal      @default(0) @db.Decimal(18, 2)
  daysRemaining     Int
  status            String       @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  fundingSource     String       @default("CASH")
  settledAt         DateTime?
  lastPayoutAt      DateTime     @default(now())
  startDate         DateTime     @default(now())
  endDate           DateTime
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([status, lastPayoutAt])
  @@map("user_stakes")
}

model MiningPool {
  id            String       @id @default(uuid())
  name          String
  symbol        String
  badge         String
  icon          String?
  hardwareImage String?
  min           Decimal      @db.Decimal(18, 4)
  max           Decimal      @db.Decimal(18, 4)
  roi           Decimal      @db.Decimal(6, 2)
  cycle         String       @default("Daily")
  hashrate      String
  status        String       @default("ACTIVE")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  contracts     UserMining[]

  @@map("mining_pools")
}

model UserMining {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  poolId            String?
  pool              MiningPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
  poolName          String
  symbol            String
  amount            Decimal     @db.Decimal(28, 10)
  usdValue          Decimal     @db.Decimal(18, 2)
  durationDays      Int
  roi               Decimal     @db.Decimal(6, 2)
  expectedReturnUsd Decimal     @db.Decimal(18, 2)
  accruedProfitUsd  Decimal     @default(0) @db.Decimal(18, 2)
  daysRemaining     Int
  status            String      @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  fundingSource     String      @default("CASH")
  settledAt         DateTime?
  lastPayoutAt      DateTime    @default(now())
  startDate         DateTime    @default(now())
  endDate           DateTime
  createdAt         DateTime    @default(now())

  @@index([userId])
  @@index([status, lastPayoutAt])
  @@map("user_minings")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@map("two_factor_backup_codes")
}

model SupportConversation {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([status, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  body           String
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

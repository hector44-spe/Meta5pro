  display: grid;
  gap: 24px;

  .card_creation {
    display: grid;
    gap: 20px;
    border-radius: 12px;
    /* padding: 20px; */
    /* background: var(--color-card-background-2); */
    /* border: 1px solid var(--color-card-background-3); */
  }

  .card_creation h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }

  .creation_note {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 20px;
  }

  .form_section {
    display: grid;
    gap: 16px;
  }

  .form_row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .input_field {
    display: grid;
    gap: 8px;
  }

  .input_field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
  }

  .input_field input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--color-card-background-3);
    border-radius: 8px;
    background: var(--color-card-background);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .input_field input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(49, 172, 238, 0.1);
  }

  .input_field input::placeholder {
    color: var(--color-text-secondary);
  }

  .action_buttons {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
  }
`,AutoFillButtonWrapper$1=styled$2.div`
  position: relative;
  overflow: hidden;
  width: 100%;
  border-radius: 8px !important;

  .auto_fill_button_shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      hsla(0, 0%, 100%, 1),
      transparent
    );
    animation: shine 1.5s ease-in-out infinite;
    animation-delay: 0.3s;
    border-radius: 24px !important;
  }

  @keyframes shine {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }

`,AddressBoxWrapper=styled$2.div`
  display: flex;
  align-items: center;
  padding: 12px 10px;
  border-radius: 8px;
  background-color: var(--color-control);
  box-sizing: border-box;
  position: relative;
  width: 100%;
  overflow: hidden;

  .address_container {
    max-width: calc(100% - 120px);
    width: 100%;
    height: 32px;
  }

  .address_container_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-control-hover),
      transparent
    );
    animation: shine 2s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 24px !important;
  }

  .address_text {
    color: var(--color-text);
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    white-space: wrap;
    word-break: break-all;
  }

  .buttons_container {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    position: absolute;
    right: 10px;
    z-index: 999;
  }

  .buttons_container button,
  .buttons_container .skeleton_button {
    background-color: var(--color-control);
    border: none;
    border-radius: 5px;
    padding: 8px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    display: grid;
    place-content: center;
    z-index: 999;
  }

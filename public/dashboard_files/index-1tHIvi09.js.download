`;styled$2.button`
  padding: 8px 16px;
  border-radius: 6px;
  border: 1px solid var(--color-card-background-3);
  background-color: transparent;
  color: var(--color-text-secondary);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;

  &:hover {
    background-color: var(--color-card-background-2);
    color: var(--color-text);
  }

  &:active {
    transform: translateY(1px);
  }
`;const ThemeBox=styled$2.div`
  display: flex;
  gap: 8px;
  flex-direction: column;
  width: fit-content;
  cursor: pointer;
  align-items: center;
  justify-self: center;

  &.active {
    .theme-preview {
      border: 1px solid var(--color-primary);
    }

    .theme-name {
      color: var(--color-text);
    }
  }

  .theme-preview {
    width: 45px;
    height: 45px;
    border: 1px solid transparent;
    transition: all 0.2s ease-in-out;
    background-color: ${({theme:er})=>themes[er].colors["main-background"]};
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  &:hover {
    .theme-preview {
      border: 1px solid var(--color-primary);
    }
  }

  .theme-name {
    font-size: 13px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);

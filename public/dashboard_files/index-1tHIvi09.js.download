  max-width: 470px;
  width: 100%;
  color: var(--color-text);
  margin: 0 auto;
  margin-top: 48px;

  .auth_form_title {
    font-size: 20px;
    line-height: 28px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .auth_form_subtext {
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    color: var(--color-text-80);
    margin-top: 8px;
  }

  .auth_form_text {
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    margin-top: 12px;
    color: var(--color-text-80);
  }

  .auth_form_fields {
    margin-top: 32px;
    display: grid;
    gap: 18px;
  }

  .auth_form_fields div {
    /* margin-top: 24px; */
  }

  .form_action_text {
    font-size: 14px;
    font-weight: 400;
    color: var(--color-text-80);
    transition: all 80ms ease-in-out;
    display: block;
    /* margin: 0 auto; */
    margin-top: 20px;
    /* width: max-content; */
    text-decoration: none;
  }

  a.action {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .form_action_text .action {
    color: var(--color-primary);
    text-decoration: underline;
    font-weight: 500;
  }

  .form_disclaimer {
    font-size: 13px;
    line-height: 24px;
    font-weight: 400;
    color: var(--color-text-65);
    transition: all 80ms ease-in-out;
    display: block;
    margin: 0 auto;
    margin-top: 64px;
    width: 100%;
    text-align: center;
  }

  /* .form_action_text a {

  } */

  /* .form_action_text a:hover {
    color: var(--color-primary-text);
  } */

  .auth_form_footer {
    margin-top: 48px;
  }

  /* utils */
  .multi_field {
    display: flex;
    /* flex-direction: column; */
    gap: 12px;
    align-items: center;
    width: 100%;
  }

  .text-btn {
    outline: none;
    border: none;
    background: transparent;
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    padding: 0px !important;
    /* margin: 0 auto; */
    /* margin: 0px !important; */
    place-self: flex-start;
    /* margin-bottom: 12px; */
  }

  .error {
    color: #ff3344;
    font-size: 14px;
    transition: all 80ms ease-in-out;
    margin-top: 6px;
  }

  .first-name-placement,
  .last-name-placement,
  .email-placement,
  .password-placement,
  .confirm-placement,
  .phone-placement,
  .referral-placement {
    display: none;
    font-size: 14px;
    opacity: 0;
    transition: all 80ms ease-in-out;
  }
`,SettingsForm=styled$2.div`
  width: 100%;
  border-radius: 6px;
  max-width: 550px;

  .form_wrapper .section:not(:first-of-type) {
    margin-top: 48px;
  }

  .section .section_titles p:first-of-type {
    font-size: 14px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0em;
    text-align: left;
  }

  .section_content {
    display: grid;
    gap: 24px;
    /* margin-top: 24px; */
  }

  .inner_section {
    display: grid;
    gap: 32px;
    margin-top: 24px;
  }

  .section_content .photo_form {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section_content .photo_form img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }

  .section_content .photo_form button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
    background-color: var(--color-card-background-50);
  }

  .section_content .photo_form button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .section_content .photo_form button:hover {
    background-color: hsla(0, 0%, 100%, 0.075);
  }

  .section .section_titles p:last-of-type {
    font-size: 13px;
    line-height: 15px;
    font-weight: 500;
    color: var(--color-text-50);
    margin-top: 4px;
  }

  /* utils */
  .multi_field {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  @media screen and (max-width: 1024px) {
    & {
      max-width: unset;
    }

    .multi_field {
      flex-direction: column;
      gap: 24px;
    }
  }
`,AiButton=styled$2.button`
  position: relative;
  overflow: hidden;
  z-index: 1;
  border-radius: 120px;
  background: var(--color-control);
  color: var(--color-text-secondary);
  font-size: 13px;
  font-weight: 500;
  padding: 6px 10px;
  cursor: pointer;
  border: none;
  outline: none;
  transition: all 150ms ease-in-out;

  &:hover {
    color: var(--color-white);
  }

  &::after {
    background: var(--color-ai-btn-gradient);
    border-radius: inherit;
    content: "";
    inset: 0;
    -webkit-mask: linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0) padding-box;
    mask: linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0) padding-box;
    -webkit-mask-composite: destination-out, source-over;
    mask-composite: exclude;
    padding: 0.0625rem;
    pointer-events: none;
    position: absolute;
  }
`,TextButton=styled$2.button`
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 500;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  margin: 0;
  text-align: left;

  }
`,TradeTable=styled$2.div`
  border-radius: 12px;
  /* max-height: 60vh; */
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 300px;
  padding: 12px;
  /* padding-bottom: 88px; */

  span.approved {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: #4ebe96;
    background: rgba(78, 190, 150, 0.1);
  }

  span.pending {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-primary);
    background: rgba(49, 172, 238, 0.1);
  }

  span.declined {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: #ff453a;
    background: rgba(255, 69, 58, 0.1);
  }

  .trade_desktop_wrapper,
  .trade_mobile_wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* height: 100%; */
  }

  .trade_mobile_wrapper {
    padding-bottom: 88px;
    display: none;
  }

  .trade_desktop_section,
  .trade_mobile_section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* background-color: red; */
    /* overflow: hidden; */
    /* max-height: 60vh; */
    /* overflow-y: scroll; */
  }

  .trade_mobile_section {
    /* background-color: blue; */
    width: 100%;
    height: 100%;
    overflow: hidden;
    overflow-y: scroll;
    max-height: 64vh;
  }

  .trade_section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 10px;
    border-radius: 6px;
    color: var(--color-text);
    background: var(--color-card-background-95);
    outline: none;
    border: none;
    cursor: pointer;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(120px);
  }

  .trade_section_wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-80);
  }

  .trade_section_wrapper p {
    font-size: 13px;
    font-weight: 500;
  }

  .trade_section_wrapper strong {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  th {
    font-size: 12px !important;
    font-family: 16px;
    font-weight: 500 !important;
    color: var(--color-text-50) !important;
  }

  .trade_table_top {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px 4px;
    padding-top: 8px;
  }

  .trade_table_top_title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-75);
  }

  .trade_switcher {
    display: flex;
    gap: 8px;
  }

  .trade_switcher button {
    background: var(--color-card-background);
    border: none;
    cursor: pointer;
    padding: 10px 12px;
    /* border-radius: 4px; */
    color: var(--color-text-secondary);
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    transition: all 0.1s ease-in-out;
    text-transform: capitalize;
    min-width: 80px;
    border-radius: 6px;
  }

  .trade_switcher button:hover {
    background: var(--color-card-background-50);
  }

  .trade_switcher button strong {
    text-transform: lowercase;
  }

  .trade_switcher button.active {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .trade_switcher button.active:hover {
    background: var(--color-primary-hover);
  }

  @media screen and (max-width: 1200px) {
    .trade_desktop_wrapper {
      display: none;
    }

    .trade_mobile_wrapper {
      display: flex;
    }

    .trade_table_top {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  /* @media screen and (max-width: 768px) {
    & {
      max-height: 64vh !important;
    }
  } */
`,DesktopTrades=styled$2.table`
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  /* max-height: 60vh; */
  overflow: hidden;
  overflow-y: scroll;
  counter-reset: row-counter;

  .label {
    margin-left: 4px;
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 3px 8px;
    background: #ffb70026;
    border-radius: 10px;
    font-size: 12px;
    line-height: 12px;
    color: #ffb700;
  }

  .leverage {
    /* background: var(--color-primary-light) !important; */
    background: var(--color-primary-light) !important;
    color: var(--color-primary);
    padding: 2px 6px !important;
    border-radius: 6px !important;
    font-weight: 600 !important;
  }

  & thead {
    position: "sticky";
    top: 0;
  }

  & thead th {
    font-size: 12px;
    font-family: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  & tbody td {
    font-size: 14px;
    font-family: 18px;
    font-weight: 500;
  }

  & thead tr,
  & tbody tr {
    display: flex;
    width: 100%;
    gap: 12px;
    align-items: center;
    white-space: nowrap;
    /* max-height: max-content; */
  }

  & thead tr {
    background: transparent;
    padding: 4px 8px;
    border-radius: 8px;
  }

  & tbody {
    display: grid;
    gap: 8px;
    /* height: 100%; */
    /* max-height: 97%; */
    width: 100%;
    overflow: scroll;
    padding-top: 12px;
  }

  & tbody tr:nth-of-type(even) {
    background: transparent;
  }

  & tbody tr:nth-of-type(odd) {
    background: var(--color-control) !important;
  }

  & tbody tr {
    /* max-height: 60px; */
    padding: 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.1s ease-in-out;
    /* opacity: 0;
    animation: fadeInStagger 0.2s ease forwards;
    animation-delay: calc(var(--row-index, 0) * 30ms); */
  }

  & tbody tr:hover {
    background: var(--color-control-hover) !important;
  }

  & tbody:has(> :hover) > *:not(:hover) {
    opacity: 0.7;
  }

  .date {
    min-width: 50px;
    max-width: 200px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .date p strong {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .asset {
    min-width: 60px;
    max-width: 140px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    display: flex;
    gap: 2px;
    align-items: center;
  }

  .asset_icon {
    width: 17px;
    height: 17px;
    margin-right: 8px;
  }

  .asset_name {
    font-size: 14px;
    font-family: 16px;
    font-weight: 500;
    color: var(--color-text);
  }

  .size {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .amount {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .entry {
    min-width: 10px;
    width: 100%;
    max-width: 80px;
    text-align: center;
    color: var(--color-text-secondary);
  }

  .pnl {
    min-width: 90px;
    width: 100%;
    text-align: center;
  }

  .action {
    min-width: 80px;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .action button {
    background: var(--color-primary);
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-white) !important;
  }

  .action button:hover {
    background: var(--color-primary-hover) !important;
  }

  .action button p {
    color: var(--color-white) !important;
  }

  .action button.disabled {
    opacity: 0;
    user-select: none;
  }

  /* @media screen and (max-width: 1200px) {
    & {
      display: none;
    }
  } */

  /* @keyframes fadeInStagger {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  } */

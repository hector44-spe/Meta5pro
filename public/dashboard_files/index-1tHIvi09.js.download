  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  z-index: 999;
  transform: translateX(100%);
  padding: 16px;
  padding-top: 24px;
  opacity: 0.75;
  max-width: 400px;
  width: 100%;
  overflow-y: auto;
  transition: all 300ms ease-in-out;
  /* background: #344a65 !important; */
  background: #1e2124 !important;
  backdrop-filter: blur(200px) !important;

  .history_content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .content_wrapper {
    /* max-height: 70%; */
    overflow: scroll;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    gap: 6px;
    box-sizing: border-box;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .history_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background: orange; */
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    max-height: max-content;
  }

  .history_item:nth-of-type(odd) {
    background: rgba(255, 255, 255, 0.042) !important;
  }

  .history_item:hover {
    background: rgba(255, 255, 255, 0.055);
  }

  .history_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .history_item .left .left_info_title {
    font-size: 12px;
    font-family: 14px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .history_item .left .left_info_title .label {
    margin-left: 10px;
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 3px 8px;
    background: #ffb70026;
    border-radius: 10px;
    font-size: 12px;
    line-height: 12px;
    color: #ffb700;
  }

  .history_item .left .left_info_value {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .history_item .left img {
    width: 32px;
    height: 32px;
  }

  .history_item .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .history_item .right .right_info {
    display: flex;
    font-size: 12px;
    line-height: 14px;
    gap: 4px;
    text-align: right;
    align-self: flex-end;
  }

  .history_item .right .right_info p.title {
    font-weight: 500;
    color: var(--color-text-50);
  }

  .history_item .right .right_info p.value {
    font-weight: 600;
    color: var(--color-primary-text);
  }

  /* top */
  .history_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history_top .history_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text) fff;
  }

  .history_top button {
    background: transparent;

`,PasswordBoxPrimary=styled$2.div`
  display: grid;
  gap: 6px;
  margin-top: 0px !important;

  label {
    font-size: 13px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  .input_wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    border: 1px solid transparent;
    transition: border 150ms ease-in-out;
    min-width: 135px;
    height: 42px;
    margin-top: 6px;
    border-radius: 8px;
    padding: 10px 8px !important;
    background: var(--color-input);
    border: 1px solid var(--color-input-border);
    position: relative;
  }

  .input_wrapper .show_btn {
    background-color: transparent;
    border: none;
    outline: none;
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 16px;
    font-weight: 600;
    cursor: pointer;
    position: absolute;
    right: 0;
  }

  & .input_wrapper:hover,
  & .input_wrapper:focus-within {
    border: 1px solid var(--color-card-background-50);
  }

  input,
  textarea {
    background: transparent;
    border: none;
    outline: none;

`,CategoryHeader=styled$2.div`
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  text-decoration: none;
  padding: 8px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 150ms ease-in-out;
  background-color: transparent;
  color: var(--color-text-50);
  font-size: 14px;
  line-height: 18px;
  font-weight: 500;
  user-select: none;

  &:hover {
    background-color: var(--color-control-hover);
    padding: 8px 16px;
    color: var(--color-text);
  }

  .category_title {
    font-size: 14px;
    line-height: 18px;
    color: inherit;
    font-weight: 500;
  }

  .chevron {
    transition: transform 150ms ease-in-out;
    color: inherit;
  }

  .chevron.collapsed {
    transform: rotate(-90deg);
  }

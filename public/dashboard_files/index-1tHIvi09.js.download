  /* background-color: var(--color-card-background); */

  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;
  background: hsla(0, 0%, 100%, 0.035) !important;
  border: 1px solid hsla(0, 0%, 100%, 0.025);
  position: relative;

  .mine_card_edit_button {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 14px;
    line-height: 18px;
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  .card_wrapper {
    padding: 24px;
  }

  .mine_card_top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .asset {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .asset_icon {
    width: 16px;
    height: 16px;
    box-sizing: border-box;
    border-radius: 100%;
  }

  .asset_name {
    font-size: 14px;
    line-height: 16px;
    font-weight: 500;
    color: #999999;
    text-transform: uppercase !important;
    font-family: "Chivo Mono", monospace !important;
  }

  .pool_name p {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    color: var(--color-primary-text);
    font-family: "Chivo Mono", monospace !important;
  }

  .card_details {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card_detail {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .card_detail p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
    font-family: "Chivo Mono", monospace !important;
    text-transform: uppercase !important;
  }

  .card_detail p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: #999999;
    font-family: "Chivo Mono", monospace !important;
    text-transform: uppercase !important;
  }

  .card_detail.roi p:last-of-type,
  .card_detail.roi p:first-of-type {
    color: #c1ff72;
  }

  .card_footer {
    margin-top: 32px;
    width: 100%;
  }

  .card_button {
    width: 100%;
    height: 40px;
    border-radius: 6px;
    border: none;
    outline: none;
    background-color: var(--color-card-background-50);
    cursor: pointer;
    transition: all 150ms ease-in;
  }

  .card_button p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text);
    font-family: "Chivo Mono", monospace !important;
    text-transform: uppercase !important;
  }

  &:hover {
    border: 1px solid var(--color-primary);
  }

  &:hover .card_button {
    background-color: var(--color-primary);
    color: #000;
  }

  &:hover .card_button p {
    color: #000;
  }

  .transactions_header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;

    h3 {
      font-size: 16px;
      font-weight: 600;
      color: var(--color-text);
      margin: 0;
    }

    p {
      font-size: 12px;
      color: var(--color-text-secondary);
      margin: 0;
    }
  }

  .transactions_list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .transaction_item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--color-card-background-2);
    border-radius: 8px;
    border: 1px solid var(--color-card-background-3);
    transition: all 0.2s ease;

    &:hover {
      background: var(--color-card-background-3);
    }
  }

  .transaction_icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: var(--color-primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .transaction_details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 1;
  }

  .transaction_actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
  }

  .transaction_info {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .transaction_description {
    font-size: 13px;
    line-height: 13px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .transaction_date {
    font-size: 12px;
    line-height: 12px;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .transaction_amount {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .amount {
    font-size: 14px;
    font-weight: 600;
    margin: 0;

    &.positive {
      color: #00ff99;
    }

    &.negative {
      color: var(--color-text);
    }
  }

  .status {
    font-size: 10px;
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;

    &.completed {
      background: rgba(0, 255, 153, 0.1);
      color: #00ff99;
    }

    &.pending {
      background: rgba(255, 193, 7, 0.1);
      color: #ffc107;
    }

    &.failed {
      background: rgba(255, 51, 68, 0.1);
      color: #ff3344;
    }
  }

  .no_transactions {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-text-secondary);

    p {
      font-size: 14px;
      line-height: 20px;
      font-weight: 500;
      color: var(--color-text);
    }

    span {
      font-size: 14px;
      line-height: 20px;
      color: var(--color-text-secondary);
    }
  }

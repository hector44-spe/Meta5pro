  display: ${er=>er.isOpen?"block":"none"};
  position: absolute;
  min-width: 80%;
  width: 100%;
  max-height: 300px;
  overflow-y: auto;
  margin-top: 4px;
  border-radius: 8px;
  background: var(--color-modal-background) !important;
  box-shadow: 0 4px 6px var(--color-card-background-3);
  backdrop-filter: blur(200px) !important;
  animation: fadeSlideIn 200ms ease-out;
  z-index: 1000;

  &.language-select {
   right: 0px;
   min-width: 180px;
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  &.full {
    max-width: 100%;
    width: 100%;
  }

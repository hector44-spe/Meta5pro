  /* account card */

  height: 100%;
  width: 100%;
  padding: 24px;
  background-color: var(--color-account-card-background);
  box-sizing: border-box;
  max-width: 600px;
  border-bottom-right-radius: 12px;
  border-top-right-radius: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 56px;
  /* border-radius: 12px; */
  /* margin: 12px auto; */
  /* margin-top: 8px; */

  .account_section_title {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
  }

  /* categories */

  .categories_section {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 16px;
  }

  .categories_section .bars {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .categories_section .bars .bar {
    height: 24px;
  }

  .categories_section .bars .bar:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  .categories_section .bars .bar:last-of-type {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  }

  .categories_section .titles {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 24px;
  }

  .categories_section .bars .bar:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  .categories_section .bars .bar:last-of-type {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  }

  .categories_section .titles .title {
    display: flex;
    align-items: flex-start;
    gap: 4px;
  }

  .categories_section .titles .title .icon {
    margin-top: 5px;
  }

  .categories_section .titles .title p:nth-of-type(1) {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
  }

  .categories_section .titles .title p:nth-of-type(2) {
    font-size: 16px;
    color: var(--color-text);
    line-height: 24px;
    font-weight: 600;
    margin-top: 4px;
  }

  /* progress */
  .progress_wrapper span {
    display: flex;
    justify-content: space-between;
  }

  .progress_wrapper span p:nth-of-type(2) {
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text);
  }

  .progress_section {
    position: relative;
    height: 12px;
    width: 100%;
    background: transparent;
    margin-top: 16px;
  }

  .progress_section .progress_bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 32px;
    background-color: #4ebe96;
    opacity: 50%;
  }

  .progress_section .progress {
    /* font-size: 12px; */
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 32px;
    background-color: #4ebe96;
    transition: width 300ms ease-in;
  }

  /* signal strength */
  .signal_strength_wrapper .signal_wrapper {
    display: flex;
    gap: 4px;
    margin-top: 16px;
  }

  .signal_strength_wrapper span {
    display: flex;
    justify-content: space-between;
  }

  .signal_strength_wrapper span p:nth-of-type(2) {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
  }

  .signal_strength_wrapper span p:nth-of-type(2).green {
    color: #4ebe96;
  }

  .signal_strength_wrapper span p:nth-of-type(2).yellow {
    color: #f9e26a;
  }

  .signal_strength_wrapper span p:nth-of-type(2).red {
    color: #ff3344;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar {
    height: 12px;
    width: 100%;
    transition: all 300ms ease-in;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar.red {
    animation: blink 0.5s infinite;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar:first-of-type {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar:last-of-type {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .signal_strength_wrapper .signal_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.5;
  }

  @media screen and (max-width: 1274px) {
    & {
      gap: 56px;
      border-radius: 12px;
      margin-top: 8px;
      max-width: unset;
      background-color: var(--color-card-background);
    }
  }

  @media screen and (max-width: 768px) {
    .categories_wrapper {
      display: none;
    }
  }

`,HistoryTable=styled$2.table`
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  overflow-y: scroll;
  counter-reset: row-counter;

  .action_icon {
    visibility: hidden;
    user-select: none;
    transition: all 150ms ease-in-out;
  }

  & tbody tr:hover .action_icon {
    visibility: visible;
  }

  .empty_state {
    padding: 8px;
    padding-top: 16px;
    color: var(--color-text-secondary);
    font-size: 13px;
    font-family: 14px;
    font-weight: 600;
  }

  .empty_state strong {
    color: var(--color-primary);
    font-weight: 700;
    cursor: pointer;
  }

  & thead {
    position: "sticky";
    top: 0;
  }

  & thead th {
    font-size: 12px;
    font-family: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  & tbody td {
    font-size: 14px;
    font-family: 18px;
    font-weight: 500;
  }

  & thead tr,
  & tbody tr {
    display: flex;
    width: 100%;
    gap: 12px;
    align-items: center;
    white-space: nowrap;
  }

  & thead tr {
    background: transparent;
    padding: 4px 8px;
    border-radius: 8px;
  }

  & tbody {
    display: grid;
    gap: 8px;
    width: 100%;
    overflow: scroll;
    padding-top: 12px;
  }

  & tbody tr:nth-of-type(even) {
    background: transparent;
  }

  & tbody tr:nth-of-type(odd) {
    background: var(--color-card-background-2) !important;
  }

  & tbody tr {
    padding: 10px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.1s ease-in-out;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-card-background-3);
  }

  & tbody tr:hover {
    background: var(--color-control-hover) !important;
  }

  & tbody:has(> :hover) > *:not(:hover) {
    opacity: 0.7;
  }

  .id {
    min-width: 50px;
    max-width: unset !important;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 6px;
    align-items: center;
  }

  .date {
    min-width: 100px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .amount,
  .amount_small {
    min-width: 100px;
    max-width: unset !important;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 2px;
    align-items: center;
  }

  .label_wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .label {
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 3px 8px;
    background: #ffb70026;
    border-radius: 10px;
    font-size: 12px;
    line-height: 12px;
    color: #ffb700;
  }

  .label.positive {
    background: #4ebe9626;
    color: #4ebe96;
  }

  .label.negative {
    background: #ff453a26;
    color: #ff453a;
  }

  .status {
    min-width: 80px;
    width: 100%;
    display: flex;
    text-align: center;
    justify-content: center;
    display: flex;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
  }

  span.approved {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: #4ebe96;
    background: rgba(78, 190, 150, 0.1);
  }

  span.pending {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-primary);
    background: rgba(49, 172, 238, 0.1);
  }

  span.declined {
    text-transform: capitalize;
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: #ff453a;
    background: rgba(255, 69, 58, 0.1);
  }

  .action {
    min-width: 50px;
    width: 100%;
    display: flex;
    text-align: left;
    justify-content: center;
    display: flex;
    gap: 6px;
  }

  .action button {
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-text);
    background-color: var(--color-control-active);
    transition: all 150ms ease-out;
    font-size: 13px;
    font-weight: 600;
  }

  .action button:hover {
    background: var(--color-primary);
  }
`,BalanceWrapper=styled$2.div`
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;

  .balance_label_wrapper {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .balance_label {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 500;
  }

  .balance_value {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 32px;
    font-feature-settings: "tnum";
  }

  .balance_button {
    /* background: transparent; */
    border: none;
    outline: none;
    padding: 10px 16px !important;
    /* border-radius: 6px; */
    border-radius: 120px;
    cursor: pointer;
    background-color: var(--color-control-active);
    transition: all 150ms ease-in;
    height: fit-content !important;
    display: flex;
    align-items: center;
    gap: 8px;
    max-height: max-content;
    /* background: red; */
    /* padding: 0px; */
    /* display: none; */
  }

  .balance_button:hover {
    background-color: var(--color-control-hover);
  }

  .balance_button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-text);
  }

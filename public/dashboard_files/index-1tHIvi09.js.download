  display: grid;
  gap: 12px;
  margin-top: 24px;

  .settings_option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: var(--color-card-background-2);
    border: 1px solid var(--color-card-background-3);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover {
      background: var(--color-card-background-3);
      border-color: var(--color-primary);
    }
  }

  .option_content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;

    h4 {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-text);
      margin: 0;
    }

    p {
      font-size: 12px;
      color: var(--color-text-secondary);
      margin: 0;
    }
  }

  .option_arrow {
    font-size: 16px;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
  }

  .settings_option:hover .option_arrow {
    color: var(--color-primary);
    transform: translateX(2px);
  }
`,Card=styled$2.div`
  width: 100%;
  height: 170px;
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  position: relative;
  overflow: hidden;

  &.shining {
    .card_shine {
      display: block;
    }
  }

  .card_shine {
    display: none;
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-outline),
      transparent
    );
    animation: cardShine 2s ease-in-out;
    border-radius: 12px;
    pointer-events: none;
  }

  @keyframes cardShine {
    0% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
    100% {
      left: 100%;
    }
  }

  .card_top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .card_top span {
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary) !important;
  }

  .card_top span.active {
    color: var(--color-text);
  }

  .card_number {
    color: var(--color-text);
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
  }

  .card_bottom {
    display: flex;
    align-items: center;
    gap: 24px;
    width: 100%;
    justify-content: space-between;
  }

  .card_bottom_wrapper {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .card_bottom_wrapper div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .card_bottom div p:first-of-type {
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .card_bottom div p:last-of-type {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .switch_wrapper .switch {
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: var(--color-control-inactive);
    filter: brightness(-20);
    min-width: 20px;
    min-height: 20px;
    border-radius: 4px;
    transition: transform 0.3s ease-out, background-color 0.3s;
    left: 3px;
  }

  .switch_wrapper .switch.active {
    transform: translate(18px, -50%);
    filter: brightness(1);
    background-color: var(--color-primary);
  }

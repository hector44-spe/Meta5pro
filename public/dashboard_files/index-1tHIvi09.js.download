  position: absolute;
  width: 92%;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;
  border: 1px solid rgba(255, 255, 255, 0.025) !important;
  box-shadow: 24px;
  /* padding: 16px; */
  /* min-height: 300px; */
  border-radius: 12px;
  max-width: 430px;
  animation: fadeSlideIn 0.3s ease-out forwards;
  /*  */

  .modal_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal_top .modal_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text) fff;
  }

  .modal_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .modal_top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;

  margin-top: 24px;

  .empty_state {
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-text-75);
  }

  .table_wrapper {
    max-width: calc(100vw - 40px);
    overflow: scroll !important;
    padding-bottom: 48px;
    scroll-behavior: smooth;
    scroll-snap-align: y mandatory;
  }

  .content_wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .stock {
    display: flex;
    justify-content: space-between;
    width: 100%;
    background-color: transparent;
    padding: 10px 8px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    border-radius: 5px;
    align-items: center;
  }

  .stock:nth-of-type(odd) {
    background-color: var(--color-control);
  }

  .stock:hover {
    background-color: var(--color-control-hover);
  }

  .stock_left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .stock_left img {
    width: 28px !important ;
    height: 28px !important;
    object-fit: cover;
  }

  .stock_left span {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stock_name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }

  .stock_value {
    display: flex;
    gap: 4px;
  }

  .stock_value p {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .stock_right span {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .stock_right .chevron_right {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
  }

  .chevron_right_wrapper {
    display: none;
    transition: all 0.2s ease-in-out;
    height: 32px;
  }

  .stock:hover .chevron_right_wrapper {
    display: grid;
    place-items: center;
  }

  .stock:hover .stock_right span {
    display: none;
  }

  p.current_price {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  p.change_24h {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  p.change_24h.positive {
    color: #4ebe96;
  }

  p.change_24h.negative {
    color: #ff3344;
  }

  @media screen and (max-width: 350px) {
    .stock_right span {
      display: none;
    }

    .stock_right .chevron_right_wrapper {
      display: grid !important;
      place-items: center;
    }
  }

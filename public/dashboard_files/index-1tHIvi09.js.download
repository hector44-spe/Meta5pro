`,SettingsWrapper=styled$2.div`
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  z-index: 999;
  transform: ${({isOpen:er})=>er?"translateX(0)":"translateX(100%)"};
  padding: 16px;
  padding-top: 24px;
  opacity: ${({isOpen:er})=>er?1:.75};
  max-width: 400px;
  width: 100%;
  overflow-y: auto;
  transition: all 300ms ease-in-out;
  background: var(--color-modal-background) !important;
  /* background: #1e2124 !important; */
  /* background: #344a65 !important; */
  /* background: #05080b !important; */
  /* backdrop-filter: blur(200px) !important; */

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top .top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  /* &.open {
    transform: translateX(0);
    opacity: 1;
  } */

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    background-color: var(--color-modal-background) !important;
  }
`,SettingsContent=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;
  position: relative;
  height: calc(100% - 40px);
  overflow-x: hidden;
  /* background: red !important; */
  padding-bottom: 200px;

  .content_wrapper {
    padding: 12px;
  }

  .user_wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .user_avatar {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    background: var(--color-control);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    color: var(--color-primary);
    font-weight: 500;
    font-size: 14px;
  }

  .user_info {
    display: flex;
    flex-flow: column;
    justify-content: center;
  }

  .user_name {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text);
  }

  .user_email {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 2px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  /* 
  .settings_options {
  } */
`,UserInfoCard=styled$2.div`
  width: 100%;
  height: 100%;
  padding: 8px;
  background-color: var(--color-control);
  border-radius: 12px;

  .info_wrapper {
    display: grid;
  }

  .info_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.6;
    border-color: transparent !important;
  }

  .info_wrapper .info {
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
    transition: all 150ms ease-in-out;
    padding: 10px 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: 6px;
    background-color: transparent;
    outline: none;
    border: none;
  }

  .info_wrapper .info .info_icon {
    /* font-size: 16px; */
    /* font-family: 16px; */
    /* display: none; */
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: all 150ms ease-in-out;
  }

  .info_wrapper .info:hover {
    background-color: var(--color-control-hover);
    border-color: transparent;
  }

  .info_wrapper .info:hover .info_icon {
    color: var(--color-text);
  }
`,RegularUserBalanceCard=styled$2.div`
  width: 100%;
  height: 100%;
  padding: 8px;
  background-color: var(--color-control);
  display: flex;
  padding: 16px 12px;
  border-radius: 12px;

  .balance_wrapper {
    display: grid;
  }

  .balance_wrapper p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
  }

  .balance_wrapper h3 {
    font-size: 18px;
    color: var(--color-text);
    line-height: 32px;
    font-weight: 600;
    margin-top: 4px;
  }
`,UserBalanceCard=styled$2.div`
  width: 100%;
  position: relative;
  display: flex;
  padding: 16px 12px;
  transition: transform 0.5s ease-in-out, top 0.5s ease-in-out, z-index 0s;
  border-radius: 12px;
  backdrop-filter: blur(300px);
  background-color: var(--color-control) !important;
  border: 1px solid var(--color-box-border);

  transform: ${er=>er.isStacked?`translateY(${er.index*10}px) scale(1)`:`translateY(${er.index*-100}px) scale(${1-er.index*.03})`};

  .balance_wrapper {
    display: grid;
    flex-grow: 1;
  }

  .balance_wrapper {
    transition: all 150ms ease-in-out;
    padding: 16px 12px;
    cursor: pointer;
    border-radius: 6px;
    background-color: transparent;
    outline: none;
    border: none;
  }

  .balance_wrapper p {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
  }

  .balance_wrapper h3 {
    font-size: 18px;
    color: var(--color-text);
    line-height: 32px;
    font-weight: 600;
    margin-top: 4px;
  }
`,PopupCard=styled$2.div`
  border-radius: 12px;
  min-width: 200px;
  background: var(--color-modal-background) !important;
  opacity: 1;
  backdrop-filter: blur(120px) !important;
  border: 1px solid var(--color-box-border);
  box-shadow: 0px 0px 10px 0px var(--color-card-background-3);
  width: 100%;

  .wrapper {
    padding: 12px 0px;
  }

  .item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 0px 24px;
    margin-top: 6px;
    cursor: pointer;
  }

  .title {
    color: var(--color-text);
    font-size: 14px;
    line-height: 16px;
    font-weight: 600;
  }

  .text {
    color: var(--color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    max-width: 360px;
    line-height: 17px;
  }

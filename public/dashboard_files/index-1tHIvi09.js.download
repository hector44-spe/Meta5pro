    & {
      padding: 0px;
    }
  }

  .form {
    margin-top: 24px;
  }

  .form > div {
    margin-top: 16px;
  }

  .sl_tp_wrapper {
    width: 100%;
    display: flex;
    gap: 13px;
  }

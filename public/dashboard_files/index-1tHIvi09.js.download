    font-size: 13px;
    font-weight: 400;
    color: var(--color-text);
    line-height: 13px;
  }

  .balance_wrapper p.estimated {
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 13px;
    margin-left: 2px;
  }

  .name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 13px;
  }

  .symbol {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 13px;
  }

  .image_wrapper {
    height: 40px;
    width: 40px;
  }

  .details_row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: auto;
  }

  .details_row_left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .details_row_left_item {
    display: flex;
    gap: 4px;
  }

  .details_row_left_item p:first-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .details_row_left_item p:last-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .buttons {
    display: flex;
    gap: 12px;
    margin-top: 16px;
  }

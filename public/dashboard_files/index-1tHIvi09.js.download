`,AuthButton=styled$2.button`
  background: var(--color-primary);
  border: none;
  outline: none;
  padding: 10px;
  border-radius: 8px;
  cursor: pointer;
  width: 100%;
  height: 42px;
  margin: 0 !important;
  display: flex;
  align-items: center;
  gap: 6px;
  justify-content: center;
  transition: all 150ms ease-in;
  position: relative;
  overflow: hidden;

  & p {
    color: var(--color-text);
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
  }

  &::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(to bottom, rgba(255,255,255,1) 0%, rgba(255,255,255,0.0) 100%);
    opacity: 0.22;
  }

  &.disabled {
    background-color: grey;
    pointer-events: none;
    user-select: none;
    cursor: not-allowed;
  }

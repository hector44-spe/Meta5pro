  height: calc(100vh - 104px);

  .trade_wrapper {
    display: grid;
    height: 100%;
    grid-template-areas:
      "top top top top"
      "top top top top"
      "top top top top"
      "table table table table";
    gap: 8px;
    border-radius: 12px;
    overflow-y: scroll;
  }

  .trade_table {
    grid-area: table;
    width: 100%;
    border-radius: 12px;
  }

  /* .trade_table div {
    background: transparent !important;
  } */

  .trade_wrapper_top {
    grid-area: top;
    display: flex;
    width: 100%;
    gap: 8px;
    max-height: fit-content;
    height: 100%;
  }

  .trade_wrapper_top .trade_chart {
    width: 100%;
    height: 100%;
    background: var(--color-card-background) !important;
    box-sizing: border-box;
    background: transparent;
    overflow: hidden;
    position: relative;
    border-radius: 12px;
  }

  .trade_wrapper_top .trade_card {
    padding: 24px;
    max-width: 400px;
    width: 100%;
    background: var(--color-card-background) !important;
    border-radius: 12px;
  }

  @media screen and (max-width: 768px) {
    & {
      height: auto !important;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .trade_wrapper {
      height: unset;
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 8px;
    }

    /* .table_wrapper {
      display: flex !important;
      flex-direction: column;
      grid-template-areas: unset !important;
      height: 100%;
      width: 100%;
    } */

    & .trade_wrapper_top {
      flex-direction: column;
    }

    .trade_wrapper_top .trade_chart {
      height: 350px !important;
    }

    .trade_wrapper_top .trade_card {
      max-width: unset;
    }
  }

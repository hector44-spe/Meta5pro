  white-space: nowrap !important;

  .switcher_wrapper {
    display: flex;
    justify-content: space-between;
    background-color: var(--color-control);
    border: 1px solid var(--color-input-border);
    padding: 4px;
    border-radius: 8px;
  }

  .switcher_item {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 13px;
    line-height: 14px;
    padding: 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: background 150ms ease-out;
  }

  .switcher_item:hover {
    background: var(--color-control-hover);
  }

  .switcher_item.active {
    color: var(--color-white);
    background: var(--color-control-active);
  }

  .switcher_item.active.buy {
    background: #01b28b;
  }

  .switcher_item.active.sell {
    background: #ff4545;
  }

  .switcher_item.active.convert {
    background: var(--color-primary);
  }
`,NewContextSwitcher=styled$2.div`
  white-space: nowrap !important;
  padding-top: 16px !important;
  padding-right: 16px;
  background: "lightblue";
  position: relative;

  .chevrons {
    position: absolute;
    width: 100%;
    height: 20px;
    background: red;
    top: 0;
    bottom: 0;
    margin: auto;
    transition: all 0.3s ease;
    -webkit-mask: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0) 10px,
      rgb(0, 0, 0) 10px,
      rgb(0, 0, 0) calc(100% - 10px),
      rgba(0, 0, 0, 0) calc(100% - 10px)
    );
    mask: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0) 10px,
      rgb(0, 0, 0) 10px,
      rgb(0, 0, 0) calc(100% - 10px),
      rgba(0, 0, 0, 0) calc(100% - 10px)
    );
    display: none;
  }

  /* .switcher_item p {
    font-family: "Chivo Mono", monospace !important;
  } */

  /* display: flex;
  align-items: center; */

  /* .chevron {
      position: absolute;
      top: 0;
      bottom: 0;
      margin: auto;
      height: 24px;
      width: 24px;
      background: red;
    } */

  .switcher_wrapper {
    max-width: calc(100vw - 78px);
    overflow-y: hidden;
    overflow-x: scroll;
    border-bottom: 1px solid var(--color-outline);
  }

  .switcher_wrapper_inner {
    display: flex;
    /* justify-content: space-between; */
    /* padding-right: 16px; */
    /* padding: 0px 16px; */
    gap: 24px !important;
    background-color: transparent;
    border-radius: 0px;

    position: relative;
    --active-index: 0;
    --active-width: 0px;
    --active-left: 0px;
    --investing-active-width: 0px;
    --investing-active-left: 0px;
    --combined-top-active-width: 0px;
    --combined-top-active-left: 0px;
    --balance-card-active-width: 0px;
    --balance-card-active-left: 0px;
    --real-estate-active-width: 0px;
    --real-estate-active-left: 0px;
    --subscription-active-width: 0px;
    --subscription-active-left: 0px;
    --staking-active-width: 0px;
    --staking-active-left: 0px;
    --signals-active-width: 0px;
    --signals-active-left: 0px;
    --copy-trading-active-width: 0px;
    --copy-trading-active-left: 0px;
    --mining-active-width: 0px;
    --mining-active-left: 0px;
    --cold-storage-active-width: 0px;
    --cold-storage-active-left: 0px;
  }

  /* .switcher_item_wrapper {
  
    background: red;
  } */

  .switcher_item_count {
    height: 20px;
    width: 20px;
    border-radius: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.07);
  }

  .switcher_item_count p {
    font-size: 10px !important;
    line-height: 8px !important;
    font-weight: 600 !important;
    color: var(--color-primary-text) !important;
    /* background: red; */
  }

  .switcher_item {
    white-space: nowrap !important;
    width: 100%;
    max-width: max-content;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 14px;
    line-height: 14px;
    padding: 0px;
    /* padding: 10px; */
    border-radius: 0px;
    cursor: pointer;
    padding-bottom: 16px;
    text-align: left;
    transition: background 150ms ease-out;
    position: relative;
    flex: 1;
    white-space: nowrap !important;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .switcher_indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background: var(--color-primary);
    width: var(--active-width, 50px);
    left: var(--active-left, 0px);
    transition: all 0.3s ease;
  }

  /* Scoped indicators for different switchers */
  .investing-switcher .switcher_indicator {
    width: var(--investing-active-width, 50px);
    left: var(--investing-active-left, 0px);
  }

  .combined-top-switcher .switcher_indicator {
    width: var(--combined-top-active-width, 50px);
    left: var(--combined-top-active-left, 0px);
  }

  .balance-card-switcher .switcher_indicator {
    width: var(--balance-card-active-width, 50px);
    left: var(--balance-card-active-left, 0px);
  }

  .real-estate-switcher .switcher_indicator {
    width: var(--real-estate-active-width, 50px);
    left: var(--real-estate-active-left, 0px);
  }

  .subscription-switcher .switcher_indicator {
    width: var(--subscription-active-width, 50px);
    left: var(--subscription-active-left, 0px);
  }

  .staking-switcher .switcher_indicator {
    width: var(--staking-active-width, 50px);
    left: var(--staking-active-left, 0px);
  }

  .signals-switcher .switcher_indicator {
    width: var(--signals-active-width, 50px);
    left: var(--signals-active-left, 0px);
  }

  .copy-trading-switcher .switcher_indicator {
    width: var(--copy-trading-active-width, 50px);
    left: var(--copy-trading-active-left, 0px);
  }

  .mining-switcher .switcher_indicator {
    width: var(--mining-active-width, 50px);
    left: var(--mining-active-left, 0px);
  }

  .cold-storage-switcher .switcher_indicator {
    width: var(--cold-storage-active-width, 50px);
    left: var(--cold-storage-active-left, 0px);
  }

  .switcher_item.active {
    color: var(--color-text);
    position: relative;
  }

  /* .switcher_item::after {
    content: "";
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
    position: absolute;
    bottom: 0;
    left: 0;
    transform: translateX(-100%);
    opacity: 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    display: none;
  } */

  /* .switcher_item.active::after {
    transform: translateX(0);
    opacity: 1;
  } */

  .switcher_item.active.buy {
    background: #01b28b;
  }

  .switcher_item.active.sell {
    background: #ff4545;
  }

  .switcher_item.active.convert {
    background: var(--color-primary);
  }

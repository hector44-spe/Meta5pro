  background: var(--color-card-background) !important;
  padding: 12px;
  box-sizing: border-box !important;
  overflow: scroll;
  border-radius: 12px;

  .asset_table_top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px;
    width: 100%;
    padding-bottom: 24px;
    justify-content: space-between;
  }

  .deposit_button {
    /* background: transparent; */
    border: none;
    outline: none;
    padding: 8px 12px !important;
    border-radius: 6px;
    cursor: pointer;
    /* background-color: var(--color-card-background-50); */
    transition: all 150ms ease-in;
    height: fit-content !important;
    display: flex;
    align-items: center;
    gap: 8px;
    max-height: max-content;
    background: var(--color-primary);
    /* padding: 0px; */
    /* display: none; */
  }

  .deposit_button:hover {
    /* background-color: hsla(0, 0%, 100%, 0.075); */
    background: #2b97d1;
  }

  .deposit_button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .asset_table_top_title {
    font-size: 16px;
    font-family: 24px;
    font-weight: 600;
    color: var(--color-text-75);
  }

  table {
    width: 100%;
    padding: 24px;
  }

  table thead th {
    font-size: 12px;
    font-family: 16px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  table tbody td {
    font-size: 14px;
    font-family: 18px;
    font-weight: 500;
  }

  table thead tr,
  table tbody tr {
    width: 100%;
    gap: 12px;
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  table thead tr {
    background: transparent;
    padding: 4px 8px;
    border-radius: 8px;
  }

  table tbody {
    display: grid;
    gap: 8px;
    height: 97%;
    width: 100%;
    overflow: scroll;
    padding-top: 12px;

    mask: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0),
      #000 3px calc(100% - 18px),
      rgba(0, 0, 0, 0)
    );
  }

  table tbody tr:nth-of-type(even) {
    background: transparent;
  }

  table tbody tr:nth-of-type(odd) {
    background: var(--color-card-background-2) !important;
  }

  table tbody tr {
    padding: 12px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.1s ease-in-out;
    height: 52px;
  }

  table tbody tr:hover {
    background: var(--color-card-background-50) !important;
  }

  table tbody:has(> :hover) > *:not(:hover) {
    opacity: 0.7;
  }

  .asset {
    min-width: 50px;
    max-width: 250px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 2px;
    align-items: center;
  }

  .asset .watchlist {
    width: 14px;
    height: 14px;
    margin-right: 8px;
  }

  .asset_icon {
    width: 17px;
    height: 17px;
    margin-right: 8px;
  }

  .asset_name,
  .asset_symbol {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
    white-space: nowrap;
  }

  .asset_symbol {
    display: none;
  }

  .symbol {
    min-width: 60px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: none;
  }

  .type {
    min-width: 60px;
    width: 100%;
    text-align: center;
    text-transform: capitalize;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .price {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .price_mobile {
    display: none;
  }

  .change {
    min-width: 30px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .change p.green {
    color: #4ebe96;
  }

  .change p.red {
    color: #ff3344;
  }

  .fiat_price {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: none;
  }

  .value {
    min-width: 10px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .value .action {
    display: none;
  }

  .action {
    min-width: 50px;
    width: 100%;
    display: flex;
    text-align: center;
    justify-content: center;
    display: flex;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
  }

  .action button {
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-primary-text);
    background-color: var(--color-card-background-50);
    transition: all 150ms ease-out;
  }

  .action button:hover {
    background: var(--color-primary);
  }

  @media screen and (max-width: 1274px) {
    .asset_name {
      display: none;
    }

    .asset_symbol {
      display: block;
    }
  }

  @media screen and (max-width: 1200px) {
    .type {
      display: none;
    }
  }

  @media screen and (max-width: 1010px) {
    .change {
      display: none;
    }

    .price {
      display: none;
    }

    .price_mobile {
      white-space: nowrap;
      display: block;
    }
  }

  @media screen and (max-width: 900px) {
    .asset_table_top {
      display: grid;
    }

    .action {
      display: none;
    }

    /* .value:hover .action {
      display: flex;
    }

    .value:hover .value_amount {
      display: none;
    } */

    table tbody tr:hover .value .action {
      display: flex;
    }

    table tbody tr:hover .value .value_amount {
      display: none;
    }
  }

  @media screen and (max-width: 368px) {
    .value {
      display: none;
    }
  }

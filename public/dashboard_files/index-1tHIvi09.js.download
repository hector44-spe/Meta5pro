  display: flex;
  flex-direction: column;
  gap: 32px;

  .empty_state {
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  /* .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  } */
`,ReferralStats$1=styled$2.div`
  display: grid;
  gap: 16px;
  margin-top: 24px;

  label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: hsla(0, 0%, 100%, 0.65);
  }

  .stats_wrapper {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat p:first-of-type {
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: hsla(0, 0%, 100%, 0.65);
  }

  .stat p:last-child {
    font-weight: 600;
    font-size: 18px;
    color: var(--color-primary-text);
  }
`,ReferralsTable=styled$2.div`
  margin-top: 16px;

  .head,
  .body_row {
    display: grid;
    grid-template-columns: 3fr 1.3fr 1.3fr;
    align-items: center;
    gap: 20px;
  }

  .head {
    /* background-color: orange; */
    font-size: 10px;
    line-height: 14px;
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
    padding: 0px 12px;
  }

  .body {
    display: grid;
    gap: 2px;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 12px;
  }

  .body_row {
    display: grid;
    grid-template-columns: 3fr 1.3fr 1.3fr;
    align-items: center;
    background-color: red;
    padding: 8px 12px;
    background: var(--color-card-background-50);
    cursor: pointer;
    margin-right: 10px;
    width: 100%;
    margin-bottom: 3px;
    min-height: 25px;
    border-radius: 4px;
    transition: background-color 0.3s;
  }

  .body_row:first-of-type {
    background: linear-gradient(270deg, #d0ad6e, #d0ad6e00), #5f9fff1a;
  }

  .body_row:nth-of-type(2) {
    background: linear-gradient(270deg, #b0c9d8, #b0c9d800), #5f9fff1a;
  }

  .body_row:nth-of-type(3) {
    background: linear-gradient(270deg, #bf876b, #bf876b00), #5f9fff1a;
  }

  .referral {
    /* min-width: 130px; */
    /* background-color: red; */
    display: flex;
    align-items: center;
    width: 100%;
    gap: 8px;
  }

  .referral p {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-primary-text);
    max-width: 120px;
  }

  .referral img {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    object-fit: cover;
    box-sizing: border-box;
  }

  .date {
    width: 100%;
    /* background-color: blue; */
  }

  .earned {
    width: 100%;
    /* background-color: pink; */
    /* min-width: 130px; */
  }
`,ActionMenu=({isOpen:er,onClose:tr,anchorEl:rr,children:nr})=>{const ir=reactExports.useRef(null);function ar(or){er&&ir.current&&!ir.current.contains(or.target)&&!rr.current.contains(or.target)&&tr()}return er?jsxRuntimeExports.jsx(ClickAwayListener,{onClickAway:ar,children:jsxRuntimeExports.jsx(ActionMenuWrapper,{ref:ir,isOpen:er,children:jsxRuntimeExports.jsx(ActionMenuContent,{children:nr})})}):null},ActionMenuWrapper=styled$2.div`
  position: absolute;
  top: 32px;
  right: 0;
  display: ${({isOpen:er})=>er?"block":"none"};
  min-width: 120px;
  z-index: 1000;
  background: var(--color-modal-background) !important;
  opacity: 0.977;
  backdrop-filter: blur(300px) !important;
  border-radius: 8px;
  border: 1px solid var(--color-card-background-3);
  box-shadow: 0 2px 10px var(--color-card-background-3);
`,ActionMenuContent=styled$2.div`
  display: flex;
  flex-direction: column;
  padding: 4px;

  button {
    background: transparent !important;
    border: none !important;
    border-radius: 6px !important;
    color: var(--color-text);
    padding: 8px 12px !important;
    min-width: 100% !important;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s;

    &:hover {
      color: var(--color-text) !important;
      background-color: var(--color-card-background-2) !important;
    }
  }

  margin-top: 24px;

  .empty_state {
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-text-75);
  }

  .table_wrapper {
    max-width: calc(100vw - 40px);
    overflow: scroll !important;
    padding-bottom: 48px;
    scroll-behavior: smooth;
    scroll-snap-align: y mandatory;
  }

  .content_wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .asset {
    display: flex;
    justify-content: space-between;
    width: 100%;
    background-color: transparent;
    padding: 10px 8px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    border-radius: 5px;
    align-items: center;
  }

  .asset:nth-of-type(odd) {
    background-color: var(--color-control);
  }

  .asset:hover {
    background-color: var(--color-control-hover);
  }

  .asset_left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .asset_left img {
    width: 28px !important ;
    height: 28px !important;
    object-fit: cover;
  }

  .asset_left span {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .asset_name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }

  .asset_value {
    display: flex;
    gap: 4px;
  }

  .asset_value p {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .asset_right span {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .asset_right .chevron_right {
    width: 16px;
    height: 16px;
    color: var(--color-primary);
  }

  .chevron_right_wrapper {
    display: none;
    transition: all 0.2s ease-in-out;
    height: 32px;
  }

  .asset:hover .chevron_right_wrapper {
    display: grid;
    place-items: center;
  }

  .asset:hover .asset_right span {
    display: none;
  }

  p.current_price {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  p.in_wallet {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  @media screen and (max-width: 350px) {
    .asset_right span {
      display: none;
    }

    .asset_right .chevron_right_wrapper {
      display: grid !important;
      place-items: center;
    }
  }
`,Content$3=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;
  position: relative;
  height: calc(100% - 40px);
  overflow-x: hidden;
  padding-bottom: 200px;

  .search_wrapper {
    margin-bottom: 16px;
  }

  .search_input {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--color-control);
    border-radius: 6px;
    border: 1px solid transparent;

    &:focus-within {
      border-color: var(--color-primary);
    }

    input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-text);
      font-size: 13px;

      &::placeholder {
        color: var(--color-text-secondary);
      }
    }
  }
`,Top=styled$2.div`
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 24px;
  border-bottom: 1px solid var(--color-border);

  .back_button {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    transition: all 0.2s ease;

    &:hover {
      background: var(--color-control);
    }
  }

  .title {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }
`,Footer=styled$2.div`
  display: flex;
  gap: 12px;
  padding: 16px 24px;
  border-top: 1px solid var(--color-border);
  background: var(--color-card-background);

  button {
    flex: 1;
  }

`,DrawerContent$1=styled$2(Drawer.Content)`
  display: flex;
  flex-direction: column;
  border-top-left-radius: 0px;
  border-top-right-radius: 0px;
  margin-top: 6rem;
  /* height: fit-content !important; */
  height: 100% !important;
  max-height: 80dvh !important;
  position: fixed;
  bottom: 0 !important;
  left: 0 !important;
  right: 0 !important;
  outline: none;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;
  overflow: hidden !important;
  padding: 0 !important;
  margin: 0 !important;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  z-index: 999;

  &.height_fit_content {
    height: fit-content !important;
  }

  .content_wrapper {
    padding: 0.5rem !important;
  }

  &.mobile_sheet_modal .content_wrapper {
    padding: 16px !important;
    overflow: hidden !important;
  }

  .drawer_header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

  .drawer_header .drawer_title {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600 !important;
    color: var(--color-text) !important;
  }
`,DrawerInner$1=styled$2.div`
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;

  .modal_description {
    font-size: 14px !important;
    line-height: 18px !important;
    color: var(--color-text-secondary) !important;
    max-width: 95% !important;
    margin-bottom: 16px !important;
  }

  .modal_footer {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box !important;
    width: 100%;
  }
`,DrawerHandle$1=styled$2.div`
  margin: 0 auto;
  width: 3rem;
  height: 0.375rem;
  flex-shrink: 0;
  border-radius: 9999px;
  background-color: var(--color-control);
  margin-top: 1rem !important;
  margin-bottom: 1rem !important;
`,DrawerContentWrapper$1=styled$2.div`
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  overflow: hidden !important;

  .content {
    display: grid !important;
    gap: 16px !important;
    flex: 1 !important;
    overflow-y: scroll !important;
    overflow-x: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    max-height: 100% !important;
  }
`;styled$2(Drawer.Title)`
  font-weight: 500;

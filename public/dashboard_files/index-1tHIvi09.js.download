`,NotificationsWrapper$4=styled$2.div`
  position: fixed;
  top: 0;
  right: 0;
  min-height: 100vh;
  height: 100%;
  z-index: 999;
  transform: ${({isOpen:er})=>er?"translateX(0)":"translateX(100%)"};
  padding: 16px;
  padding-top: 24px;
  opacity: ${({isOpen:er})=>er?1:.75};
  max-width: 400px;
  width: 100%;
  overflow-x: hidden;
  overflow-y: scroll;
  transition: all 300ms ease-in-out;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;

  .content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top .top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  /* &.open {
    transform: translateX(0);
    opacity: 1;
  } */

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    background-color: var(--color-modal-background) !important;
  }
`,NotificationsContent$3=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;
  position: relative;
  height: calc(100% - 40px);
  /* overflow: hidden; */
  /* height: 100%; */
  /* overflow-x: hidden; */
  /* overflow-y: scroll; */
  /* background: red !important; */
  /* padding-bottom: 400px; */
  /* background-color: blue; */

  .project_summary {
    display: flex;
    /* gap: 24px; */
    margin-top: 28px;
    /* padding: 0px 16px; */
    justify-content: space-between;
  }

  .project_summary span.strategy {
    text-align: right;
  }

  .project_summary span p:first-of-type {
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .project_summary span p:last-of-type {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-text);
    margin-top: 2px;
  }

  .project_title {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 30px;
  }

  .project_name {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .project_description {
    font-size: 13px;
    line-height: 20px;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .notification_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background: orange; */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .notification_item .delete_btn {
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    border-radius: 4px;
    display: none;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-secondary);
  }

  .notification_item .delete_btn:hover {
    background: var(--color-card-background-50);
    color: var(--color-text);
  }

  .notification_item:nth-of-type(odd) {
    background: var(--color-control) !important;
  }

  .notification_item:hover {
    background: var(--color-control-hover);
  }

  .notification_item:hover .delete_btn {
    display: grid;
  }

  .notification_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notification_item .left .left_info {
    display: grid;
    gap: 8px;
  }

  .notification_item .left .left_info_title {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .notification_item .left .left_info_title .title {
    font-size: 12px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .notification_item .left .left_info_title .label {
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .notification_item .left .left_info_value {
    font-size: 12px;
    font-family: 14px;
    line-height: 16px;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .notification_item .left img {
    width: 32px;
    height: 32px;
  }

  .notification_item .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .notification_item .right .right_info {
    display: flex;
    font-size: 12px;
    line-height: 14px;
    gap: 4px;
    text-align: right;
    align-self: flex-end;
  }

  .notification_item .right .right_info p.title {
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .notification_item .right .right_info p.value {
    font-weight: 600;
    color: var(--color-text);
  }

  /* top */
  .history_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history_top .history_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .history_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .history_top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  &.open {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    /* background-color: #050024 !important; */
    /* background-color: #05080b !important; */
  }

`,SlidingPageWrapper=styled$2.div`
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  z-index: 999;
  transform: ${({isOpen:er})=>er?"translateX(0)":"translateX(100%)"};
  padding: 16px;
  padding-top: 24px;
  opacity: ${({isOpen:er})=>er?1:.75};
  max-width: 400px;
  width: 100%;
  overflow-y: auto;
  transition: all 300ms ease-in-out;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;

  .content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .content_wrapper {
    overflow: scroll;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    gap: 6px;
    box-sizing: border-box;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top .top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .top .top_left_section {
    white-space: nowrap !important;
    width: 100%;
    min-width: 100px;
    display: grid;
    grid-template-columns: 16px auto;
    align-items: center;
    gap: 6px;
    appearance: button;
    cursor: pointer;
  }

  .top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  /* &.open {
    transform: translateX(0);
    opacity: 1;
  } */

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    background-color: var(--color-modal-background) !important;
  }
`,SlidingPageContent=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;

  position: absolute;
  width: 92%;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;
  border: 1px solid var(--color-card-background-3) !important;
  box-shadow: 24px;
  min-height: 300px;
  border-radius: 12px;
  transform: translate(-50%, -50%) !important;
  top: 50% !important;
  left: 50% !important;
  max-width: 430px;
  animation: fadeSlideIn 0.3s ease-out forwards;
  max-height: 90dvh !important;
  overflow-y: scroll;
  /* height: unset !important; */

  .modal_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal_top .modal_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .modal_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .modal_top button:hover {
    background: var(--color-control);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .modal_content {
    margin-top: 10px;
    display: grid;
    gap: 16px;
  }

  .modal_content .modal_description {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-text-secondary);
    max-width: 95%;
    /* margin-bottom: 16px; */
  }

  .modal_button {
    /* margin-top: 32px; */
  }

  @keyframes fadeSlideIn {
    0% {
      opacity: 0;
      margin-top: 10px;
    }
    100% {
      opacity: 1;
      margin-top: 0px;
    }
  }

  @media (max-width: 768px) {
    & {
      position: fixed !important;
      top: unset !important;
      bottom: 0 !important;
      left: 0 !important;
      z-index: 101 !important;
      width: 100% !important;
      max-width: unset !important;
      /* height: 100dvh !important; */
      max-height: 90dvh !important;
      transform: none !important;
      animation: fadeSlideUp 0.3s ease-out forwards !important;
      border-bottom-left-radius: 0px !important;
      border-bottom-right-radius: 0px !important;
    }
  }

  .modal_footer {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box !important;
    width: 100%;
  }

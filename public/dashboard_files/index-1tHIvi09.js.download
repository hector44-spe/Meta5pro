  width: 100%;
  height: 100%;
  padding: 24px;
  padding-bottom: 40px;
  background-color: var(--color-card-background);
  border-radius: 12px;
  min-height: 312px;

  .activity_wrapper {
    display: grid;
    margin-top: 16px;
    padding-top: 12px;
  }

  .activity_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.6;
    border-color: transparent !important;
  }

  .activity_wrapper .activity {
    font-size: 14px;
    color: var(--color-primary-text);
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 150ms ease-in-out;
    padding: 10px 12px;
  }

  .activity_wrapper .activity.no_padding {
    padding: 0px !important;
  }

  .activity_wrapper .activity .activity_date {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-text-50);
    /* display: none; */
  }

  .activity_wrapper .activity:not(:last-of-type) {
    padding-bottom: 12px;
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.05);
  }

  .activity_wrapper .activity:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-50);
    border-color: transparent;
  }
`,AssetsBalanceCard=styled$2.div`
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 24px;
  background: transparent;
  /* display: none; */
  border-radius: 12px;
  background-color: var(--color-card-background);

  .balance_card_button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
    cursor: pointer;
    background-color: var(--color-card-background-2);
    transition: all 0.4s ease-in;
    display: none;
  }

  .balance_card_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .balance_card_top_wrapper {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .balance_card_top_wrapper .balance_icon {
    border: none;
    outline: none;
    display: grid;
    place-items: center;
    padding: 8px;
    border-radius: 12px;
    background: hsla(0, 0%, 100%, 0.035);
    cursor: pointer;
    transition: all 150ms ease-out;
  }

  .balance_card_top_wrapper .balance_icon:hover {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .balance_card_top_wrapper button img {
    height: 16px;
    width: 16px;
  }

  .balance_card_top .balance .balance_wrapper {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .balance_card_top .balance .balance_wrapper .eyes_button {
    outline: none;
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px !important;
    height: 16px !important;
    cursor: pointer;
    color: var(--color-text-75);
    transition: all 150ms ease-out;
  }

  .balance_card_top .balance .balance_wrapper .eyes_button:hover {
    color: var(--color-primary-text);
  }

  .balance_card_top_buttons {
    text-transform: capitalize;
    background: var(--color-card-background);
    border-radius: 8px;
    padding: 4px;
  }

  .balance_card_top_button {
    background: transparent;
    color: rgba(255, 255, 255, 0.025);
    opacity: 0.5;
    transition: all 150ms ease-in;
    margin: 0 !important;
    border-radius: 4px !important;
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 600;
    cursor: pointer;
  }

  .balance_card_top_button.active {
    opacity: 1;
    background: rgba(255, 255, 255, 0.095) !important;
  }

  .balance_card_top_button img {
    height: 18px;
    width: 18px;
  }

  .balance_card_top_button.active img {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .balance_card_top .balance .balance_wrapper .label {
    font-size: 14px;
    color: var(--color-text-50);
    line-height: 16px;
    font-weight: 600;
  }

  .balance_card_top .balance .user_balance {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-primary-text);
    line-height: 32px;
    font-feature-settings: "tnum";
    transform: translateY(4px);
    animation: fadeInFromBottom 0.2s ease-out forwards;

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(8px);
      }
      50% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .balance_card_top .balance .user_balance.hidden {
    & i {
      display: inline-block;
      opacity: 0;
      transform: translateY(4px);
      animation: fadeInFromBottom 0.1s ease-out forwards;
    }

    & i:nth-of-type(1) {
      animation-delay: 0.1s;
    }

    & i:nth-of-type(2) {
      animation-delay: 0.15s;
    }

    & i:nth-of-type(3) {
      animation-delay: 0.25s;
    }

    & i:nth-of-type(4) {
      animation-delay: 0.33s;
    }

    & i:nth-of-type(5) {
      animation-delay: 0.46s;
    }

    & i:nth-of-type(6) {
      animation-delay: 0.57s;
    }

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(4px);
      }
      50% {
        filter: blur(2px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .balance_card_bottom {
    margin-top: 44px;
    overflow: scroll;
    position: relative;
    padding-bottom: 20px;
  }

  .balance_card_bottom_title {
    font-size: 14px;
    color: var(--color-text-50);
    line-height: 18px;
    font-weight: 700;
    border-radius: 4px;
  }

  .balance_card_bottom_wrapper {
    display: grid;
    gap: 8px;
    margin-top: 16px;
    transition: all 150ms ease-in-out;
  }

  .balance_card_bottom_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.5;
  }

  .bal.hidden {
    & i {
      display: inline-block;
      opacity: 0;
      transform: translateY(4px);
      animation: fadeInFromBottom 0.1s ease-out forwards;
    }

    /* & i:nth-of-type(1) {
        animation-delay: 0.1s;
        }

        & i:nth-of-type(2) {
        animation-delay: 0.15s;
        }

        & i:nth-of-type(3) {
        animation-delay: 0.25s;
        }

        & i:nth-of-type(4) {
        animation-delay: 0.33s;
        }

        & i:nth-of-type(5) {
        animation-delay: 0.46s;
        }


  width: 100%;
  height: 100%;
  margin-top: 24px;

  .content_wrapper {
    overflow-x: hidden;
    overflow-y: scroll;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    gap: 6px;
    box-sizing: border-box;
  }
`,Form$3=styled$2.div`
  display: grid;
  gap: 16px;

  .form_footer {
    margin-top: 24px;
  }

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .section_label {
    /* margin-top: 12px; */
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .toggle {
    display: grid;
    gap: 8px;
  }

  /* .section_label button {
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    color: var(--color-primary);
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
  } */

  .section_content {
    margin-top: 28px;
    display: grid;
    gap: 16px;
  }

  .section_footer {
    margin-top: 16px;
  }

  .section:not(:first-of-type) {
    margin-top: 24px;
  }
`,ReferralStats=styled$2.div`
  display: grid;
  gap: 16px;
  margin-top: 32px;

  label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .stats_wrapper {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat p:first-of-type {
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .stat p:last-child,
  .stat .balance {
    font-weight: 600;
    font-size: 18px;
    color: var(--color-text);
  }

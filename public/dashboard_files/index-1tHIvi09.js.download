  margin-top: 40px;

  label {
    font-size: 12px;
    line-height: 12px;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }

  .links_wrapper {
    /* display: flex;
    flex-direction: column;
    gap: 8px;
     */
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 8px;
  }

  .quick_link {
    outline: none;
    border: none;
    cursor: pointer;
    background: var(--color-control);
    border-radius: 5px;
    display: flex;
    gap: 6px;
    align-items: center;
    flex-flow: column;
    justify-content: center;
    font-size: 12px;
    padding: 25px 0;
    max-height: 100px;
    transition: all 150ms ease-out;
  }

  .quick_link.logout {
    background: var(--color-control-inactive);
  }

  /* .quick_link {
    padding: 12px 10px;
    border-radius: 8px;
    background: var(--color-card-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: all 150ms ease-in-out;
  } */

  .quick_link .quick_link_content {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
    color: var(--color-text);
    position: relative;
  }

  .quick_link span {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text);
    position: relative;
  }

  .quick_link .link_text {
    font-size: 12px;
    line-height: 12px;
    font-weight: 500;
  }

  .quick_link:hover {
    background: var(--color-control-active);
  }

  .quick_link .quick_link_chevron {
    transition: all 150ms ease-in-out;
  }

  .quick_link:hover .quick_link_chevron {
    transform: translateX(4px);
  }

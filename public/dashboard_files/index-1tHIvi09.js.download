`,TradesTableWrapper=styled$2.div`
  grid-area: table;
  width: 100%;
  height: 100%;
  min-height: 470px;
  border-radius: 12px;
  background-color: var(--color-card-background);

  .empty_state {
    padding: 8px;
    padding-bottom: 24px;
    color: var(--color-text-80);
    font-size: 13px;
    font-family: 14px;
    font-weight: 600;
  }

  .empty_state strong {
    color: var(--color-primary);
    font-weight: 700;
    cursor: pointer;
  }

  .profit {
    color: #00ff99 !important;
  }

  .loss {

  position: absolute;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(120px) !important;
  border: 1px solid var(--color-card-background-3) !important;
  box-shadow: 24px;
  padding: 16px;
  box-sizing: border-box;
  border-radius: 12px;
  transform: translate(-50%, -50%);
  top: 50%;
  left: 50%;
  max-width: 430px;
  animation: fadeSlideIn 0.3s ease-out forwards;
  overflow: hidden;
  z-index: 9999;

  @keyframes fadeSlideIn {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) translateY(0);
    }
  }

  .modal_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal_top .modal_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text) !important;
  }

  .modal_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .modal_top button:hover {
    background: var(--color-control);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .modal_content {
    margin-top: 6px;
    display: grid;
    gap: 16px;
    height: 100%;
    max-width: 250px;
    overflow: hidden;
  }

  .modal_content .modal_description {
    font-size: 13px;
    font-weight: 400;
    line-height: 20px;
    color: var(--color-text-tertiary);
    flex-wrap: wrap;
  }

  .modal_footer {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box !important;
    width: 100%;
  }

`,MineBalanceCard=styled$2.div`
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* flex-direction: column; */
  padding: 24px;
  background-color: var(--color-card-background);
  border-radius: 12px;

  .card_balances {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 64px;
  }

  .card_balance .main {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600 !important;
  }

  .card_balance .main {
    font-feature-settings: "tnum";
    transform: translateY(4px);
    animation: fadeInFromBottom 0.2s ease-out forwards;

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(8px);
      }
      50% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .card_balance .main.hidden {
    & i {
      display: inline-block;
      opacity: 0;
      transform: translateY(4px);
      animation: fadeInFromBottom 0.1s ease-out forwards;
    }

    & i:nth-of-type(1) {
      animation-delay: 0.1s;
    }

    & i:nth-of-type(2) {
      animation-delay: 0.15s;
    }

    & i:nth-of-type(3) {
      animation-delay: 0.25s;
    }

    & i:nth-of-type(4) {
      animation-delay: 0.33s;
    }

    & i:nth-of-type(5) {
      animation-delay: 0.46s;
    }

    & i:nth-of-type(6) {
      animation-delay: 0.57s;
    }

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(4px);
      }
      50% {
        filter: blur(2px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .card_balance .title.wrapper {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .card_balance .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .card_balance .value {
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .list {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pool_list {
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    border-radius: 120px;
    padding: 4px;
    /* gap: -12px; */
  }

  .pool_list img {
    width: 16px;
    height: 16px;
    cursor: pointer;
    transition: transform 0.2s ease-out;
  }

  .pool_list img:not(:first-of-type) {
    margin-left: -4px;
  }

  .pool_list img:hover {
    transform: translateY(-2px);
  }

  .stake_balance_button {
    /* background: transparent; */
    border: none;
    outline: none;
    padding: 8px 12px !important;
    border-radius: 6px;
    cursor: pointer;
    background-color: var(--color-card-background-50);
    transition: all 150ms ease-in;
    height: fit-content !important;
    display: flex;
    align-items: center;
    gap: 8px;
    max-height: max-content;
    /* background: red; */
    /* padding: 0px; */
    /* display: none; */
  }

  .stake_balance_button:hover {
    background-color: hsla(0, 0%, 100%, 0.075);
  }

  .stake_balance_button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .eyes_button {
    outline: none;
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px !important;
    height: 16px !important;
    cursor: pointer;
    color: var(--color-text-75);
    transition: all 150ms ease-out;
  }

  .eyes_button:hover {
    color: var(--color-primary-text);
  }

  @media screen and (max-width: 1100px) {
    & {
      align-items: flex-start;
    }

    .card_balances {
      flex-direction: column;
      align-items: flex-start;
      gap: 0px;
    }

    .card_balance.active {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .card_balance.rewards {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .card_balance.closed {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .card_balance p.value {
      font-size: 14px;
    }

    .card_balance.active p.title::after,
    .card_balance.rewards p.title::after,
    .card_balance.closed p.title::after {
      margin-right: 4px;
    }

    .card_balance .main {
      font-size: 20px;
    }
  }

  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 24px;

  .expert_stats_content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .expert_stat {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-control);
    padding: 12px;
    border-radius: 8px;
  }

  .expert_stat_titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .expert_stat_titles p:first-of-type {
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .expert_stat_titles p:last-of-type {
    font-size: 13px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text);
  }

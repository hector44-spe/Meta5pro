  .description {
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    max-width: 95%;
  }

  .modal_body {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }


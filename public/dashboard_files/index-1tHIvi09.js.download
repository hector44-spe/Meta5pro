  position: absolute;
  width: 92%;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;
  border: 1px solid var(--color-card-background-3) !important;
  box-shadow: 24px;
  padding: 16px;
  min-height: 300px;
  border-radius: 12px;
  max-width: 430px;
  animation: fadeSlideIn 0.3s ease-out forwards;
  overflow: scroll;
  height: ${({heightFitContent:er})=>er?"unset":"90dvh"};
  max-height: 90dvh;

  .modal_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal_top .modal_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .modal_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .modal_top button:hover {
    background: var(--color-control);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .modal_content {
    margin-top: 16px;
    display: grid;
    gap: 16px;
  }

  .modal_content .modal_description {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-text-secondary);
    max-width: 95%;
    margin-bottom: 16px;
  }

  .modal_button {
    margin-top: 32px;
  }

  @keyframes fadeSlideIn {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    & {
      position: fixed;
      top: unset;
      bottom: 0;
      left: 0;
      z-index: 101;
      width: 100%;
      max-width: unset;
      max-height: 85vh;
      transform: none;
      animation: fadeSlideUp 0.3s ease-out forwards;
      border-bottom-left-radius: 0px;
      border-bottom-right-radius: 0px;
    }
  }

  .modal_footer {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
    box-sizing: border-box !important;
    width: 100%;
  }

`,AssetListWrapper=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;

  .asset {
    /* gap: 4px; */
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px;
    height: 36px;
    background-color: var(--color-control);
    border-radius: 6px;
    transition: all 0.3s ease-out;
    border: 1px solid transparent;
    cursor: pointer;
  }

  .asset:hover {
    background: var(--color-control-hover);
    border-color: var(--color-primary);
  }

  .asset .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .asset .left img {
    width: 16px;
    height: 16px;
  }

  .asset .left .name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
  }

  .asset .left .name .symbol {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-left: 5px;
  }

  .asset .right {
    display: flex;
  }

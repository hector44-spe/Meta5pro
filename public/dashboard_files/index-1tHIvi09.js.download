`;styled$2.div`
  margin-top: 20px;
  padding: 16px;
  border-radius: 8px;
  background: var(--color-card-background-2);
  border: 1px solid var(--color-outline);
  color: var(--color-text-tertiary);
  font-size: 13px;
  line-height: 18px;

  p {
    color: inherit;
    margin-bottom: 12px;
  }

  .subscribers_list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .subscriber_item {
    padding: 4px 8px;
    background: var(--color-card-background-2);
    border: 1px solid var(--color-outline);
    border-radius: 120px;
    font-size: 12px;
    color: var(--color-text-75);
  }

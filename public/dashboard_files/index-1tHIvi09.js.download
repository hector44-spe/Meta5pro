  height: 40px;
  margin-bottom: 5px;
  padding: 0 10px 0 15px;
  background: #b0c9d81a;
  border-radius: 8px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;

  label {
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .switch_wrapper {
    border: none;
    outline: none;
    position: relative;
    min-height: 26px;
    min-width: 44px;
    background-color: rgba(255, 255, 255, 0.15);
    transition:
      background-color 0.3s,
      border-color 0.3s;
    border-radius: 5px;
    cursor: pointer;
  }

  .switch_wrapper .switch {
    display: inline-block;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: #8c95a0;
    min-width: 20px;
    min-height: 20px;
    border-radius: 4px;
    transition:
      transform 0.3s ease-out,
      background-color 0.3s;
    left: 3px;
  }

  .switch_wrapper .switch.active {
    transform: translate(18px, -50%);
    background-color: var(--color-primary);
  }
`,BillingDetailsEdit=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 12px;
  /* margin-top: 24px; */
`;styled$2.div`
  max-width: max-content;
  overflow: hidden;
  transition: all 150ms ease-in;
  /* height: 100%; */

  .previews_wrapper {
    display: flex;
    list-style: none;
    height: 250px;
    overflow-x: scroll;
    /* padding: 32px 24px; */
    padding: 32px 24px;
    flex: 0 0 600px;
    margin: 0 auto;
    scroll-behavior: smooth;
    max-width: 100%;
    overflow-x: scroll;
    display: flex;
    /* gap: 12px; */
    overflow-y: hidden;
  }

  .previews_wrapper .billing_preview {
    flex: 0 0 100px;
    background: var(--accent);
    margin: 0 20px 0 0;
    margin-top: 24px !important;
  }

  .previews_wrapper .billing_preview:last-of-type {
    margin: 0;
  }

  .previews_wrapper .billing_preview {
    position: relative;
    white-space: nowrap;
    display: grid;
    align-items: center;
    justify-items: center;
    cursor: pointer;
  }

  .previews_wrapper .billing_preview img {
    border-radius: 12px;
    aspect-ratio: 4.135/ 5.845;
    width: 100%;
    padding: 4px;
    border: 1px solid transparent;
    transition: border-color 0.3s ease-in-out;
  }

  .billing_preview.selected img {
    border: 1px solid var(--color-primary);
  }

  .billing_preview span {
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-text-50);
    margin-top: 6px;
  }

  .billing_preview.selected span {
    color: var(--color-primary-text);
  }
`;const FileUploadPrimary=styled$2.div`
  width: 100%;

  label {
    font-size: 13px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-text-80);
  }

  .file_upload_wrapper {
    background: var(--color-card-background);
    border-radius: 8px;
    padding: 4px 8px;
    margin-top: 6px;
    border: 1px dashed rgba(255, 255, 255, 0.05);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    padding-right: 4px;
    cursor: pointer;
    transition: border 150ms ease-out;
    height: 42px;
  }

  .file_upload_wrapper .left {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .file_upload_wrapper .left img {
    width: 24px;
    height: 24px;
    background: rgba(49, 172, 238, 0.1);
    border-radius: 4px;
    padding: 2px;
    opacity: 0.5;
    transition: all 150ms ease-out;
  }

  .file_upload_wrapper .left .icon {
    color: var(--color-primary);
    border-radius: 4px;
    padding: 2px;
    opacity: 0.5;
    transition: all 150ms ease-out;
  }

  .file_upload_wrapper .left p {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-text-80);
  }

  .file_upload_wrapper .left p strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .file_upload_wrapper .right {
  }

  .file_upload_wrapper .right {
  }

  .file_upload_wrapper:hover {
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .file_upload_wrapper:hover .left img {
    opacity: 1;
  }

  .file_upload_wrapper:hover .left .icon {
    opacity: 1;
    color: var(--color-primary);
  }

  position: relative;
  border-radius: 6px;
  background-color: var(--color-control);

  &:hover {
    background-color: var(--color-control-hover);
  }

  .move-money-button-options {
    opacity: 0;
    transition: opacity 0.2s ease;
    position: absolute;
    bottom: -36px;
    right: 0;
    display: flex;
    gap: 8px;
  }

  .move-money-button-option {
    transform: translateY(12px) scale(0.8);
    opacity: 0;
    transition: all 0.1s ease;
    background-color: var(--color-control-active);
    /* background: var(--color-primary); */
    padding: 8px 14px;
    border-radius: 6px;
    /* border-radius: 120px; */
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-75);
    /* color: var(--color-primary-text); */
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 100;
  }

  .move-money-button-option:hover {
    color: var(--color-text);
  }

  .move_money_button_chevron {
    color: var(--color-text-50);
    transition: all 200ms ease;
  }

  &:hover {
    .move-money-button-options {
      opacity: 1;
    }

    .move_money_button_chevron {
      transform: rotate(180deg);
    }

    .move_money_button_shine {
      display: none;
    }

    .move-money-button-option:nth-of-type(1) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 0ms;
    }

    .move-money-button-option:nth-of-type(2) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 50ms;
    }

    .move-money-button-option:nth-of-type(3) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 100ms;
    }

    .move-money-button-option:nth-of-type(4) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 150ms;
    }

    .move-money-button-option:nth-of-type(5) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 200ms;
    }
  }

  .move_money_button {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px 12px;
    outline: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-50);
    position: relative;
    overflow: hidden;
    background: transparent;
    border-radius: 6px !important;
  }

  .move_money_button_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-blue-shine),
      transparent
    );
    animation: shine 3s ease-in-out infinite;
    animation-delay: 1s;
    border-radius: 24px !important;
  }

  .move_money_button_icon,
  .move_money_button_text {
    color: var(--color-primary);
  }
`,BalanceCardTop=styled$2.div`
  display: flex;
  justify-content: space-between;
  align-items: center;

  .balance_card_top_wrapper {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  /* .balance_card_top_wrapper .balance_icon {
    border: none;
    outline: none;
    display: grid;
    place-items: center;
    padding: 8px;
    border-radius: 12px;
    background: var(--color-card-background-35);
    cursor: pointer;
    transition: all 150ms ease-out;
  } */

  .balance_card_top_wrapper .balance_icon:hover {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .balance_card_top_wrapper button img {
    height: 16px;
    width: 16px;
  }

  .balance .balance_wrapper {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .balance .balance_wrapper .eyes_button {
    outline: none;
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px !important;
    height: 16px !important;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all 150ms ease-out;
  }

  .balance .balance_wrapper .eyes_button:hover {
    color: var(--color-text);
  }

  .balance_card_top_buttons {
    text-transform: capitalize;
    border: 1px dashed var(--color-box-border);
    border-radius: 6px;
    /* padding: 4px; */
    display: flex;
    gap: 2px;
    /* gap: 8px; */
  }

  .balance_card_top_button {
    background: transparent;
    background: var(--color-control-inactive) !important;
    color: var(--color-card-background-25);
    opacity: 0.5;
    transition: all 150ms ease-in;
    margin: 0 !important;
    /* border-radius: 4px !important; */
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    /* border-radius: 6px; */
    /* font-size: 14px; */
    color: var(--color-text);
    cursor: pointer;
  }

  .balance_card_top_button:first-of-type {
    border-radius: 6px 0 0 6px;
  }

  .balance_card_top_button:last-child {
    border-radius: 0 6px 6px 0;
  }

  .balance_card_top_button.active {
    opacity: 1;
    /* color: var(--color-primary) !important; */
    background: var(--color-control-active);
  }

  .balance_card_top_button img {
    height: 18px;
    width: 18px;
  }

  .balance_card_top_button.active img {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .balance .balance_wrapper .label {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 16px;
    font-weight: 600;
  }

  .balance .user_balance {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 32px;
    font-feature-settings: "tnum";
    transform: translateY(4px);
    animation: fadeInFromBottom 0.2s ease-out forwards;

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(8px);
      }
      50% {
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .balance .user_balance.hidden {
    & i {
      display: inline-block;
      opacity: 0;
      transform: translateY(4px);
      animation: fadeInFromBottom 0.1s ease-out forwards;
    }

    & i:nth-of-type(1) {
      animation-delay: 0.1s;
    }

    & i:nth-of-type(2) {
      animation-delay: 0.15s;
    }

    & i:nth-of-type(3) {
      animation-delay: 0.25s;
    }

    & i:nth-of-type(4) {
      animation-delay: 0.33s;
    }

    & i:nth-of-type(5) {
      animation-delay: 0.46s;
    }

    & i:nth-of-type(6) {
      animation-delay: 0.57s;
    }

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(4px);
      }
      50% {
        filter: blur(2px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }
`,BalanceCardBottom=styled$2.div`
  margin-top: 44px;
  overflow: scroll;
  position: relative;
  padding-bottom: 8px;

  .balance_card_button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--color-text-50);
    line-height: 18px;
    font-weight: 600;
    cursor: pointer;
    background-color: var(--color-control-active);
    transition: all 0.4s ease-in;
    display: none;
  }

  .balance_card_bottom_title {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
    border-radius: 4px;
    /* padding: 6px; */
  }

  .balance_card_bottom_wrapper {
    display: grid;
    /* gap: 8px; */
    margin-top: 16px;
    transition: all 150ms ease-in-out;
  }

  .balance_card_bottom_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.5;
  }

  @media screen and (max-width: 768px) {
    &.desktop {
      display: none;
    }
  }
`,BalanceCardWrapper=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 8px;

  .desktop_right_options {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .mobile_right_options {
    display: none;
  }

  .mobile_bottom_card {
    display: none;
    padding: 24px;
    background: var(--color-card-background);
    box-sizing: border-box;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
  }

  .bal.hidden {
    & i {
      display: inline-block;
      opacity: 0;
      transform: translateY(4px);
      animation: fadeInFromBottom 0.1s ease-out forwards;
    }

    @keyframes fadeInFromBottom {
      0% {
        opacity: 0;
        transform: translateY(10px);
        filter: blur(4px);
      }
      50% {
        filter: blur(2px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
        filter: blur(0);
      }
    }
  }

  .assets_button {
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    border: none;
    background: transparent;
    transition: all 150ms ease-out;
  }

  @media screen and (max-width: 768px) {
    .mobile_bottom_card {
      display: block;
      height: 100%;
    }

    .mobile_right_options {
      display: block;
    }

    .desktop_right_options {
      display: none;
    }
  }
`,BalanceCardContent=styled$2.div`
  /* height: fit-content; */
  width: 100%;
  box-sizing: border-box;
  padding: 24px;
  background: transparent;
  position: relative;
  border-radius: 12px;

  .mobile_quick_actions_panel {
    display: none;
    margin-top: 40px;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
  }

  .balance_card_button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
    cursor: pointer;
    background-color: var(--color-card-background-2);
    transition: all 0.4s ease-in;
    display: none;
  }

  @media screen and (max-width: 1274px) {
    & {
      background: var(--color-card-background);
      border-radius: 12px;
    }
  }

  @media screen and (max-width: 768px) {
    .mobile_quick_actions_panel {
      display: flex;
    }
  }
`,AccountSummary=styled$2.div`
  display: grid;
  /* margin-top: 16px; */
  padding-top: 12px;

  .account_summary_button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 600;
    cursor: pointer;
    background-color: var(--color-control-inactive);
    transition: all 150ms ease-out;
    /* display: none; */
  }

  .account_summary_button:hover {
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  &:has(> :hover) > *:not(:hover) {
    opacity: 0.6;
    border-color: transparent !important;
  }

  & .account_summary_new_item {
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
    cursor: pointer;
    display: grid;
    grid-template-columns: 120px 150px 100px;
    align-items: center;
    justify-content: space-between;
    transition: all 150ms ease-out;
    box-sizing: border-box;
    padding: 6px 0px;
    height: 52px;
  }

  & .account_summary_new_item div:first-of-type {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  & .account_summary_new_item span {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  & .account_summary_new_item span img {
    height: 18px;
    width: 18px;
  }

  & .account_summary_new_item .title {
    white-space: nowrap;
    font-weight: 600;
    color: var(--color-text);
  }

  & .account_summary_new_item .value {
    color: var(--color-text-secondary);
    white-space: nowrap;
    width: 100%;
    max-width: max-content;
  }

  & .account_summary_new_item:not(:last-of-type) {
    border-bottom: 1px solid var(--color-account-card-background);
  }

  & .account_summary_new_item:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-2);
    border-color: transparent;
  }

  & .account_summary_new_item:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-2);
    border-color: transparent;
  }

  @media screen and (max-width: 550px) {
    & .account_summary_new_item {
      display: flex;
      justify-content: space-between;
      width: 100%;
      /* padding: 12px 6px; */
      padding: 12px 6px;
    }

    .account_summary_button {
      display: none;
    }

    & .account_summary_new_item:hover .value {
      display: none;
    }

    & .account_summary_new_item:hover .account_summary_button {
      display: block;
    }
  }
`,Categories$1=styled$2.div`
  /* categories */
  padding: 0px 6px;

  & {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 16px;
  }

  & .bars {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  & .bars .bar {
    height: 24px;
  }

  /* & .bars:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  & .bars:last-child {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  } */

  & .titles {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 24px;
  }

  & .bars .bar:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  & .bars .bar:last-child {
    border-top-right-radius: 6px !important;
    border-bottom-right-radius: 6px !important;
  }

  /* & .bars .bar:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  & .bars .bar:last-of-type {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  } */

  & .titles .title {
    display: flex;
    align-items: flex-start;
    gap: 4px;
  }

  & .titles .title .icon {
    margin-top: 5px;
  }

  & .titles .title p:nth-of-type(1) {
    font-size: 14px;
    color: var(--color-text-48);
    line-height: 18px;
    font-weight: 600;
  }

  & .titles .title p:nth-of-type(2) {
    font-size: 16px;
    color: var(--color-text);
    line-height: 24px;
    font-weight: 600;
    margin-top: 4px;
  }
`,Asset=styled$2.div`
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 6px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 80ms ease-out;

  &:not(:last-of-type) {
    /* padding-bottom: 8px; */
    border-bottom: 1px solid var(--color-account-card-background);
  }

  &:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-2);
    border-color: transparent;
  }

  &:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-2);
    border-color: transparent;
  }

  .balance_card_bottom_asset_left {
    display: grid;
    grid-template-columns: 32px auto;
    gap: 12px;
  }

  .balance_card_bottom_asset_left img {
    min-width: 32px;
    min-height: 32px;
    width: 100%;
    height: 100%;
  }

  .balance_card_asset_titles,
  .balance_card_bottom_asset_right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* gap: 4px; */
  }

  .balance_card_bottom_asset_right {
    align-items: flex-end;
  }

  .balance_card_asset_titles p:nth-of-type(1),
  .balance_card_bottom_asset_right p:nth-of-type(1) {
    font-size: 16px;
    color: var(--color-text);
    line-height: 24px;
    font-weight: 600;
  }

  .balance_card_bottom_asset_right p:nth-of-type(2),
  .balance_card_asset_titles p:nth-of-type(2) {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .balance_card_bottom_asset:hover .balance_card_button {
    background-color: var(--color-card-background-2);
    color: var(--color-text);
  }
`,MainCard=({children:er})=>jsxRuntimeExports.jsx(MainCardWrapper,{children:er}),MainCardWrapper=styled$2.div`
  grid-area: main;
  display: grid;
  grid-template-columns: auto 500px;
  /* gap: 8px; */
  width: 100%;
  min-height: 49px;
  height: 100%;
  background-color: var(--color-card-background);
  border-radius: 12px;

  /* summary */
  .summary_section {
    /* margin-top: 8px; */
    margin-top: 16px;
    width: 100%;
    display: grid;
    /* gap: 0px; */
    /* gap: 8px; */
    /* grid-template-columns: repeat(7, auto); */
    /* justify-content: space-between; */
    /* flex-wrap: wrap; */
  }

  .summary_section .summary_item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* padding: 8px; */
    /* background: red; */
    /*  */
    border-radius: 6px;
    padding: 4px 6px;
    cursor: pointer;
    transition: background 150ms ease-out;
  }

  .summary_section .summary_item:not(:last-of-type) {
    padding-bottom: 12px !important;
  }

  .summary_item:hover {
    border-radius: 6px;
    background-color: var(--color-card-background-50);
    border-color: transparent !important;
    /* padding: 4px 8px; */
  }

  .summary_section .summary_item img {
    /* width: 24px;
    height: 24px;
    margin-right: 8px; */
    /* filter: brightness(0) invert(1); */
  }

  .summary_section .summary_item:hover {
    /* background-color: rgba(255, 255, 255, 0.05); */
  }

  .summary_section .summary_item .wrapper {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .summary_section .summary_item p:nth-of-type(1) {
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 600;
  }

  .summary_section .summary_item p:nth-of-type(2) {
    font-size: 16px;
    color: var(--color-text-48);
    line-height: 24px;
    font-weight: 600;
    /* margin-top: 4px; */
  }

  .account_card_bottom {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  @keyframes blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
    100% {
      opacity: 1;
    }
  }

  @media screen and (max-width: 1274px) {
    & {
      display: flex;
      flex-direction: column;
      background: transparent;
      /* gap: 8px; */
    }
  }

  }

  .toggle {
    display: grid;
    gap: 8px;
  }

  .section_label button {
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    color: var(--color-primary);
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
  }

  .section_content {
    /* margin-top: 16px; */
    display: grid;
    gap: 16px;
  }

  .section_footer {
    margin-top: 16px;
  }

  /* .section:not(:first-of-type) {
    margin-top: 24px;
  } */

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .notification_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background: orange; */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .notification_item .delete_btn {
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    border-radius: 4px;
    display: none;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-50);
  }

  .notification_item .delete_btn:hover {
    background: var(--color-card-background-50);
    color: var(--color-primary-text);
  }

  .notification_item:nth-of-type(odd) {
    background: var(--color-control) !important;
  }

  .notification_item:hover {
    background: var(--color-control-hover);
  }

  .notification_item:hover .delete_btn {
    display: grid;
  }

  .notification_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notification_item .left .left_info {
    display: grid;
    gap: 8px;
  }

  .notification_item .left .left_info_title {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .notification_item .left .left_info_title .title {
    font-size: 12px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-text);
  }

  .notification_item .left .left_info_title .label {
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .notification_item .left .left_info_value {
    font-size: 12px;
    font-family: 14px;
    line-height: 16px;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .notification_item .left img {
    width: 32px;
    height: 32px;
  }

  .notification_item .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .notification_item .right .right_info {
    display: flex;
    font-size: 12px;
    line-height: 14px;
    gap: 4px;
    text-align: right;
    align-self: flex-end;
  }

  .notification_item .right .right_info p.title {
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .notification_item .right .right_info p.value {
    font-weight: 600;
    color: var(--color-primary-text);
  }

  /* top */
  .history_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history_top .history_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .history_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .history_top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  &.open {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    /* background-color: #050024 !important; */
    /* background-color: #05080b !important; */
  }

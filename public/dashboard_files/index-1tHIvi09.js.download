  .single_user_top {
    max-width: max-content;
  }

  @media screen and (max-width: 1274px) {
    .user_context_switcher .switcher_wrapper {
      max-width: calc(100vw - 340px);
      overflow-x: scroll;
      overflow-y: hidden;
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 1024px) {
    .user_context_switcher .switcher_wrapper {
      max-width: calc(100vw - 350px);
    }
  }

  @media screen and (max-width: 768px) {
    .user_context_switcher .switcher_wrapper {
      max-width: calc(100vw - 64px);
    }
  }
`,SingleUserContent=styled$2.div`
  display: grid;
  grid-template-columns: 200px auto;
  gap: 40px;
  margin-top: 40px;
  /* background: red; */

  .settings_menu_mobile {
    display: none;
  }

  @media screen and (max-width: 1024px) {
    & {
      grid-template-columns: auto;
    }

    .settings_menu_mobile {
      display: block;
    }
  }
`,SingleUserContentMenuDesktop=styled$2.div`
  display: grid;
  gap: 0px !important;
  height: max-content;

  .settings_item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    padding: 12px;
    border-radius: 6px;
    cursor: pointer;
    max-width: 100%;
    height: max-content;
    margin-top: 0px !important;
    transition: all 150ms ease-in-out;
  }

  .settings_item:hover {
    background-color: var(--color-control-hover);
    padding: 12px 16px;
  }

  .settings_item p {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
  }

  .settings_item.active {
    background-color: var(--color-control-active);
  }

  .settings_item.active img {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .settings_item.active p {
    color: var(--color-text);
  }

  .settings_item:hover img {
    fill: white;
    stroke: white;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .settings_item:hover p {
    color: var(--color-text);
  }

  @media screen and (max-width: 1024px) {
    & {
      display: none;
    }
  }

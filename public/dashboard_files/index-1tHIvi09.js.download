  transition: all 300ms ease-in-out;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;

  .content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top .top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  /* &.open {
    transform: translateX(0);
    opacity: 1;
  } */

  @media screen and (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    background-color: var(--color-modal-background) !important;
  }
`,ExpertPanelContent=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;
  position: relative;
  height: calc(100% - 40px);
  overflow-x: hidden;
  overflow-y: auto;
  /* background: red !important; */
  padding-bottom: 200px;
  position: relative;

  .top_wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-modal-background) !important;
    padding-bottom: 12px;
  }

  @media screen and (max-width: 1024px) {
    .top_wrapper {
      background: var(--color-modal-background) !important;
    }
  }

  .primary_button {
    margin-top: 32px;
    width: 100%;
    height: 40px;
    border-radius: 6px;
    border: none;
    outline: none;
    cursor: pointer;
    background-color: var(--color-primary);
  }

  .primary_button.disabled {
    background-color: grey;
    user-select: none;
    cursor: not-allowed;
  }

  .primary_button.subscribed {
    background-color: #ff3344;
  }

  .buttons {
    display: flex;
    gap: 12px;
    margin-top: 12px;
  }

  .profile_wrapper {
    display: grid;
    grid-template-columns: 52px auto;
    align-items: center;
    gap: 12px;
  }

  .image_wrapper {
    height: 52px;
    width: 52px;
  }

  //   top
  .details_row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: auto;
  }

  .details_row_left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .helper_icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .details_row_left_item {
    display: flex;
    gap: 4px;
  }

  .details_row_left_item p:first-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .details_row_left_item p:last-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .details_row_right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .expert_bio {
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-text-75);
    margin-top: 20px;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .notification_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background: orange; */
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .notification_item .delete_btn {
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    border-radius: 4px;
    display: none;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-50);
  }

  .notification_item .delete_btn:hover {
    background: var(--color-card-background-50);
    color: var(--color-primary-text);
  }

  .notification_item:nth-of-type(odd) {
    background: rgba(255, 255, 255, 0.01) !important;
  }

  .notification_item:hover {
    background: rgba(255, 255, 255, 0.055);
  }

  .notification_item:hover .delete_btn {
    display: grid;
  }

  .notification_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notification_item .left .left_info {
    display: grid;
    gap: 8px;
  }

  .notification_item .left .left_info_title {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .notification_item .left .left_info_title .title {
    font-size: 12px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .notification_item .left .left_info_title .label {
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-50);
    font-weight: 500;
  }

  .notification_item .left .left_info_value {
    font-size: 12px;
    font-family: 14px;
    line-height: 16px;
    font-weight: 400;
    color: var(--color-text-50);
  }

  .notification_item .left img {
    width: 32px;
    height: 32px;
  }

  .notification_item .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .notification_item .right .right_info {
    display: flex;
    font-size: 12px;
    line-height: 14px;
    gap: 4px;
    text-align: right;
    align-self: flex-end;
  }

  .notification_item .right .right_info p.title {
    font-weight: 500;
    color: var(--color-text-50);
  }

  .notification_item .right .right_info p.value {
    font-weight: 600;
    color: var(--color-primary-text);
  }

  /* top */
  .history_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history_top .history_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .history_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .history_top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  &.open {
    transform: translateX(0);
    opacity: 1;
  }

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
  }

`,Header=styled$2.div`
  display: flex;
  justify-content: space-between;
  align-items: center;

  .header_left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header_title {
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
  }

  .header_title_strong {
    margin-left: 8px;
    color: var(--color-text-secondary);
  }
`,Content$4=styled$2.div`
  margin-top: 16px;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  max-height: 70dvh;

  .description {
    color: var(--color-text-secondary);
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    max-width: 95%;
  }

  .modal_body {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
  }

  @media (max-height: 600px) {
    max-height: 50dvh;
    overflow: auto;
  }
`,Footer$1=styled$2.div`
  margin-top: 24px;
  padding: 0px 0px 0px 0px;
  /* position: sticky; */
  bottom: 0 !important;
  position: sticky !important;
  left: 0 !important;
  z-index: 101;
  background-color: var(--color-modal-background);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  .footer_button {
    width: 100%;
    height: 40px;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer_button.disabled {
    background-color: grey;
    color: var(--color-text);
    cursor: not-allowed;
    user-select: none;
  }

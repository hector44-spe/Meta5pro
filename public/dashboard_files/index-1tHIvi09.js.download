  padding: 0px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);

  .investment_details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: max-content;
    height: unset !important;
    margin-top: 24px;
  }

  .investment_details .timeline_detail {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .timeline_detail {
    flex-direction: column;
  }

  .investment_details .detail {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 4px;
  }

  .timeline_titles {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }

  .timeline_progress {
    width: 100%;
    height: 6px;
    background: var(--color-card-background);
    border-radius: 12px;
    margin-top: 4px;
  }

  .timeline_progress_bar {
    width: 100%;
    height: 100%;
    border-radius: 12px;
  }

  .timeline_progress_bar_fill {
    height: 100%;
    background: var(--color-primary);
    transition: all 150ms ease-in;
    border-radius: 12px;
  }

  .detail .title,
  .timeline_titles p:first-of-type {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .detail .value,
  .timeline_titles p:last-of-type {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text);
    font-weight: 600;
  }

  .realestate_card_image_skeleton {
    width: 100%;
    height: 100%;
    background-color: var(--color-card-background);
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
  }

  .realestate_card_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      hsla(0, 0%, 100%, 0.025),
      transparent
    );
    animation: shine 1.5s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 12px !important;
  }

  &:hover {
    background-color: var(--color-box-border) !important;
  }

  .project_wrapper {
    padding: 16px;
  }

  .project_image_wrapper {
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
    height: 200px;
  }

  .project_image {
    max-height: 200px;
    width: 100%;
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
  }

  .project_image.closed {
    filter: grayscale(100%);
  }

  /* .project_details { */
  /* background: orange; */
  /* margin-top: 16px; */
  /* height: 88px; */
  /* } */

  .project_details .project_title {
    font-size: 15px;
    line-height: 18px;
    color: var(--color-primary-text);
    font-weight: 600;
  }

  .project_details .project_description {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 20px;
    font-weight: 400;
    margin-top: 6px;
  }

  .project_details .project_description .see_more_button {
    background: none;
    border: none;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
    margin-top: 4px;
    text-decoration: underline;
  }

  .project_details .project_description .see_more_button:hover {
    color: #1a8bc7;
  }

  .project_summary {
    display: flex;
    /* gap: 24px; */
    margin-top: 28px;
    /* padding: 0px 16px; */
    justify-content: space-between;
  }

  .project_summary span.strategy {
    text-align: right;
  }

  .project_summary span p:first-of-type {
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .project_summary span p:last-of-type {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-primary-text);
    margin-top: 2px;
  }

  .project_actions {
    margin-top: 40px;
    display: flex;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    gap: 12px;
  }

  @media screen and (max-width: 768px) {
    .project_summary {
      margin-top: 40px;
    }
  }

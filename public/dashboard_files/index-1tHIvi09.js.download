  .input_wrapper {
    background-color: var(--color-control);
    border: 1px solid var(--color-card-background-3);
  }

  .form {
    display: grid;
    gap: 16px;
  }

  .form_footer {
    margin-top: 24px;
  }

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 6px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .section_content {

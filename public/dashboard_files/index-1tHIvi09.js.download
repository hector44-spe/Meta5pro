  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  padding: 24px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;

  &:hover {
    background-color: var(--color-box-border) !important;
  }

  .subscribe_card_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .subscribe_card_top p:first-of-type {
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    color: var(--color-text);
  }

  .subscribe_card_top p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  .subscribe_card_details {
    margin-top: 40px;
    display: grid;
    gap: 12px;
  }

  .subscribe_card_detail {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }

  .subscribe_card_detail p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .subscribe_card_detail:not(:last-of-type) {
    border-bottom: 1px solid var(--color-outline);
  }

  .subscribe_card_detail p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .subscribe_card_detail p.roi {
    color: #01b28b;
  }

  .subscribe_card_amount {
    margin-top: 32px;
  }

  .subscribe_card_footer {
    margin-top: 32px;
    width: 100%;
  }

  .subscribe_card_button p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

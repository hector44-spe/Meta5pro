    }
  }
`,AssetsTable=styled$2.div`
  background: var(--color-card-background) !important;
  padding: 12px;
  box-sizing: border-box !important;
  height: 100%;
  overflow: hidden;
  border-radius: 12px;

  .asset_table_top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px;
    width: 100%;
    padding-bottom: 24px;
    justify-content: space-between;
    /* position: sticky; */
    /* top: 0; */
  }

  .asset_table_top_title {
    font-size: 16px;
    font-family: 24px;
    font-weight: 600;
    color: var(--color-text-75);
  }

  table {
    width: 100%;
    padding: 24px;
  }

  table thead th {
    font-size: 12px;
    font-family: 16px;
    font-weight: 500;
    color: var(--color-text-secondary) !important;
  }

  table tbody td {
    font-size: 14px;
    font-family: 18px;
    font-weight: 500;
  }

  table thead tr,
  table tbody tr {
    width: 100%;
    gap: 12px;
    align-items: center;
    display: flex;
    justify-content: space-between;
    padding-right: 105px !important;
  }

  table thead tr {
    background: transparent;
    padding: 4px 8px;
    border-radius: 8px;
  }

  /* table thead th {
    position: sticky;
    top: 0;
    background-color: var(--color-card-background);
    z-index: 10;
  } */

  table tbody {
    display: grid;
    gap: 8px;
    height: 97%;
    width: 100%;
    overflow: scroll;
    padding-top: 12px;

    mask: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0),
      #000 3px calc(100% - 18px),
      rgba(0, 0, 0, 0)
    );
  }

  table tbody tr:nth-of-type(even) {
    background: transparent;
  }

  table tbody tr:nth-of-type(odd) {
    background: var(--color-card-background-2) !important;
  }

  table tbody tr {
    padding: 12px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.1s ease-in-out;
    height: 52px;
  }

  table tbody tr:hover {
    background: var(--color-card-background-50) !important;
  }

  table tbody:has(> :hover) > *:not(:hover) {
    opacity: 0.7;
  }

  .asset {
    min-width: 50px;
    max-width: 250px;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 2px;
    align-items: center;
    white-space: nowrawp;
  }

  .asset_icon {
    width: 17px;
    height: 17px;
    margin-right: 8px;
    border-radius: 100%;
  }

  .asset_name,
  .asset_symbol {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
    white-space: nowrap;
  }

  .asset_symbol {
    display: none;
  }

  .symbol {
    min-width: 60px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: none;
  }

  .type {
    min-width: 60px;
    width: 100%;
    text-align: center;
    text-transform: capitalize;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .price {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
  }

  .fiat_price {
    min-width: 100px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: none;
  }

  .value {
    min-width: 10px;
    width: 100%;
    text-align: center;
    color: var(--color-text-80);
    display: grid;
    place-content: center;
    /* display: grid; */
  }

  .value .action {
    display: none;
  }

  .action {
    min-width: 80px;
    width: 100%;
    display: flex;
    align-content: center;
    display: flex;
    gap: 6px;
    text-align: left;
    padding-left: 50px;
  }

  .action button {
    border: none;
    cursor: pointer;
    padding: 6px 12px;
    max-width: max-content;
    border-radius: 4px;
    color: var(--color-primary-text);
    background-color: var(--color-card-background-50);
    transition: all 150ms ease-out;
  }

  .action button:hover {
    background: var(--color-primary);
  }

  @media screen and (max-width: 1200px) {
    .asset_name {
      display: none;
    }

    .asset_symbol {
      display: block;
    }

    .actual_price {
      display: none;
    }
  }

  @media screen and (max-width: 1010px) {
    .type {
      display: none;
    }
  }

  @media screen and (max-width: 900px) {
    .asset_table_top {
      display: grid;
    }

    .price {
      display: none;
    }
  }

  @media screen and (max-width: 900px) {
    .asset {
      width: 100%;
      max-width: unset;
    }

    .action {
      display: none;
      padding-left: 20px;
    }

    /* .asset_name {
      display: block;
      width: 100%;
    }

    .asset_symbol {
      display: none;
    } */

    table thead tr,
    table tbody tr {
      padding-right: 0px !important;
    }

    table tbody tr:hover .value .action {
      display: flex;
    }

    table tbody tr:hover .value .value_amount {
      display: none !important;
    }

    /* .value:hover .action {
      display: flex;
    }

    .value:hover .value_amount {
      display: none;
    } */
  }

  @media screen and (max-width: 500px) {
    table tbody tr:hover .value .action {
      place-content: center;
      padding-right: 20px;
    }

    /* table tbody tr:hover .value .action button:last-of-type {
      display: none;
    } */

    table tbody tr:hover .value .value_amount {
      display: none !important;
    }

    /* .value .action {
      display: none !important;
    } */
  }
`,Categories=styled$2.div`
  /* categories */
  padding: 0px 6px;

  &.no-padding {
    padding: 0px !important;
  }

  & {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 16px;
  }

  & .bars {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  & .bars .bar {
    height: 24px;
  }

  /* & .bars:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  & .bars:last-child {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  } */

  & .titles {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 24px;
  }

  & .bars .bar:first-of-type {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
  }

  & .bars .bar:last-child {
    border-top-right-radius: 6px !important;
    border-bottom-right-radius: 6px !important;
  }

  /* & .bars .bar:first-of-type {

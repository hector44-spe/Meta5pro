  .status {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--color-primary-text);
  }

  .status_text {
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
  }

  .status.success {
    color: #4ebe96;
  }

  .status.error {
    color: #ff3344;
  }

  .icon {
    min-width: 16px;
    min-height: 16px;
  }

  .form {
    margin-top: 24px;
    display: grid;
    gap: 16px;
  }

  .form_footer {

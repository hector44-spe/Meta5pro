`,NotificationCounter=styled$2.span`
  position: absolute;
  top: -5px;
  right: -5px;
  font-size: 10px;
  background-color: #ff3344;
  color: var(--color-white);
  padding: 3px;
  font-weight: 700;
  border-radius: 12px;
  animation: pulsate 1.5s infinite, bounce 1s infinite;
  transition: display 150ms ease-in-out;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 16px;
  min-width: 16px;
  width: "auto";
  white-space: nowrap;

  &.quick_link_badge {
    position: unset !important;
    animation: bounce 1s infinite !important;
  }

  &.zero {
    display: none;
  }

  /* animations */
  @keyframes pulsate {
    0% {
      box-shadow: 0 0 5px ff3344;
    }
    50% {
      box-shadow: 0 0 20px #ff3344;
    }
    100% {
      box-shadow: 0 0 5px ff3344;
    }
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-2px);
    }
    60% {
      transform: translateY(-1px);
    }
  }
`,LoaderBox=styled$2.div`
  display: flex;
  align-items: center;
  border-radius: 8px;
  background-color: var(--color-control);
  box-sizing: border-box;
  position: relative;
  width: 100%;
  overflow: hidden;
  height: 42px;
  margin-top: 8px;

  .loader_box {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    text-align: left;
    gap: 8px;
    padding-left: 12px;
  }

  .dancing-text {
    font-size: 14px;
    font-weight: 500;
    display: inline-block;
  }

  .dancing-letter {
    display: inline-block;
    opacity: 0.5;
    color: var(--color-text-secondary);
    transform: scale(1);
    transform-origin: center bottom;
    animation: letterDance 1.8s ease-in-out infinite;
    transition: all 0.3s ease;
    will-change: transform, opacity;
  }

  @keyframes letterDance {
    0% {
      opacity: 0.5;
      transform: scale(1) translateY(0);
      color: var(--color-text-secondary);
    }
    8% {
      opacity: 0.7;
      transform: scale(1.05) translateY(-1px);
      color: var(--color-text-75);
    }
    18% {
      opacity: 1;
      transform: scale(1.25) translateY(-2px);
      color: var(--color-text);
      text-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
    }
    28% {
      opacity: 1;
      transform: scale(1.15) translateY(-1px);
      color: var(--color-text);
      text-shadow: 0 0 6px rgba(255, 255, 255, 0.3);
    }
    38% {
      opacity: 0.9;
      transform: scale(1.05) translateY(0);
      color: var(--color-text-75);
      text-shadow: 0 0 2px rgba(255, 255, 255, 0.1);
    }
    48% {
      opacity: 0.7;
      transform: scale(0.98) translateY(0);
      color: var(--color-text-secondary);
      text-shadow: none;
    }
    58% {
      opacity: 0.6;
      transform: scale(1) translateY(0);
      color: var(--color-text-secondary);
    }
    100% {
      opacity: 0.5;
      transform: scale(1) translateY(0);
      color: var(--color-text-secondary);
    }
  }

  .loader_box_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-control-hover),
      transparent
    );
    animation: shine 2s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 24px !important;
  }

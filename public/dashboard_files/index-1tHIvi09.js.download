`,HowItWorksContent$1=styled$2.div`
  cursor: pointer;
  width: 100%;
  max-width: 600px;

  .questions_wrapper {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .question {
    padding: 10px;
    padding-right: 12px;
    border-radius: 8px;
    background-color: var(--color-account-card-background);
    box-sizing: border-box;
    position: relative;
    width: 100%;
    overflow: hidden;
    will-change: height;
    transition: all 0.2s ease-in-out;
    border: 1px solid transparent;
  }

  .question.open {
    background-color: var(--color-control);
    border: 1px solid var(--color-card-background-3);
  }

  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .wrapper .left_section {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .question_number {
    height: 20px;
    width: 20px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text);
    border: 1px solid var(--color-card-background-3);
    transition: all 0.2s ease-in-out;
  }

  .question_title {
    font-size: 12px;
    line-height: 15px;
    font-weight: 500;
    color: var(--color-text);
  }

  .question_answer {
    font-size: 12px;
    line-height: 20px;
    font-weight: 400;
    max-width: 500px;
    color: var(--color-text-80);
  }

  margin: 0px !important;
  box-sizing: border-box;

  .search_box {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 100;
    background: var(--color-modal-background) !important;
    padding: 6px;
    margin: 0px !important;
    border: none;
    outline: none;
  }

  .search_box div {
    border: none !important;
    outline: none !important;
    margin: 0px !important;
  }

  .scrollable {
    display: flex;
    flex-direction: column;
    gap: 0px;
    width: 100%;
    box-sizing: border-box;
    max-height: calc(88vh - 100px);
    overflow: scroll;
    margin: 0px !important;
    padding: 6px;
  }

  .scrollable div {
    cursor: pointer;
    padding: 4px 0px;
    margin: 0px !important;
    transition: all 100ms ease-out;
    padding: 10px 12px;
    border-radius: 8px;
    display: grid;
  }

  .scrollable div .language_flag {
    width: 16px;
    height: 16px;
    border-radius: 100%;
    min-width: 16px;
    min-height: 16px;
    flex-shrink: 0;
  }

  .scrollable div .language_item {
    font-size: 14px;
    gap: 6px;
    max-width: max-content;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    display: flex;
    align-items: center;
    background: transparent;
  }

  .scrollable div:hover {
    background-color: var(--color-control-hover);
  }

  .scrollable div.selected {
    background-color: var(--color-control-active);
  }

  .scrollable div p {
    font-size: 14px;
    color: var(--color-text);
    white-space: nowrap;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .scrollable {
      padding-bottom: 200px;
    }
  }

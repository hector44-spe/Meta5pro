  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  padding: 24px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;

  .signal_wrapper {
    display: flex;
    gap: 2px;
  }

  .signal_wrapper .signal_bar {
    height: 14px;
    width: 2px;
    cursor: pointer;
    transition: all 300ms ease-in;
  }

  .signal_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.5; /* Adjust this value as needed */
  }

  &:hover {
    background-color: var(--color-box-border) !important;
  }

  .signal_card_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .signal_card_top p:first-of-type {
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    color: var(--color-text);
  }

  .signal_card_top p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  .signal_card_details {
    margin-top: 40px;
    display: grid;
    gap: 12px;
  }

  .signal_card_detail {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }

  .signal_card_detail p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .signal_card_detail p.signal_price {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .signal_card_detail:not(:last-of-type) {
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.05);
  }

  .signal_card_detail .strength_wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .signal_card_detail .strength_wrapper p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .signal_card_detail p.signal_strength {
    color: #01b28b;
  }

  .signal_card_amount {
    margin-top: 32px;
  }

  .signal_card_footer {
    margin-top: 32px;
    width: 100%;
  }

  .signal_card_button {
    margin-top: 32px;
    width: 100%;
    height: 40px;
    border-radius: 6px;
    border: none;
    outline: none;
    cursor: pointer;
    background-color: var(--color-primary);
  }

  .signal_card_button p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

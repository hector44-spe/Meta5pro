rtCardWrapper=styled$2.div`
  padding: 24px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  position: relative;
  display: flex;
  flex-direction: column;
  /* height: 336px; */
  justify-content: space-between;

  &:hover {
    background: var(--color-card-background-2) !important;
  }

  .profile_wrapper {
    display: grid;
    grid-template-columns: 52px auto;
    align-items: center;
    gap: 12px;
  }

  .image_wrapper {
    height: 52px;
    background: var(--color-control);
    width: 52px;
  }

  //   top
  .details_row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: auto;
  }

  .details_row_left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .helper_icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .details_row_left_item {
    display: flex;
    gap: 4px;
  }

  .details_row_left_item p:first-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .details_row_left_item p:last-of-type {
    font-size: 13px;
    line-height: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .details_row_right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .expert_bio {
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-top: 20px;
  }

  .edit_btn {
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 0;
    margin: 0;
    position: absolute;
    top: 24px;
    right: 24px;
  }

  .edit_btn p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  /* mid section */

  .mid_section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 24px;
    /* height: 100%; */
    /* background: red; */
  }

  .mid_section_item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    white-space: nowrap;
  }

  .mid_section_item .label {
    font-size: 13px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: wrap;
  }

  .mid_section_item .value {
    font-size: 14px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .win_rate,
  .losses {
    /* background: blue; */
  }

  .startup,
  .wins {
    /* background: blue; */
    text-align: end;
  }

  .profit_share,
  .trades {
    /* background: blue; */
    align-self: flex-start;
  }

  //   footer

  .footer {
    margin-top: 40px;
    display: flex;
    gap: 12px;
    height: 100%;
  }

  .primary_button {
    margin-top: 32px;
    width: 100%;
    height: 40px;
    border-radius: 6px;
    border: none;
    outline: none;
    cursor: pointer;
    background-color: var(--color-primary);
  }

  .primary_button.disabled {
    background-color: grey;
    user-select: none;
    cursor: not-allowed;
  }

  .primary_button.subscribed {
    background-color: #ff3344;
  }

  .copyexperts_card_button p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  @media screen and (max-width: 768px) {
    .details_row_left_item p:first-of-type {
      font-size: 11px;
      line-height: 12px;
    }

    .details_row_left_item p:last-of-type {
      font-size: 11px;
      line-height: 12px;
    }
  }

  @media screen and (max-width: 350px) {
    .details_row {
      margin-top: 8px;
    }

    .details_row_left {
      gap: 6px;
    }

    .profile_wrapper {
      grid-template-columns: auto;
    }

    /* .details_row_left_item p:first-of-type {
      font-size: 10px;
      line-height: 10px;
    }

    .details_row_left_item p:last-of-type {
      font-size: 10px;
      line-height: 10px;
    } */

    /* .helper_icons {
      display: none;
    } */

    .mid_section_item .label {
      font-size: 11px;
      line-height: 14px;
      font-weight: 500;
      color: var(--color-text-secondary);
    }

    .mid_section_item .value {
      font-size: 11px;
      line-height: 14px;
      font-weight: 600;
      color: var(--color-text);
    }

    .expert_bio {
      font-size: 12px;
    }
  }

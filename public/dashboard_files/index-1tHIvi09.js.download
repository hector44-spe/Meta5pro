`,SidebarContainer=styled$2.div`
  max-height: calc(100vh - 16px);
  height: 100%;
  width: 100%;
  box-sizing: border-box;

  @media screen and (max-width: 768px) {
    & {
      display: none;
    }
  }
`,SidebarWrapper=styled$2.div`
  padding: 32px 16px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background-color: var(--color-sidebar-background);
  border-radius: 12px;
  overflow-y: auto;
 

  /* sidebar effect */
  .sidebar_items:hover > *:not(:hover) {
    opacity: 0.7;
  }

  .user_avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    object-fit: cover;
    background: var(--color-control);
    border: 1px solid var(--color-control-border);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
  }
`,SidebarTop=styled$2.div`
 
    /* mask-image: linear-gradient(to bottom, var(--color-main-background) 70%, transparent 100%);  */


  .logo {
    width: 120px;
  }

  .sidebar_items {
    margin-top: 32px;
    display: grid;
    gap: 3px;
    /* padding-bottom: 80px; */
  }

  .sidebar_item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    padding: 8px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background-color: red; */
  }

  .sidebar_item:hover {
    background-color: var(--color-control-hover);
    padding: 8px 16px;
  }

  .sidebar_item {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
  }

  .sidebar_item.active {
    background-color: var(--color-control-active);
    box-shadow: inset 0 0 0 0.0625rem var(--color-control-border);
    color: var(--color-text);
  }

  .sidebar_item:hover {
    color: var(--color-text);
  }
`,SidebarFooter=styled$2.div`
  padding: 0px 8px;
  margin-top: 32px;

  padding: 24px;
  border-radius: 12px;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  display: flex;
  flex-direction: column;
  gap: 4px;

  .stat_card_wrapper_mobile {
    display: none;
  }

  .stat_card_wrapper_mobile_bottom {
    display: flex;
    gap: 24px;
    margin-top: 24px;
  }

  .stat_card_wrapper_mobile_bottom .item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: flex-start;
  }

  .stat_card_wrapper_mobile_bottom .item p:first-of-type {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .stat_card_wrapper_mobile_bottom .item p:last-of-type {
    font-size: 13px;
    line-height: 20px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .title {
    font-size: 22px;
    line-height: 32px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .value {
    font-size: 15px;
    line-height: 24px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .caption {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  @media screen and (max-width: 768px) {
    &.active,
    &.closed {
      display: none;
    }

    .stat_card_wrapper_mobile {
      display: grid;
    }

    & .stat_card_wrapper_desktop {
      display: none;
    }

    & .stat_card_wrapper_mobile .value {
      color: var(--color-text-50) !important;
    }
  }
`,StakingsContent=styled$2.div`
  background: var(--color-card-background) !important;
  /* padding: 24px 16px; */
  padding: 16px;
  box-sizing: border-box !important;
  overflow: scroll;
  border-radius: 12px;
  height: calc(100vh - 104px);

  .stakings_top {
    /* display: flex;
    flex-direction: column;
    gap: 24px; */
  }

  .stakings_top .desktop {
    display: grid;
    grid-template-columns: auto auto auto;
    align-items: center;
    gap: 16px;
  }

  .stakings_bottom {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (max-width: 1050px) {
    .stakings_top {
      grid-template-columns: auto;
    }
  }

  @media screen and (max-width: 768px) {
    & {
      padding-bottom: 200px;
    }

    .stakings_top .desktop {
      display: grid;
      grid-template-columns: auto;
      align-items: center;
      gap: 16px;
    }
  }

  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  padding: 24px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;

  &:hover {
    background-color: var(--color-box-border) !important;
  }

  .stake_card_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .stake_card_top .stake_card_info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .stake_card_top .stake_card_info img {
    width: 32px;
    height: 32px;
    box-sizing: border-box;
    border-radius: 100%;
  }

  .stake_card_top .stake_card_info span p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text);
    gap: 4px;
  }

  .stake_card_top .stake_card_info span p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  /* .stake_card_top p:first-of-type {
    font-size: 16px;
    line-height: 24px;
    font-weight: 700;
    color: var(--color-primary-text);
  } */

  .stake_card_top p.stake_card_edit_button {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
  }

  .stake_card_details {
    margin-top: 40px;
    /* display: flex; */
    /* justify-content: s; */
    display: grid;
    gap: 12px;
    /* grid-template-columns: repeat(2, auto); */
  }

  .stake_card_detail {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }

  .stake_card_detail {
    /* background-color: rgb(255, 255, 255, 0.025); */
    /* display: grid; */
    /* gap: 12px; */
    /* text-align: center; */
    /* border-radius: 4px; */
    /* padding: 16px; */
    /* text-transform: uppercase !important; */
  }

  .stake_card_detail p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .stake_card_detail:not(:last-of-type) {
    border-bottom: 1px solid hsla(0, 0%, 100%, 0.05);
  }

  .stake_card_detail p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .stake_card_detail p.roi {
    color: #01b28b;
  }

  .stake_card_amount {
    margin-top: 32px;
  }

  .stake_card_footer {
    margin-top: 32px;
    width: 100%;
  }

  .stake_card_button {
    margin-top: 32px;
    width: 100%;
    height: 40px;
    border-radius: 6px;
    border: none;
    outline: none;
    cursor: pointer;
    background-color: var(--color-primary);
  }

  /* .stake_card_button:hover {
    background-color: hsla(0, 0%, 100%, 0.075);
  } */

  .stake_card_button p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

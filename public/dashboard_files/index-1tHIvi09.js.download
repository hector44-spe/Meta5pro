  .user_wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .user_avatar {
    background: var(--color-card-background-50);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    min-height: 40px;
    color: var(--color-primary);
    font-weight: 500;
    font-size: 14px;
  }

  .user_info {
    display: flex;
    flex-flow: column;
    justify-content: center;
  }

  .user_name {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .user_email {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 2px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  /* .icon {
    min-width: 16px;
    min-height: 16px;
  } */

  .form {
    /* margin-top: 24px; */
    display: grid;
    gap: 16px;
  }

  .form_footer {
    margin-top: 24px;
  }

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 2px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  .section_content {
    margin-top: 12px;
    display: grid;
    gap: 16px;
  }

  .section_footer {
    margin-top: 16px;
  }

  /* .section:not(:first-of-type) {
    margin-top: 24px;
  } */

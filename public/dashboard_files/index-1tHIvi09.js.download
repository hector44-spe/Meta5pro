  white-space: nowrap !important;
  width: 100%;

  .manage_switcher_wrapper {
    display: flex;
    gap: 16px;
    /* width: 100%; */
    border-bottom: 1px solid var(--color-outline);
    padding-bottom: 16px;
    /* width: calc(100vw - 350px); */
    max-width: calc(100vw - 350px);
    overflow: scroll;
  }

  .manage_switcher_item {
    font-size: 16px;
    line-height: 20px;
    font-weight: 600;
    color: var(--color-text-secondary);
    position: relative;
    /* border-bottom: 1px solid #31ACEE; */
  }

  .manage_switcher_item * {
    transition: all 200ms ease-in;
  }

  .manage_switcher_item span {
    cursor: pointer;
  }

  .manage_switcher_item span.active {
    color: var(--color-text);
  }

  .manage_switcher_item_underline {
    width: 100%;
    height: 1px;
    position: absolute;
    background-color: var(--color-primary);
    bottom: calc(-100% + 4px);
    left: 0;
    transition: all 150ms ease-out;
  }

  @media screen and (max-width: 1024px) {
    .manage_switcher_wrapper {
      overflow-x: scroll;
      overflow-y: hidden;
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 768px) {
    .manage_switcher_wrapper {
      max-width: calc(100vw - 64px);
    }
  }
`,ManageWrapper=styled$2.div`
  padding: 48px 24px;
  background: var(--color-card-background);
  border-radius: 12px;
  height: calc(100vh - 105px);
  overflow-y: scroll;

  .settings_top {
    width: 100%;
    margin-bottom: 24px;
  }

  .settings_top p:first-of-type {
    font-size: 16px;
    font-family: 24px;
    font-weight: 600;
    color: var(--color-text-tertiary);
  }
`,ManageContent=styled$2.div`
  margin-top: 24px;
  display: grid;
  gap: 64px;
`;styled$2.div`
  display: grid;
  gap: 0px !important;
  height: max-content;

  .settings_item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    padding: 12px;
    border-radius: 6px;
    cursor: pointer;
    max-width: 100%;
    height: max-content;
    margin-top: 0px !important;
    /* max-height: max-conte; */
    transition: all 150ms ease-in-out;
    /* background: red; */
  }

  .settings_item:hover {
    background-color: var(--color-card-background);
    padding: 12px 16px;
  }

  .settings_item p {
    color: #848392;
    /* color: var(--color-text-50); */
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
  }

  .settings_item.active {
    background-color: hsla(0, 0%, 100%, 0.095);
  }

  .settings_item.active img {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .settings_item.active p {
    color: var(--color-text);
  }

  .settings_item:hover img {
    fill: white;
    stroke: white;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  .settings_item:hover p {
    color: var(--color-text);
  }
`;styled$2.div`
  width: 100%;
  /* background: rgba(0, 0, 0, 0.05); */
  border-radius: 6px;
  max-width: 550px;
  /* padding: 16px; */

  .form_wrapper .section:not(:first-of-type) {
    margin-top: 48px;
  }

  .section .section_titles p:first-of-type {
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: 0em;
    text-align: left;
  }

  .section_content {
    display: grid;
    gap: 24px;
    margin-top: 24px;
  }

  .section_content .photo_form {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section_content .photo_form img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
  }

  .section_content .photo_form button {
    background: transparent;
    border: none;
    outline: none;
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
    background-color: var(--color-card-background-50);
  }

  .section_content .photo_form button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .section_content .photo_form button:hover {
    background-color: hsla(0, 0%, 100%, 0.075);
  }

  .section .section_titles p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-50);
    margin-top: 4px;
  }

  /* utils */

  .multi_field {
    display: flex;
    /* flex-direction: column; */
    gap: 12px;
    align-items: center;
  }
`;styled$2.div`
  background: var(--color-card-background);
  border-radius: 12px;
  padding: 16px;
  /* margin-top: 24px; */
  display: grid;
  gap: 18px;

  .card_item {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .card_item img {
    width: 24px;
    height: 24px;
  }

  .card_item p {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    color: var(--color-text-80);
    transition: all 150ms ease-in-out;
  }

  .card_item:hover p {
    color: var(--color-text-50);
  }

  width: 100%;
  height: 100%;

  .top {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 8px;
  }

  .account_section_title {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
  }

  .withdrawals_table {
    overflow: hidden;
    box-sizing: border-box;
    max-height: calc(100vh - 104px);
    border-radius: 12px;
  }

  @media screen and (max-width: 768px) {
    .withdrawals_table {
      max-height: unset;
    }

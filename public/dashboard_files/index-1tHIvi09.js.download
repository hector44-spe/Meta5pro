  .illustration {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    position: relative;
    max-height: 180px;
    overflow: hidden;
  }

  .illustration img {
    position: absolute;
    width: 300px;
    height: 300px;
    left: 50%;
    top: 50%;
    transform: translate(-65%, -50%);
    animation: pulsateGlow 4s ease-in-out infinite;
    animation-delay: 2s;
    z-index: 0 !important;
  }

  .texts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }

  .amount_badge {
    padding: 10px 16px;
    background: linear-gradient(
      -160deg,
      hsla(36, 100%, 60%, 0.2) 30%,
      hsla(36, 90%, 50%, 0.2) 100%
    );
    border-radius: 6px;
    color: #ffaf33 !important;
    position: relative;
    overflow: hidden;
  }

  .amount_badge_shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(100deg, transparent, #ebb86620, transparent);
    animation: shine 4s ease-in-out infinite;
    animation-delay: 0.2s;
    border-radius: 24px !important;
  }

  .amount_badge p {
    font-size: 16px;
    line-height: 18px;
    color: #ffaf33;
    font-weight: 600;
  }

  .texts_content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: center;
    align-items: center;
  }

  .texts_content .title {
    font-size: 16px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-text);
  }

  .texts_content .subtitle {
    font-size: 13px;
    line-height: 18px;
    font-weight: 400;
    color: var(--color-text-secondary);
    max-width: 330px;
  }

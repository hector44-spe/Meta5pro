  margin-top: 12px;

  .wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .wrapper .box {
    background: var(--color-control);
    /* padding: 24px; */
    border: 1px solid var(--color-outline);
    display: flex;
    flex-direction: column;
    padding: 0px;
    cursor: pointer;
    transition: all 300ms ease-in-out;
  }

  .wrapper .box:hover {
    background: var(--color-control-hover);
  }

  /* Grid border styling */
  .wrapper .box:nth-of-type(1) {
    border-top-left-radius: 8px;
  }

  .wrapper .box:nth-of-type(2) {
    border-top-right-radius: 8px;
  }

  .wrapper .box:nth-of-type(5) {
    border-bottom-left-radius: 8px;
  }

  .wrapper .box:nth-of-type(6) {
    border-bottom-right-radius: 8px;
  }

  /* Remove borders between adjacent boxes */

  .wrapper .box:nth-of-type(1) {
    border-right: none;
  }

  .wrapper .box:nth-of-type(3) {
    border-top: none;
  }

  .wrapper .box:nth-of-type(2) {
    /* border-left: none; */
  }

  .wrapper .box:nth-of-type(3) {
    border-right: none;
  }

  .wrapper .box:nth-of-type(4) {
    border-top: none;
  }

  .wrapper .box:nth-of-type(5) {
    border-top: none;
    border-right: none;
  }

  .wrapper .box:nth-of-type(6) {
    border-top: none;
  }

  .top {
    display: flex;
    flex-direction: column;
    align-items: flex-start !important;
    gap: 0px;
    padding: 8px 12px;
  }

  .top p:nth-of-type(1) {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .top p:nth-of-type(2) {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
  }
`,ProjectAboutWrapper=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 20px;
  /* background-color: red; */

  .section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .section.why_this_property,
  .section.why_this_sponsor,
  .section.breakdown {
    margin-top: 28px;
  }

  .section_label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
  }

  .section_content {
    font-size: 13px;
    font-weight: 400;
    line-height: 22px;
    color: var(--color-text-secondary);
  }

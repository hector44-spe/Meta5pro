    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .notification_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .notification_item .delete_btn {
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    border-radius: 4px;
    display: none;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-50);
  }

  .notification_item .delete_btn:hover {
    background: var(--color-card-background-50);
    color: var(--color-primary-text);
  }

  .notification_item:nth-of-type(odd) {
    background: rgba(255, 255, 255, 0.01) !important;
  }

  .notification_item:hover {
    background: rgba(255, 255, 255, 0.055);
  }

  .notification_item:hover .delete_btn {
    display: grid;
  }

  .notification_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notification_item .left .left_info {
    display: grid;
    gap: 8px;
  }

  .notification_item .left .left_info_title {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .notification_item .left .left_info_title .title {
    font-size: 12px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .notification_item .left .left_info_title .label {
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-50);
    font-weight: 500;
  }

  .notification_item .left .left_info_value {
    font-size: 12px;
    font-family: 14px;
    line-height: 16px;
    font-weight: 400;
    color: var(--color-text-50);
  }

  .notification_item .left img {
    width: 32px;

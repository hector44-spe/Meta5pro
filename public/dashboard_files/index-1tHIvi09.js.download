  }

  & .bars .bar:last-of-type {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
  } */

  & .titles .title {
    display: flex;
    align-items: flex-start;
    gap: 4px;
  }

  & .titles .title .icon {
    margin-top: 5px;
  }

  & .titles .title p:nth-of-type(1) {
    font-size: 14px;
    color: var(--color-text-48);
    line-height: 18px;
    font-weight: 600;
  }

  & .titles .title p:nth-of-type(2) {
    font-size: 16px;
    color: var(--color-text);
    line-height: 24px;
    font-weight: 600;
    margin-top: 4px;
  }

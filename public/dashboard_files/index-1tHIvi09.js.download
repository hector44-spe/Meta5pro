`,TradeWrapper$1=styled$2.div`
  /* background: linear-gradient(
    to bottom,
    hsla(0, 0%, 100%, 0.025),
    hsla(0, 0%, 100%, 0.035)
  ); */
  background-color: var(--color-card-background);
  height: 100%;
  border-radius: 12px;
  /* max-width: 600px; */
  /* margin-top: 64px; */
  width: 100%;
  max-width: 500px;
  height: 100%;
  transition: all 0.3s cubic-bezier(0.47, 0, 0.75, 0.72);
  padding: 24px;

  @media screen and (max-width: 1200px) {
    & {
      max-width: unset;
      background: transparent;
    }
  }
`,ChartWrapper=styled$2.div`
  background-color: var(--color-card-background);
  /* background: transparent; */
  /* height: 100%; */
  /* height: 100%; */
  border-radius: 12px;
  width: 100%;
  /* min-height: 400px; */
  /* opacity: 0; */
  /* transition: all 200ms ease-in-out; */
  padding-left: 24px;
  padding-right: 24px;
  padding-top: 24px;
  padding-bottom: 24px;

  .actions {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    display: none;
    padding-inline: 0px;
  }

  .actions_left {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px;
    padding-inline: 12px;
    border-radius: 8px;
    background: hsla(0, 0%, 100%, 0.045);
    min-width: 150px;
    cursor: pointer;
  }

  .actions_left_asset {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .actions_left_asset_icon {
    width: 20px;
    height: 20px;
  }

  .actions_left_asset_titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .actions_left_asset_titles_title {
    font-size: 11px;
    font-weight: 500;
  }

  .actions_left_asset_titles_subtitle {
    font-size: 10px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .actions_right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .actions_right_button {
    background-color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    width: 100%;
    padding-inline: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    place-content: center;
    border-radius: 5px;
    cursor: pointer;
    color: var(--color-white);
    font-size: 13px;
    font-weight: 500;
    transition: all 200ms ease-in-out;
  }

  .actions_right_button_active {
    background-color: var(--color-primary-hover);
    color: var(--color-white);
  }

  .actions_right_button:hover {
    background-color: var(--color-primary-hover);
    color: var(--color-white);
  }

  .actions_right_button_icon {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media screen and (max-width: 1200px) {
    & {
      background: transparent;
      padding-bottom: 0px;
    }

    .actions {
      display: flex;
      margin-bottom: 12px;
      /* padding-inline: 12px; */
      /* margin-bottom: 16px; */
    }
  }
`,ChartContainer=styled$2.div`
  height: 100%;
  /* display: block; */
  will-change: height;
  transition: all 0.1s cubic-bezier(0.47, 0, 0.75, 0.72);

  @media screen and (max-width: 1200px) {
    & {
      height: ${({$showChart:er})=>er?"400px":"0px"};
      /* opacity: ${({$showChart:er})=>er?1:0}; */
      visibility: ${({$showChart:er})=>er?"visible":"hidden"};
    }
  }

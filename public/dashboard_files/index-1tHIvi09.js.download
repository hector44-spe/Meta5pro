  display: flex;
  gap: 16px;
  flex-direction: column;
  position: relative;
`,SwapIndicator=styled$2.button`
  height: 40px;
  width: 40px;
  border-radius: 6px;
  position: absolute;
  background: var(--color-control);
  border: 1px solid var(--color-control-border);
  transform: translateY(-50%);
  backdrop-filter: blur(120px);
  top: 50%;
  left: 50%;
  z-index: 1;
  transform: translate(-50%, -50%);
  cursor: pointer;
  display: grid;
  place-content: center;
  transition: transform 0.2s ease;

  &.switching {
    color: var(--color-text-80);
    transform: translate(-50%, -50%) rotate(180deg);
    border-radius: 100%;
  }

  @media (max-width: 768px) {
    & {
      transform: translate(-50%, -30%);
    }

    &.switching {
      transform: translate(-50%, -30%) rotate(180deg);
    }
  }
`,SwapAssetBoxWrapper=styled$2.div`
  position: relative;
`,SwapAssetBox=styled$2.div`
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: var(--color-control);
  padding: 24px;
  border-radius: 12px;
  width: 100%;
  gap: 8px;
  position: relative;
  border: 1px solid var(--color-card-background-3);

  .row {
    display: flex;
    justify-content: space-between;
    width: 100%;
    align-items: center;
    position: relative;
  }

  .first_row p {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .first_row div {
    overflow: hidden;
  }

  .second_row input {
    font-size: 28px;
    font-weight: 600;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    width: 100%;
    padding: 0px;
  }

  .second_row button {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-control);
    padding: 10px 12px !important;
    border-radius: 120px;
    border: none;
    outline: none;
    border: 1px solid var(--color-control-border);
    color: var(--color-text);
    cursor: pointer;
    margin: 0px !important;
    box-sizing: border-box;
    height: 36px;
    transition: all 80ms ease-out;
  }

  .second_row button:hover {
    background: var(--color-control-hover);
  }

  .asset_box {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .asset_box p {
    font-size: 14px;
    font-weight: 500;
  }

  .third_row.disabled {
    user-select: none;
    pointer-events: none;
    visibility: hidden;
  }

  .third_row p {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-50);
  }

  .flip_row {
    display: none;
  }

  .mobile-quick-flip-buttons {
    display: none;
  }

  .quick-flip-buttons {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .quick-flip-button {
    transform: translateY(-12px) scale(0.8);
    opacity: 0;
    transition: all 100ms ease;
  }

  &:hover {
    .quick-flip-buttons {
      opacity: 1;
    }

    .quick-flip-button:nth-of-type(1) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 0ms;
    }

    .quick-flip-button:nth-of-type(2) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 50ms;
    }

    .quick-flip-button:nth-of-type(3) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 100ms;
    }

    .quick-flip-button:nth-of-type(4) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 150ms;
    }

    .quick-flip-button:nth-of-type(5) {
      transform: translateY(0) scale(1);
      opacity: 1;
      transition-delay: 200ms;
    }
  }

  @media (max-width: 768px) {
    .mobile-quick-flip-buttons {
      display: flex;
    }

    .desktop-quick-flip-buttons {
      display: none;
    }

    .flip_row {
      display: flex;
    }

    .quick-flip-buttons {
      opacity: 1 !important;
    }

    .quick-flip-button {
      transform: translateY(0) scale(1) !important;
      opacity: 1 !important;
      transition-delay: 0ms !important;
    }
  }
`,QuickFlipButtonsWrapper=styled$2.div`
  display: flex;
  gap: 6px;
  position: absolute;
  right: 0px;
  top: -10px;
`,QuickFlipButton=styled$2.button`
  background: var(--color-control);
  padding: 4px 6px;
  border: none;
  outline: none;
  border-radius: 8px;
  color: var(--color-text-secondary);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  /* transition: all 0.2s ease; */

  &:hover:not(:disabled) {
    color: var(--color-text);
    background: var(--color-control-hover);
  }

  &:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    color: var(--color-text-disabled);
  }

  &.active {
    color: var(--color-white);
  }

  &.active p {
    color: var(--color-white) !important;
  }
`,MiniTradeWrapper$2=styled$2.div`

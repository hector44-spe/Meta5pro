  display: flex;
  flex-direction: column;
  padding: 4px;

  .account_switch_dropdown_item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px;
    border-radius: 5px;
    cursor: pointer;
    background: transparent;
    transition: all 150ms ease-in-out;
  }

  .account_switch_dropdown_item:hover {
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .account_switch_dropdown_item_left {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--color-text);
  }

  .account_switch_dropdown_item_left span:first-of-type {
    font-size: 10px;
    font-weight: 500;
    color: var(--color-primary);
  }

  .account_switch_dropdown_item_left span:last-child {
    font-size: 13px;
    font-weight: 600;
  }

  .account_switch_dropdown_item_right {
    display: grid;
    place-content: center;
    background: var(--color-control);
    color: var(--color-text);
    height: 40px;
    width: 40px;
    border-radius: 5px;
  }

  .account_switch_dropdown_item:hover {
    background-color: var(--color-control-hover);
  }

  .account_switch_dropdown_item.selected {
    background-color: var(--color-control);
    color: var(--color-text);
  }

  /* .account_switch_dropdown_item.selected
    .account_switch_dropdown_item_left
    span:first-of-type {
    color: var(--color-primary-text);
  } */

  /* .account_switch_dropdown_item:hover
    .account_switch_dropdown_item_left
    span:first-of-type {
    color: var(--color-primary-text)fff;
  } */

  .account_switch_dropdown_item.selected .account_switch_dropdown_item_right {
    background: var(--color-primary);
    color: var(--color-white);
  }
`,UserDropdownWrapper=styled$2.div`
  position: relative;
`,DemoButton=styled$2.div`
  background: var(--color-control);
  border: 1px dashed var(--color-box-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border-radius: 5px;
  cursor: pointer;
  transition: all 150ms ease-in-out;
  gap: 18px;

  &:hover {
    background-color: var(--color-control-hover);
  }

  /* min-width: 170px; */

  .titles {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .titles .balance {
    font-size: 14px;
    font-weight: 600;
  }

  .titles p:last-child {
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 500;
  }
`,HeaderContainer=styled$2.div`
  position: absolute;
  width: 100%;
  left: 0;
  top: 0;
  z-index: 10;
  padding: 0px 8px;
`,HeaderWrapper=styled$2.div`
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px 16px;
  background: var(--color-card-background);
  border-radius: 12px;
`,HeaderLeftTitles=styled$2.div`
  display: flex;
  gap: 6px;
  align-items: center;

  img {
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  p {
    font-size: 14px;
    font-weight: 500;
    text-transform: capitalize;
    color: var(--color-primary-text);
  }

  @media screen and (max-width: 768px) {
    & {
      display: none;
    }
  }

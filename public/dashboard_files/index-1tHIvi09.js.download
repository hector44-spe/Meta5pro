`,PayWithCard=styled$2.div`
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  color: var(--color-primary);
  transition: all 150ms ease-in;

  &:hover {
    color: var(--color-primary-hover);
  }

  p {
    font-size: 13px;
    font-weight: 500;
    color: inherit;
  }
`,ReviewBox$3=styled$2.div`
  background-color: var(--color-card-background-2);
  padding: 16px;
  border-radius: 8px;

  .bottom {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
    gap: 6px;
  }

  .bottom span {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .label {
    font-size: 12px;
    line-height: 18px;
    color: var(--color-text-secondary);
  }

  .value {
    font-size: 13px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-tertiary);
  }
`,ReferralsTable$1=styled$2.div`
  margin-top: 12px;

  .head,
  .body_row {
    display: grid;
    grid-template-columns: 3fr 1.3fr 1.3fr;
    align-items: center;
    gap: 20px;
  }

  .head {
    font-size: 10px;
    line-height: 14px;
    color: var(--color-text-secondary);
    font-weight: 500;
    padding: 0px 12px;
  }

  .body {
    display: grid;
    gap: 2px;
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text);
    margin-top: 12px;
  }

  .body_row {
    display: grid;
    grid-template-columns: 3fr 1.3fr 1.3fr;
    align-items: center;
    padding: 8px 12px;
    background: var(--color-card-background-2);
    cursor: pointer;
    margin-right: 10px;
    width: 100%;
    margin-bottom: 3px;
    min-height: 25px;
    border-radius: 4px;
    transition: background-color 0.3s;
  }

  .body_row:first-of-type {
    background: var(--color-referral-gradient-one);
  }

  .body_row:nth-of-type(2) {
    background: var(--color-referral-gradient-two);
  }

  .body_row:nth-of-type(3) {
    background: var(--color-referral-gradient-three);
  }

  .referral {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 8px;
  }

  .referral p {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text);
    max-width: 120px;
  }

  .referral img {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    object-fit: cover;
    box-sizing: border-box;
  }

  .date {
    width: 100%;
  }

  .earned {
    width: 100%;
  }
`,AnythingTag=styled$2.div`
  font-size: 10px;
  line-height: 10px;
  font-weight: 500;
  color: var(--color-primary);
  padding: 4px;
  border-radius: 120px;
  width: max-content;
  background: var(--color-primary-light);
  border: 1px solid var(--color-primary);

  &.lg {
    font-size: 12px;
    line-height: 12px;
    padding-inline: 8px;
    text-transform: capitalize;
  }

  &.xl {
    font-size: 16px;
    line-height: 16px;
    padding-inline: 12px;
    text-transform: capitalize;
  }
`,DemoAccountInfo=styled$2.div`
  display: flex;

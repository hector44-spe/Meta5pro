  display: grid;
  gap: 16px;

  .form_footer {
    margin-top: 24px;
  }

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 6px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .section_label {
    /* margin-top: 12px; */
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-primary-text);
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* display: none; */
    /* margin-bottom: 8px !important; */
    /* background-color: red; */
  }

  .toggle {
    display: grid;
    gap: 8px;
  }

  .section_label button {
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    color: var(--color-primary);
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
  }

  .section_content {
    margin-top: 16px;
    display: grid;
    gap: 16px;
  }

  .section_footer {
    margin-top: 16px;
  }

  .section:not(:first-of-type) {
    margin-top: 24px;
  }

  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;

  .download_icon {
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .download_button {
    border: none;
    outline: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-primary);
    height: 20px;
    /* padding: 4px 8px; */
    border-radius: 4px;
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text);
    transition: all 0.2s ease-in-out;
    display: none;
  }

  .download_button:hover {
    background-color: var(--color-primary);
  }

  .document_title_wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .document_number {
    height: 20px;
    width: 20px;
    border-radius: 5px;
    background-color: var(--color-control-active);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text);
    transition: all 0.2s ease-in-out;
  }

  .document_title {
    font-size: 12px;
    line-height: 15px;
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .document {
    padding: 10px;
    padding-right: 12px;
    border-radius: 8px;
    background-color: var(--color-card-background-2);
    box-sizing: border-box;
    position: relative;
    width: 100%;
    overflow: hidden;
    will-change: height;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
  }

  .document:hover .document_number {
    background-color: var(--color-primary);
  }

  .document:hover .document_title {
    color: var(--color-primary-text);
  }

  .document:hover .download_icon {
    display: none;
  }

  .document:hover .download_button {
    display: block;
  }

  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

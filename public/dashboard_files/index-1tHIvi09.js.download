  height: 40px;
  background-color: var(--color-control);
  border-radius: 6px;
`,ExpertTradesWrapper=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 24px;

  .table_body_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.05),
      transparent
    );
    animation: shine 3s ease-in-out infinite;
    animation-delay: 1s;
    border-radius: 24px !important;
  }

  .table_body_wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .table {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .table_header {
    display: flex;
    gap: 4px;
    justify-content: space-between;
    padding: 0px 8px;
  }

  .table_header_item {
    font-size: 11.5px !important;
    font-weight: 500;
    color: var(--color-text-secondary);
    /* width: 120px; */
    /* background: blue; */
    white-space: nowrap;
  }

  .table_body {
    display: flex;
    gap: 4px;
    justify-content: space-between;
    align-items: center;
    padding: 8px;
    background-color: var(--color-card-background);
    border-radius: 6px;
    transition: all 0.3s ease-out;
  }

  .table_body_item {
    /* width: 120px; */
    white-space: nowrap;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-secondary);
    /* background: red; */
  }

  .table_body:nth-of-type(odd) {
    background-color: var(--color-control) !important;
  }

  .date {
    max-width: 22% !important;
    width: 100% !important;
  }

  .asset {
    max-width: 30% !important;
    width: 100% !important;
  }

  .size {
    max-width: 15% !important;
    width: 100% !important;
    /* margin-left: 4px; */
    /* font-weight: 600; */
    /* color: var(--color-text-80); */
  }

  .profit {
    max-width: 18% !important;
    width: 100% !important;
    text-align: right;
    /* color: var(--color-text-80); */
    /* font-weight: 600; */
  }

  .actions {
    max-width: 15% !important;
    width: 100% !important;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .asset {
    display: flex;
    align-items: center;
    gap: 4px;
    /* font-weight: 600; */
    /* color: var(--color-text-80); */
  }

  .table_body_item.asset {
    font-weight: 600 !important;
  }

  .table_body_item.profit,
  .table_body_item.size {
    color: var(--color-text-80);
  }

  .asset img {
    width: 14px;
    height: 14px;
  }

  /* Animation for new trades */
  @keyframes slideInFromTop {
    0% {
      opacity: 0;
      transform: translateY(-20px);
      /* scale(0.95) */
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      /* scale(1) */
    }
  }

  .table_body.new-trade {
    animation: slideInFromTop 0.4s ease-out;
    background: hsla(0, 0%, 100%, 0.05);
    border: 1px solid hsla(0, 0%, 100%, 0.1);
  }

  width: 100%;
  height: 40px;
  border-radius: 6px;
  border: none;
  outline: none;
  background-color: var(--color-control);
  box-shadow: inset 0 0 0 0.0625rem var(--color-control-border);
  cursor: pointer;
  transition: all 150ms ease-in;
  display: flex;
  align-items: center;
  place-content: center;
  gap: 8px;

  &:hover {
    background-color: var(--color-control-hover);
  }

  & p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
    /* font-family: "Chivo Mono", monospace !important; */
    text-transform: uppercase !important;
  }
`,MiningContent=styled$2.div`
  background: var(--color-card-background) !important;
  padding: 16px;
  box-sizing: border-box !important;
  overflow: scroll;
  border-radius: 12px;
  height: calc(100vh - 104px);

  @media screen and (max-width: 768px) {
    & {
      padding-bottom: 200px;
    }
  }

  .mining_top {
    /* display: flex;
    flex-direction: column;
    gap: 24px; */
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 8px;
  }

  .mining_bottom {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (max-width: 1050px) {
    .mining_top {
      grid-template-columns: auto;
    }
  }
`,MiningTotalCard=styled$2.div`
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24px;
  background-color: var(--color-card-background-2);
  border: 1px solid var(--color-card-background-3);
  border-radius: 12px;
  gap: 32px;
  min-height: 154px;

  p {
    font-size: 13px;
    color: var(--color-text-50);
    /* color: var(--color-primary); */
    line-height: 18px;
    font-weight: 400;
    /* font-family: "Chivo Mono", monospace !important; */
    text-transform: uppercase;
  }

  p.summary {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    margin-top: 6px;
    color: var(--color-text-75);
  }

  .user_balance {
    font-size: 24px !important;
    font-weight: 500 !important;
    color: var(--color-primary-text);
    line-height: 32px;
    margin-top: 4px;
    font-feature-settings: "tnum" !important;
    /* font-family: "Chivo Mono", monospace !important; */
  }

  .footer {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 12px;
  }

  .button {
    border: none;
    outline: none;
    padding: 10px 16px !important;
    border-radius: 120px;
    cursor: pointer;
    background-color: var(--color-card-background-50);
    transition: all 150ms ease-in;
    height: fit-content !important;
    display: flex;
    align-items: center;
    place-content: center;
    gap: 8px;
    max-height: max-content;
    width: 100%;
  }

  .button.primary {
    background-color: var(--color-primary) !important;
  }

  .button:hover {
    background-color: hsla(0, 0%, 100%, 0.075);
  }

  .button p {
    font-size: 14px !important;
    line-height: 18px !important;
    font-weight: 600;
    color: var(--color-primary-text);
  }
`,MiningInfoCard=styled$2.div`
  width: 100%;
  height: 100%;

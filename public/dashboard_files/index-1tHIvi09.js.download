    flex-direction: column;
  }

  .payment_option_select_option {
    margin: 0px;
    padding: 0px;
    outline: none;
    border: none;
    padding: 12px 10px;
    border-radius: 8px;
    background-color: var(--color-control);
    color: var(--color-text-secondary);
    width: 100%;
    font-size: 14px;
    /* font-weight: 600; */
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease-in-out;
    text-align: left;
    box-sizing: border-box;
    line-height: 14px;
  }

  .payment_option_select_option.selected {
    /* font-weight: 600; */
    color: var(--color-text);
    border: 1px solid var(--color-primary);
    background-color: var(--color-control-hover);
  }

  .payment_option_select_option.buy_crypto {
    padding: unset;
    box-sizing: border-box;
  }

  .payment_option_select_option:hover {
    border: 1px solid var(--color-primary);
  }

  width: 100%;
  height: 100%;
  padding: 8px;
  /* padding-bottom: 40px; */
  border: 1px solid var(--color-input-border);
  background: var(--color-input-hover);
  border-radius: 12px;

  ${er=>er.$isActionInProgress&&`
    pointer-events: none;
  `}

  .actions_wrapper {
    display: grid;
  }

  .actions_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.6;
    border-color: transparent !important;
  }

  .actions_wrapper:has(.action_performed) .action:not(.action_performed) {
    opacity: 0.6;
    border-color: transparent !important;
  }

  .actions_wrapper span.action_performed {
    opacity: 1;
    background-color: var(--color-control-hover);
    border-color: transparent !important;
  }

  .actions_wrapper .action {
    font-size: 14px;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
    transition: all 150ms ease-in-out;
    padding: 10px 12px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 6px;
  }

  .actions_wrapper .action .action_icon {
    font-size: 14px;
    font-family: 16px;
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: all 150ms ease-in-out;
    /* display: none; */
  }

  .actions_wrapper .action:not(:last-of-type) {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-outline);
  }

  .actions_wrapper .action:hover {
    background-color: var(--color-control-hover);
    border-color: transparent;
  }

  .actions_wrapper .action:hover .action_icon {
    color: var(--color-text);
  }

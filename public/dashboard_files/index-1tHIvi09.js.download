2.div`
  margin: 0px !important;
  box-sizing: border-box;

  .search_box {
    position: sticky;
    top: 0;
    left: 0;
    z-index: 100;
    /* background: var(--color-control); */
    padding: 6px;
    margin: 0px !important;
    border: none;
    outline: none;
  }

  .search_box div {
    border: none !important;
    outline: none !important;
    margin: 0px !important;
  }

  .scrollable {
    display: flex;
    flex-direction: column;
    gap: 0px;
    width: 100%;
    box-sizing: border-box;
    max-height: calc(88vh - 100px);
    overflow: scroll;
    margin: 0px !important;
    padding: 6px;
    /* margin-top: 8px !important; */
    /* padding: 8px; */
  }

  .scrollable div {
    cursor: pointer;
    padding: 4px 0px;
    margin: 0px !important;
    transition: all 100ms ease-out;
    padding: 10px 12px;
    border-radius: 8px;
    display: grid;
  }

  .scrollable div .asset_item {
    font-size: 14px;
    gap: 6px;
    max-width: max-content;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    display: flex;
    align-items: center;
    background: transparent;
  }

  .asset_icon {
    width: 16px;
    height: 16px;
  }

  .scrollable div .asset_item_right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .scrollable div .asset_item_right p:first-of-type {
    font-size: 14px;
    color: var(--color-text);
    white-space: nowrap;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
  }

  .scrollable div .asset_item_right p:last-of-type {
    font-size: 14px;
    white-space: nowrap;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 600;
  }

  .scrollable div:hover {
    background-color: var(--color-control-hover);
  }

  .scrollable div.selected {
    background-color: var(--color-control-hover);
  }

  .scrollable div p {
    font-size: 14px;
    color: var(--color-text);
    white-space: nowrap;
    color: var(--color-text);
    line-height: 18px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .scrollable {
      /* padding-bottom: 200px; */
      padding-bottom: 30px;
    }
  }
`,AmountBoxPrimary=styled$2.div`
  width: 100%;

  label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  label.divide {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  label button {
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    color: var(--color-primary);
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
  }

  .amountbox_wrapper {
    background: var(--color-input);
    border: 1px solid var(--color-input-border);
    border-radius: 8px;
    padding: 4px 8px;
    margin-top: 6px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* height: 42px; */
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    padding-right: 4px;
    cursor: pointer;
    transition: all 150ms ease-out;
    height: 42px;
  }

  .amountbox_wrapper.no_margin {
    margin-top: 0px !important;
  }

  &.error .amountbox_wrapper {
    border: 1px solid #ff3344 !important;
    animation: shake 0.82s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    perspective: 1000px;
  }

  .amountbox_wrapper:hover {
    background: var(--color-input-hover);
    border: 1px solid var(--color-box-border);
  }

  .amount_select,
  .amount_select_wrapper {
    outline: none;
    border: none;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
    background: var(--color-control);
    border: 1px solid var(--color-control-border);
    padding: 6px;
    cursor: pointer;
    box-sizing: border-box;
    transition: background 150ms ease-out;
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
    height: 100%;
  }

  .amount_select_wrapper {
    position: relative;
    min-width: 65px;
    padding: 0px;
  }

  .amount_select_wrapper select {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 14px;
    line-height: 14px;
    font-weight: 600;
    width: 100%;
    appearance: none;
    cursor: pointer;
    background: transparent;
    height: 100%;
    width: 100%;
    padding-left: 6px;
  }

  .amount_select_wrapper svg {
    position: absolute;
    right: 6px;
  }

  .amount_select .icon_divider {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .amount_select:hover {
    background: var(--color-control-hover);
    border: 1px solid var(--color-control-border);
  }

  .amount_select p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .svg_icon {
    width: 8px;
    height: 6px;
  }

  .amount_select img {
    width: 16px;
    height: 16px;
  }

  input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 16px;
    line-height: 18px;
    font-weight: 600;
    width: 100%;
  }

  input::placeholder {
    color: var(--color-text-50);
    font-size: 16px;
    line-height: 18px;
    font-weight: 600;
  }

  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .captions {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }

  .caption {
    font-size: 12px;
    line-height: 15px;
    color: var(--color-text-75);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
  }

  .caption.error {
    color: #ff3344;
    margin-bottom: 12px;
  }

  .caption_value {
    font-weight: 600;
    color: var(--color-primary-text);
  }

  @keyframes shake {
    10%,
    90% {
      transform: translate3d(-1px, 0, 0);
    }

    20%,
    80% {
      transform: translate3d(2px, 0, 0);
    }

    30%,
    50%,
    70% {
      transform: translate3d(-4px, 0, 0);
    }

    40%,
    60% {
      transform: translate3d(4px, 0, 0);
    }
  }

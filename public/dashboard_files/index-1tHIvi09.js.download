  display: flex;
  align-items: center;
  padding: 12px 10px;
  border-radius: 8px;
  background-color: var(--color-control);
  box-sizing: border-box;
  position: relative;
  width: 100%;
  overflow: hidden;

  .bank_transfer_container {
    width: 100%;
    /* height: 32px; */
  }

  .bank_transfer_container_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      hsla(0, 0%, 100%, 0.05),
      transparent
    );
    animation: shine 2s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 24px !important;
  }

  .bank_transfer_details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .bank_transfer_detail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    /* background-color: red; */
  }

  .bank_transfer_detail_label {
    font-size: 13px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .bank_transfer_detail_value {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    line-height: 14px;
  }

  .bank_transfer_detail_value p {
    font-size: 13px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-text);
    overflow-x: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 120px;
  }

  .bank_transfer_detail_copy_icon {
    cursor: pointer;
    flex-shrink: 0;
  }

  .bank_transfer_detail_copy_icon:hover {
    opacity: 0.8;
  }
  /* .address_text {
    color: var(--color-text);
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    white-space: wrap;
    word-break: break-all;
  } */

  .buttons_container {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    position: absolute;
    right: 10px;
    z-index: 999;
  }

  .buttons_container button,
  .buttons_container .skeleton_button {
    background-color: var(--color-card-background-50);
    border: none;
    border-radius: 5px;
    padding: 8px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    display: grid;
    place-content: center;
    z-index: 999;
  }
`,BuyCryptoInstructions=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 4px;
  cursor: pointer;
  width: 100%;

  .instruction {
    padding: 10px;
    padding-right: 12px;
    border-radius: 8px;
    background-color: var(--color-control);
    box-sizing: border-box;
    position: relative;
    width: 100%;
    overflow: hidden;
    will-change: height;
    transition: all 0.2s ease-in-out;
  }

  .instruction.open {
    background-color: var(--color-control-hover);
  }

  .wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

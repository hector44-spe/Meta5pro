  .form {
    display: grid;
    gap: 16px;
  }

  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px;
  }

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 6px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
  }

  .levels_list {
    margin-top: 16px;
    display: grid;
    gap: 12px;
  }

  .level_item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: var(--color-card-background);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .level_info {
    flex: 1;
  }

  .level_header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .level_icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .level_icon img {
    width: 24px;
    height: 24px;
    filter: brightness(0) invert(1);
  }

  .level_details h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .level_details p {
    font-size: 12px;
    color: var(--color-text-secondary);
    margin: 2px 0 0 0;
  }

  .level_benefits {
    display: grid;
    gap: 4px;
  }

  .benefit {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
  }

  .benefit span:first-child {
    color: var(--color-text-secondary);
  }

  .benefit span:last-child {
    color: var(--color-text);
    font-weight: 500;
  }

  .edit_button {
    background: var(--color-primary);
    border: none;
    border-radius: 6px;
    padding: 8px;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .edit_button:hover {
    background: var(--color-primary-hover);
  }

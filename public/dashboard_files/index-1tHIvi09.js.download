`;styled$2.button``;styled$2.button``;styled$2.button``;const FileUploadPrimary$1=styled$2.button`
  width: 100%;
  background: none;
  border: none;
  outline: none;
  cursor: pointer;
  text-align: left;
  padding: 0 !important;
  margin: 0 !important;

  label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .file_upload_wrapper {
    background: var(--color-input);
    border-radius: 8px;
    padding: 4px 8px;
    margin-top: 6px;
    border: 1px dashed var(--color-input-border);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    padding-right: 4px;
    cursor: pointer;
    transition: border 150ms ease-out;
    height: 42px;
    position: relative;
  }

  .file_upload_wrapper .progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    /* width: 30%; */
    background: var(--color-input);
    border-radius: 8px;
    z-index: 1;
    transition: width 300ms ease-in;
  }

  .file_upload_wrapper .upload_wrapper {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .file_upload_wrapper .upload_wrapper img {
    width: 24px;
    height: 24px;
    background: var(--color-input);
    border-radius: 4px;
    padding: 2px;
    opacity: 0.5;
    transition: all 150ms ease-out;
  }

  .file_upload_wrapper .upload_wrapper .icon {
    color: var(--color-primary);
    border-radius: 4px;
    padding: 2px;
    opacity: 0.5;
    transition: all 150ms ease-out;
  }

  .file_upload_wrapper .upload_wrapper p {
    font-size: 14px;
    line-height: 18px;
    color: var(--color-text-80);
  }

  .file_upload_wrapper .upload_wrapper p strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .file_upload_wrapper .right {
    font-size: 13px;
    line-height: 15px;
    color: var(--color-text-80);
    font-weight: 600;
    margin-right: 4px;
  }

  .file_upload_wrapper .right {
  }

  .file_upload_wrapper:hover {
    border: 1px dashed var(--color-input-hover);
  }

  .file_upload_wrapper:hover .upload_wrapper img {
    opacity: 1;
  }

  .file_upload_wrapper:hover .upload_wrapper .icon {
    opacity: 1;
    color: var(--color-primary);
  }

  &.disabled {
    pointer-events: none;
    user-select: none;
    cursor: not-allowed;
    opacity: 0.5;
  }

  &.error {
    .file_upload_wrapper {
      border: 1px dashed #ff3344;
    }
  }

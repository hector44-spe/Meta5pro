  .history_content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .content_wrapper {
    /* max-height: 70%; */
    overflow: scroll;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 88px;
    gap: 6px;
    box-sizing: border-box;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 32px;
    place-self: center;
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .history_item {
    border-radius: 8px;
    padding: 12px;
    cursor: pointer;
    transition: all 150ms ease-in-out;
    /* background: orange; */
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    max-height: max-content;
  }

  .history_item:nth-of-type(odd) {
    background: rgba(255, 255, 255, 0.01) !important;
  }

  .history_item:hover {
    background: rgba(255, 255, 255, 0.055);
  }

  .history_item .left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .history_item .left .left_info_title {
    font-size: 12px;
    font-family: 14px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .history_item .left .left_info_title .label {
    margin-left: 10px;
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 3px 8px;
    background: #ffb70026;
    border-radius: 10px;
    font-size: 12px;
    line-height: 12px;
    color: #ffb700;
  }

  .history_item .left .left_info_value {
    font-size: 13px;
    line-height: 16px;
    font-weight: 600;
    color: var(--color-primary-text);
  }

  .history_item .left img {
    width: 32px;
    height: 32px;
  }

  .history_item .right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .history_item .right .right_info {
    display: flex;
    font-size: 12px;
    line-height: 14px;
    gap: 4px;
    text-align: right;
    align-self: flex-end;
  }

  .history_item .right .right_info p.title {
    font-weight: 500;
    color: var(--color-text-50);
  }

  .history_item .right .right_info p.value {
    font-weight: 600;
    color: var(--color-primary-text);
  }

  /* top */
  .history_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history_top .history_top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-primary-text) fff;
  }

  .history_top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .history_top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  &.open {
    transform: translateX(0);
    opacity: 1;
  }

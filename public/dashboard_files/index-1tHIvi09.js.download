  /* margin-top: 40px; */

  label {
    font-size: 12px;
    line-height: 12px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .levels_wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }

  .level {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    padding: 13px 10px;
    border-radius: 8px;
    background-color: var(--color-control);
    border: 1px solid var(--color-card-background-3);
    cursor: pointer;
    transition: all 0.3s ease-in-out;
  }

  .level_bottom {
    display: none;
  }

  .level.active .level_bottom {
    display: flex;
  }

  .level:hover {
    background-color: var(--color-control-hover);
  }

  .level.active {
    background-color: var(--color-control-hover);
    border: 1px solid var(--color-primary);
  }

  .level .level_top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .level.active .level_top {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-outline);
  }

  .level_top_left {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .level_top_right {
    font-size: 13px;
    line-height: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .level_top_left p {
    font-size: 14px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .level.active .level_top_left p {
    color: var(--color-text);
  }

  .level_top_left_icon {
    width: 16px;
    height: 16px;
  }

  .level_top_left_tag {
    font-size: 10px;
    line-height: 10px;
    font-weight: 600;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 4px;
    border-radius: 120px;
    width: max-content;
  }

  .level_bottom .bottom_content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .level_bottom .bottom_content p:first-of-type {
    font-size: 12px;
    line-height: 12px;
    font-weight: 400;
    color: var(--color-text);
  }

  .level_bottom .bottom_content p:last-child {
    font-size: 13px;
    line-height: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  max-width: max-content;
  overflow: hidden;
  transition: all 150ms ease-in;
  /* height: 100%; */

  .previews_wrapper {
    display: flex;
    list-style: none;
    /* height: 200px; */
    padding: 24px 0px;
    overflow-x: scroll;
    flex: 0 0 600px;
    margin: 0 auto;
    scroll-behavior: smooth;
    max-width: 100%;
    overflow-x: scroll;
    display: flex;
    overflow-y: hidden;
  }

  .previews_wrapper .billing_preview {
    flex: 0 0 100px;
    background: var(--accent);
    margin: 0 20px 0 0;
  }

  .previews_wrapper .billing_preview:last-of-type {
    margin: 0;
  }

  .previews_wrapper .billing_preview {
    position: relative;
    white-space: nowrap;
    display: grid;
    align-items: center;
    justify-items: center;
    cursor: pointer;
  }

  .previews_wrapper .billing_preview img {
    border-radius: 12px;
    aspect-ratio: 4.135/ 5.845;
    width: 100%;
    padding: 4px;
    border: 1px solid transparent;
    transition: border-color 0.3s ease-in-out;
  }

  .billing_preview.selected img {
    border: 1px solid var(--color-primary);
  }

  .billing_preview span {
    font-size: 12px;
    line-height: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-top: 6px;
    text-transform: capitalize;
  }

  .billing_preview.selected span {
    color: var(--color-primary-text);
  }

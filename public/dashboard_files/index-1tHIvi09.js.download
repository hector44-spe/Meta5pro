`;const LeverageWrapper=styled$2.div`
  display: flex;
  flex-direction: column;
  gap: 8px;

  label {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .leverage_buttons {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 1fr;
    gap: 8px;
  }

  .leverage_buttons .input_wrapper {
    width: 100%;
    position: relative;
    overflow-x: scroll;
  }

  .fake-input {
    /* position: relative; */
  }

  .fake-input::after {
    content: "abc";
    background-color: var(--color-primary-text) fff;
    /* position: absolute;
    top: 3px; */
    right: 0;
    height: 10px;
    width: 1px;
    animation: blink 1s step-end infinite;
    /* z-index: 100; // Added z-index */
  }

  @keyframes blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;

  padding: 0px;
  border-radius: 12px;
  cursor: pointer;
  transition: all 150ms ease-in;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);

  .realestate_card_image_skeleton {
    width: 100%;
    height: 100%;
    background-color: var(--color-card-background);
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
  }

  .realestate_card_shine {
    /* display: none; */
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      hsla(0, 0%, 100%, 0.025),
      transparent
    );
    animation: shine 1.5s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 12px !important;
  }

  &:hover {
    background-color: var(--color-box-border) !important;
  }

  .project_wrapper {
    padding: 16px;
  }

  .project_image_wrapper {
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
    height: 200px;
  }

  .project_image {
    max-height: 200px;
    width: 100%;
    border-radius: 12px;
    border-bottom-left-radius: 0px !important;
    border-bottom-right-radius: 0px !important;
  }

  .project_image.closed {
    filter: grayscale(100%);
  }

  .project_details {
    /* background: orange; */
    /* margin-top: 16px; */
    height: 88px;
  }

  .project_details .project_title {
    font-size: 15px;
    line-height: 18px;
    color: var(--color-primary-text);
    font-weight: 600;
  }

  .project_details .project_description {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 20px;
    font-weight: 400;
    margin-top: 6px;
  }

  .project_details .project_description .see_more_button {
    background: none;
    border: none;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
    margin-top: 4px;
    text-decoration: underline;
  }

  .project_details .project_description .see_more_button:hover {
    color: #1a8bc7;
  }

  .project_summary {
    display: flex;
    /* gap: 24px; */
    margin-top: 28px;
    /* padding: 0px 16px; */
    justify-content: space-between;
  }

  .project_summary span.strategy {
    text-align: right;
  }

  .project_summary span p:first-of-type {
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .project_summary span p:last-of-type {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-text);
    margin-top: 2px;
  }

  .project_actions {
    margin-top: 40px;
    display: flex;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    gap: 12px;
  }

  @media screen and (max-width: 768px) {
    .project_summary {
      margin-top: 40px;
    }
  }
`,FAKE_PROJECTS={teslaBuild:{ref:"teslaBuild",closedByDefault:!0,title:"Tesla Build-to-Suit Orlando ",description:" Development of a custom-built dealership and service center for Tesla, a Fortune 100 company with $850B market cap Class A self-storage development in one of Nashville's fastest growing suburbs with constrained supply and a high barrier to entry.",minimum:18733,roi:40,thumbnail:"https://prod-thumbnails.investorportal.pictures/property-images/Screenshot_2023-06-12_at_8.50.52_AM-1686690588984-1686690629923.png ",strategy:"Fixed income"},noviAtConcord:{ref:"noviAtConcord",closedByDefault:!0,title:"Novi at Concord - Preferred Equity",description:"Three luxury apartment buildings in advanced stages of development in downtown Concord, N.C., a fast-growing Charlotte suburb attracting billions in corporate investment.",minimum:17500,roi:53,thumbnail:"https://prod-thumbnails.investorportal.pictures/property-images/1_-_Novi_Flats_Renderings_090822_Page_3-1685557124713-1685557306684.png",strategy:"Value-add"},nashville:{ref:"nashville",closedByDefault:!1,status:"open",title:"Go Store It Nashville",description:"Class A self-storage development in one of Nashville's fastest growing suburbs with constrained supply and a high barrier to entry.",thumbnail:"https://prod-thumbnails.investorportal.pictures/property-images/Screenshot_2023-06-28_at_12.43.42_PM-1687981437202-1687981462106.png",overview:"Go Store It Nashville is a ground-up, self-storage development opportunity presented by Madison Capital Group. The Project is located in Franklin, TN, a rapidly expanding submarket (five-year population growth projection of 9%) located approximately 25 miles south of Nashville. When complete, the Class A property will include 1,286 climate-controlled units and be managed by Go Store It, a wholly-owned subsidiary of Madison Capital. ",images:["https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_12.33.57_PM-1687981070914-1687981283508.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_12.34.48_PM-1687981076901-1687981283579.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_12.35.24_PM-1687981082725-1687981283635.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_12.35.56_PM-1687981088549-1687981283734.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_1.25.50_PM-1687983999320-1687984054876.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/Screenshot_2023-06-28_at_1.26.05_PM-1687984003406-1687984054992.png"],breakdown:[{name:"Type",value:"Self storage"},{name:"Acres",value:"3.02"},{name:"Strategy",value:"Fixed income"},{name:"Objective",value:"Value-add"}],whyThisProperty:["We believe this deal could be well-positioned to capitalize on the significant population growth in Franklin, TN, as one of the first-to-market self-storage assets in the burgeoning submarket.","Franklin’s multifamily inventory has more than doubled since 2010, a strong potential indication of new, unmet self-storage demand in the submarket.","Only one competitor exists within a 3-mile radius, currently in lease-up, with a rigorous process to secure approvals from the city creating a higher barrier to entry."],whyThisSponsor:["Madison’s in-house management company, Go Store It, with nearly 100 self-storage facilities across the U.S., has deep industry and market knowledge to draw upon to potentially drive revenue and operational efficiency, in our view.","Using their in-house general contractor also generally enables Madison to have more control over timelines and costs.","Madison’s co-investment of 25% is significant compared to the average sponsor’s contribution on the Marketplace and reflects their conviction in the deal."],video_link:"https://player.vimeo.com/video/857343635?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479",roi:75,minimum:15e3,strategy:"Fixed income",documents:[{title:"Investment Deck",link:"./projects/nashville/investment-deck.pdf"},{title:"Floor Plans",link:"./projects/nashville/floor-plans.pdf"},{title:"Organizational Chart",link:"./projects/nashville/organizational-chart.pdf"},{title:"Sponsor Track Record",link:"./projects/nashville/sponsor-track-record.pdf"}]},palmetto:{ref:"palmetto",closedByDefault:!1,status:"open",title:"Palmetto Industrial Park",description:"Acquisition of a newly constructed three-building industrial property, already garnering interest from prospective tenants.",thumbnail:"https://prod-thumbnails.investorportal.pictures/property-images/Screenshot_2023-07-13_at_8.53.17_AM-1689252808543-1689252843333.png",overview:"Palmetto Industrial Park is a newly constructed, three-building industrial property located in Palmetto, FL, approximately 45 miles south of Tampa. Having executed the purchase and sale agreement back in Q2 2022, the Sponsor, Stonemont Financial Group, will acquire the Property upon completion, which is expected to be in Q3 2023. Upon closing, the Sponsor intends to lease up the buildings, which are divisible down to 40,000 SF units to appeal to mid-sized, logistic-focused users in the low vacancy submarket (1.9%), and exit the Project at the end of the 2-year targeted hold period.",images:["https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/1_-_Stonemont_Palmetto_7_2x-1689276658359-1689276806738.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/2_-_Stonemont_Palmetto_1_2x-1689276692591-1689276806828.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/3_-_Stonemont_Palmetto_5_2x-1689276711258-1689276806937.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/4_-_Stonemont_Palmetto_3_2x-1689265375044-1689265457104.png","https://prod-thumbnails.investorportal.pictures/custom/1170/400/property-images/5_-_Stonemont_Palmetto_6_2x-1689276774949-1689276807119.png"],breakdown:[{name:"Type",value:"Industrial"},{name:"Acres",value:"~38"},{name:"Strategy",value:"Fixed income"},{name:"Objective",value:"High growth"}],whyThisProperty:["We view the acquisition timing of this Project at the completion of construction as potentially advantageous in reducing the uncertainty typically found with labor and material costs for most development deals.","We believe the constrained industrial market and submarket, both currently below 2% vacancy, are a potentially strong indicator of the demand for newly built space.","The Sponsor is already seeing a positive response with pre-leasing efforts, including several requests for proposals (RFPs) in-hand from prospective tenants and even owner/user purchase interest, seeming to support the demand assumptions of the business plan."],whyThisSponsor:["Stonemont Financial Group’s extensive industrial acquisition and development experience (38.7M BSF) makes them well-equipped to execute the intended business plan, in our view.","Stonemont focuses on key industrial markets with supply-demand dislocations, and we believe the high-demand Tampa Bay market fits that strategy well.","Stonemont has been actively involved in the Project throughout the entire development, helping ensure they are in a strong position to execute the lease-up strategy with strong product and a flexible design."],video_link:"https://player.vimeo.com/video/857343789?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479",roi:78.8,minimum:25e3,strategy:"Fixed income",documents:[{title:"Webinar Deck",link:"./projects/palmetto/investment-deck.pdf"},{title:"Demographics",link:"./projects/palmetto/demographics.pdf"},{title:"Organizational Chart",link:"./projects/palmetto/organizational-chart.pdf"},{title:"Sponsor Track Record",link:"./projects/palmetto/sponsor-track-record.pdf"}]}},REAL_EST
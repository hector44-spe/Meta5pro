  background: var(--color-card-background) !important;
  padding: 24px 16px;
  box-sizing: border-box !important;
  overflow: scroll;
  border-radius: 12px;
  height: calc(100vh - 104px);

  @media screen and (max-width: 768px) {
    & {
      padding-bottom: 200px;
    }
  }

  .subscription_top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .subscription_bottom {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .subscription_current {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 18px;
    font-weight: 500;
  }

  .subscription_current strong {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;

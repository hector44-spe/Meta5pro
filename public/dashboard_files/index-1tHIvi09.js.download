    animation-delay: 0.5s;
    border-radius: 24px !important;
  }
`,IconBox=styled$2.div`
  display: flex;
  align-items: center;
  border-radius: 8px;
  background-color: var(--color-control);
  box-sizing: border-box;
  position: relative;
  width: 100%;
  overflow: hidden;
  height: 42px;
  margin-top: 8px;

  .icon_container {
    width: 100%;
    height: 100%;
  }

  .icon_container_shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-control-hover),
      transparent
    );
    animation: shine 2s ease-in-out infinite;
    animation-delay: 0.5s;
    border-radius: 24px !important;
  }

  @keyframes shine {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }
`,NotificationsWrapper$2=styled$2.div`
  position: fixed;
  top: 0;
  right: 0;
  min-height: 100vh;
  height: 100%;
  z-index: 99999;
  transform: ${({isOpen:er})=>er?"translateX(0)":"translateX(100%)"};
  padding: 16px;
  padding-top: 24px;
  opacity: ${({isOpen:er})=>er?1:.75};
  max-width: 400px;
  width: 100%;
  transition: all 300ms ease-in-out;
  background: var(--color-modal-background) !important;
  backdrop-filter: blur(200px) !important;

  .content {
    width: 100%;
    height: 100%;
    margin-top: 24px;
  }

  .empty_state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
    height: 100%;
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .empty_state .svg-icon {
    width: 40px;
    height: 40px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top .top_title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text);
  }

  .top button {
    background: transparent;
    border: none;
    cursor: pointer;
    display: grid;
    place-content: center;
    width: 24px;
    height: 24px;
  }

  .top button:hover {
    background: var(--color-card-background-50);
    border-radius: 4px;
    filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
      brightness(200%) contrast(100%);
  }

  /* &.open {
    transform: translateX(0);
    opacity: 1;
  } */

  @media (max-width: 768px) {
    max-width: unset;
    width: 100vw;
    background-color: var(--color-modal-background) !important;
  }
`,NotificationsContent$1=styled$2.div`
  width: 100%;
  height: 100%;
  margin-top: 24px;
  position: relative;
  height: calc(100% - 40px);
  padding-inline: 8px;
  padding-bottom: 200px;

  .section_titles .title {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  .section_titles .subtitle {
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    margin-top: 6px;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .section_label {
    /* margin-top: 12px; */
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
    color: var(--color-text);

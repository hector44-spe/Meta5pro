  display: grid;
  gap: 24px;

  .tracking_editing {
    display: grid;
    gap: 20px;
    border-radius: 12px;
  }

  .creation_note {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 20px;
  }

  .form_section {
    display: grid;
    gap: 16px;
  }

  .form_row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .input_field {
    display: grid;
    gap: 8px;
  }

  .input_field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
  }

  .input_field input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--color-card-background-3);
    border-radius: 8px;
    background: var(--color-card-background);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .input_field input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(49, 172, 238, 0.1);
  }

  .input_field input::placeholder {
    color: var(--color-text-secondary);
  }

  .add_tracking_btn {
    padding: 8px 16px;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .add_tracking_btn:hover:not(:disabled) {
    background: var(--color-primary-hover);
  }

  .add_tracking_btn:disabled {
    background: var(--color-text-secondary);
    cursor: not-allowed;
  }

  .tracking_list {
    display: grid;
    gap: 12px;
  }

  .tracking_list h5 {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .tracking_item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--color-card-background-2);
    border-radius: 6px;
    border: 1px solid var(--color-card-background-3);
  }

  .tracking_info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tracking_date {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text);
  }

  .tracking_status {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
  }

  .remove_tracking_btn {
    padding: 4px 8px;
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-card-background-3);
    border-radius: 4px;
    font-size: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .remove_tracking_btn:hover {
    background: var(--color-card-background-3);
    color: var(--color-text);
  }

  .action_buttons {
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
  }

  .no_tracking {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-text-secondary);
    padding: 20px;
    text-align: center;
    justify-content: center;

    span {
      font-size: 14px;
      line-height: 20px;
      color: var(--color-text-secondary);
    }
  }

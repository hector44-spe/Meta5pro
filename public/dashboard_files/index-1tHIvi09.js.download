  align-items: center;
  /* justify-content: space-between; */
  /* flex-direction: column; */
  padding: 24px;
  gap: 40px;
  /* padding-bottom: 40px; */
  background-color: var(--color-card-background-2);
  border: 1px solid var(--color-card-background-3);
  border-radius: 12px;

  .info {
    display: flex;
    flex-direction: column;
    gap: 0px;
  }

  .info p:first-of-type {
    font-size: 13px;
    color: var(--color-text-50);
    line-height: 20px;
    font-weight: 400;
    /* font-family: "Chivo Mono", monospace !important; */
    text-transform: uppercase;

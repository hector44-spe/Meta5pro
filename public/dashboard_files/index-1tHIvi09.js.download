  margin-top: 14px;

  & .title {
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text);
  }

  .settings_option_item {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 50px;
    padding: 7px 10px 7px 0;
    background: var(--color-control);
    border: 1px solid var(--color-card-background-3);
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
    margin-bottom: 6px;
  }

  .settings_option_item_icon {
    position: absolute;
    top: 1.0625rem;
    left: 0.625rem;
    font-size: 1rem;
  }

  .settings_option_item:hover {
    background: var(--color-control-hover);
  }

  .settings_option_item_content {
    padding-left: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .settings_option_item_content .title {
    font-size: 0.875rem;
    line-height: 1.125rem;
    font-weight: 500;
  }

  .option_title {
    margin-top: 18px;
    margin-bottom: 10px;
  }

  .settings_option_item_content .description {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-text-secondary);
  }

  .logout {
    margin-top: auto;
    width: 100%;
    height: 3.125rem;
    padding: 0.75rem 0.625rem !important;
    background: var(--color-control-hover);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.625rem;
    border-radius: 0.3125rem;
    cursor: pointer;
  }

  .logout .settings_option_item_content {
    padding: 0px !important;
    margin: 0px !important;
  }

  .logout .settings_option_item_icon {
    position: unset;
    top: unset;
    left: unset;
  }

  background: var(--color-card-background) !important;
  padding: 16px;
  box-sizing: border-box !important;
  overflow: scroll;
  border-radius: 12px;
  height: calc(100vh - 104px);

  @media screen and (max-width: 768px) {
    & {
      padding-bottom: 200px;
    }
  }

  .signal_top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 8px;
  }

  .signal_bottom {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (max-width: 1050px) {
    .signal_top {
      grid-template-columns: auto;
    }
  }
`,SignalBalanceCard=styled$2.div`
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
  padding: 24px;
  padding-bottom: 40px;
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  border-radius: 12px;
  min-height: 154px;

  p {
    font-size: 14px;
    color: var(--color-text-50);
    line-height: 18px;
    font-weight: 600;
  }

  h3 {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-primary-text);
    line-height: 32px;
    font-feature-settings: "tnum";
  }
`,SignalInfoCard=styled$2.div`
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  padding: 24px;
  gap: 40px;
  /* padding-bottom: 40px; */
  background: var(--color-card-background-2) !important;
  border: 1px solid var(--color-card-background-3);
  border-radius: 12px;
  /* background: blue; */

  .signal_info_card_bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    /* background: red; */
  }

  .signal_info_card_bottom p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .signal_info_card_bottom p:first-of-type strong {
    color: var(--color-primary-text);
  }

  .signal_info_card_bottom p:last-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
    cursor: pointer;
  }

  .signal_info_card_bottom p:last-of-type:hover {
    color: var(--color-text-75);
  }

  /* signal strength */

  .signal_info_card_top {
    /* margin-top: 32px; */
    /* background: green; */
  }

  .signal_strength_wrapper .signal_wrapper {
    display: flex;
    gap: 4px;
    margin-top: 12px;
  }

  .signal_strength_wrapper span {
    display: flex;
    justify-content: space-between;
  }

  .signal_strength_wrapper span p:first-of-type {
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
    color: var(--color-text-50);
  }

  .signal_strength_wrapper span p:last-of-type {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
    color: #4ebe96;
  }

  .signal_strength_wrapper span p:nth-of-type(2).green {
    color: #4ebe96;
  }

  .signal_strength_wrapper span p:nth-of-type(2).yellow {
    color: #f9e26a;
  }

  .signal_strength_wrapper span p:nth-of-type(2).red {
    color: #ff3344;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar {
    height: 12px;
    width: 100%;
    cursor: pointer;
    transition: all 300ms ease-in;
  }

  .signal_strength_wrapper .signal_wrapper:has(> :hover) > *:not(:hover) {
    opacity: 0.5; /* Adjust this value as needed */
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar:first-of-type {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
  }

  .signal_strength_wrapper .signal_wrapper .signal_bar:last-of-type {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

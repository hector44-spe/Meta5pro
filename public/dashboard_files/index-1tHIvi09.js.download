  display: flex;
  justify-content: center;
  /* margin-top: 120px; */
  position: fixed;
  bottom: 120px;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  z-index: 999;

  @media screen and (max-height: 560px) {
    & {
      margin-top: 12px;
      position: unset;
      transform: unset;
      left: unset;
    }
  }
`,Dot=styled$2.div`
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: ${er=>er.active?"var(--color-text)":"var(--color-text-secondary)"};
  margin: 0 5px;
  transition: background-color 0.3s ease;
  cursor: pointer;
`,MobileMenuWrapper=styled$2.div`
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background-color: var(--color-modal-background);
  z-index: 998;
  display: none;
  transition: all 300ms ease-in-out;
  transform: translateX(-100%);
  padding: 16px;
  padding-top: 24px;
  opacity: 0.75;

  .user_avatar {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    object-fit: cover;
    background: var(--color-control);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
  }

  &.open {
    transform: translateX(0);
    opacity: 1;
  }

  .mobile_menu_top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile_menu_top .mobile_menu_buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mobile_menu_top .mobile_menu_buttons button {
    outline: none;
    background: none;
    border: none;
    display: grid;
    place-content: center;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all 150ms ease-out;
  }

  .mobile_menu_top .mobile_menu_buttons button:hover {
    color: var(--color-text);
  }

  .mobile_menu_navigation {
    margin-top: 44px;
    overflow: hidden;
  }

  .swipeable-content {
    display: flex;
    transition: transform 0.3s ease;
  }

  .page {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    height: 100%;
  }

  .mobile_menu_navigation button {
    outline: none;
    border: none;
    cursor: pointer;
    /* background-color: var(--color-card-background); */
    border-radius: 5px;
    display: flex;
    gap: 6px;
    align-items: center;
    flex-flow: column;
    justify-content: center;
    font-size: 12px;
    padding: 25px 0;
    max-height: 100px;
    transition: all 150ms ease-out;

    &:nth-of-type(-n + 9) {
      background-color: var(--color-control);
    }

    &:nth-of-type(n + 10) {
      background: var(--color-control);
      /* background: red; */
    }

    &:hover {
      background: var(--color-control-hover);
    }

    /* &:hover img {
      filter: invert(0%) sepia(0%) saturate(0%) hue-rotate(334deg)
        brightness(200%) contrast(100%);
    } */

    &:hover {
      color: var(--color-text);
    }
  }

  .mobile_menu_navigation button img {
    width: 24px;
    height: 24px;
  }

  .mobile_menu_navigation button {
    color: var(--color-text-secondary);
    font-size: 12px;
    line-height: 16px;
    text-transform: capitalize;
  }

  @media screen and (max-width: 768px) {
    & {
      display: block;
    }
  }

  @media screen and (max-height: 560px) {
    .mobile_menu_navigation {
      margin-top: 24px;
    }
  }
`,AccountCard=styled$2.div`
  /* width: 100%; */
  /* background-color: hsla(0, 0%, 100%, 0.024); */
  /* padding: 12px; */
  border: 1px solid transparent;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease-in-out;

  /* &:hover {
    border: 1px solid hsla(0, 0%, 100%, 0.075);
  } */

  .left {
    display: flex;
    gap: 8px;
  }

  .left .image {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  .user p:nth-of-type(1) {
    color: var(--color-text);
    font-size: 14px;
    line-height: 18px;
    font-weight: 600;
  }

  .user p:nth-of-type(2) {
    color: var(--color-text-50);
    font-size: 12px;
    line-height: 14px;
    font-weight: 600;
  }

  .right {
    margin-left: auto;
  }

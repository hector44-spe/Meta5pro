    align-items: center;
    gap: 16px;
    width: 100%;
    padding-bottom: 24px;
    justify-content: space-between;
  }

  .top_title {
    font-size: 16px;
    font-family: 24px;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .page_section_utils {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .copy_trading_bottom {

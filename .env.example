# ==============================================================================
# BROKER PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.local and update with your local/production values.
# ==============================================================================

# Application Environment & URLs
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Meta Gold 5"

# Database: Neon Postgres (https://console.neon.tech > your project > Connect)
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same, without "-pooler"): used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
# Generate a secure 32-byte secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: the app refuses to sign or accept tokens without it.
JWT_SECRET=
COOKIE_NAME=mg5_token
JWT_EXPIRES_IN=7d

# Master Custodial Cryptocurrency Deposit Addresses
NEXT_PUBLIC_USDT_TRC20_ADDRESS=TJY6ZpB8E7WcEKnLq3h74V75tKjM9zD5eR
NEXT_PUBLIC_USDT_BEP20_ADDRESS=0x71C6944e5B889498b31B5c26b65389Da205f14E7
NEXT_PUBLIC_BTC_ADDRESS=bc1q9p8e7wc4knlq3h74v75tkjm9zd5er06xyz888

# Communication & Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@metagold5.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@metagold5.com

# Seed accounts (npm run seed). Leave blank to have random passwords generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_INVESTOR_PASSWORD=

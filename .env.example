# ==============================================================================
# BROKER PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.local and update with your local/production values.
# ==============================================================================

# Application Environment & URLs
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Meta5VIP"

# Database: Neon Postgres (https://console.neon.tech > your project > Connect)
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same, without "-pooler"): used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Cloudflare R2 object storage (required for all newly uploaded media)
# Create an R2 bucket and an API token with Object Read & Write access to it.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=broker-media

# Authentication & Security
# Generate a secure 32-byte secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: the app refuses to sign or accept tokens without it.
JWT_SECRET=
# Separate 32-byte key for TOTP secrets and card security data.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
COOKIE_NAME=mg5_token
JWT_EXPIRES_IN=7d
# Separate bearer secret for the scheduled investment-accrual job. Do not reuse JWT_SECRET.
CRON_SECRET=
# Number of trusted reverse-proxy hops appended to X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Master Custodial Cryptocurrency Deposit Addresses
NEXT_PUBLIC_USDT_TRC20_ADDRESS=TJY6ZpB8E7WcEKnLq3h74V75tKjM9zD5eR
NEXT_PUBLIC_USDT_BEP20_ADDRESS=0x71C6944e5B889498b31B5c26b65389Da205f14E7
NEXT_PUBLIC_BTC_ADDRESS=bc1q9p8e7wc4knlq3h74v75tkjm9zd5er06xyz888

# Communication & Support
NEXT_PUBLIC_SUPPORT_EMAIL=support@meta5vip.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@metagold5.com
# Zoho SalesIQ live support widget code (from salesiq.zoho.com > Settings > Brands > Websites)
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=siq513c6505d2533af9b126785c07077fdf654c1f0926580539f03271bc7d08c35f

# Zoho Mail SMTP (required for investor and administrator email notifications)
# Use a Zoho app-specific password, not the mailbox login password.
ZOHO_SMTP_USER=support@meta5vip.com
ZOHO_SMTP_PASS=
# Match the mailbox data centre: smtp.zoho.com, smtp.zoho.eu, smtp.zoho.in, etc.
ZOHO_SMTP_HOST=smtp.zoho.com
MAIL_FROM="Meta5VIP <support@meta5vip.com>"
# Optional comma-separated recipients. Active ADMIN users are included automatically.
ADMIN_NOTIFY_EMAIL=admin@example.com

# Seed accounts (npm run seed). Leave blank to have random passwords generated and printed once.
SEED_ADMIN_PASSWORD=
SEED_INVESTOR_PASSWORD=
